from: Pod::To::Markdown 0.2.2 lib/Pod/To/Markdown.rakumod:188
license: Artistic-2.0
feature: infix x
--- code
for 1, 2 -> $level {
    my $head = 'Title';
    say do given $level {
        when 1  { $head ~ "\n" ~ ('=' x $head.chars) }
