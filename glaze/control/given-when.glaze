list
none
other

=== ctl-when-whatever-hash-key
from: Template::Mustache 1.2.7 lib/Template/Mustache.rakumod:496
license: Artistic-2.0
feature: node When
--- code
my %overrides;
for { override => True, val => 'a', contents => 'A' },
    { type => 'comment' },
    { inherits => 'base' },
    { type => 'text' } {
    when *.<override> { %overrides{.<val>} = .<contents>; say 'override' }
    when { .<type> eq 'comment' } { say 'comment' }
    when *.<inherits> { say "inherits {.<inherits>}" }
    default { say 'other' }
}
say %overrides<a>;
--- expect
override
comment
inherits base
other
A

=== ctl-when-block-placeholder
from: Web::App 0.9.2 lib/Web/Request.rakumod:217
license: Artistic-2.0
feature: node When
--- code
sub width($byte) {
    my $bytes = 1;
    my $mask = 0xFF;
    given $byte {
      when { $^c +& 0xF0 == 0xF0 } { $bytes = 4; $mask = 0x07; }
      when { $^c +& 0xE0 == 0xE0 } { $bytes = 3; $mask = 0x0F; }
      when { $^c +& 0xC0 == 0xC0 } { $bytes = 2; $mask = 0x1F; }
    }
    "$bytes {$mask.base(16)}"
}
say width(0x41);
say width(0xC3);
say width(0xE2);
say width(0xF0);
--- expect
1 FF
2 1F
3 F
4 7

=== ctl-when-whatever-count
from: Air 0.1.32 lib/Air/Functional.rakumod:225
license: Artistic-2.0
feature: node When
--- code
sub render-tag($x) { "<$x>" }
sub inner(@inners --> Str()) {
    given @inners {
        when * == 0 {   ''   }
        when * == 1 { .first.&render-tag }
        when * >= 2 { .map(*.&render-tag).join }
    }
}
say inner([]).raku;
say inner(['p']);
say inner(<a b c>);
--- expect
""
<p>
<a><b><c>

=== ctl-when-type-junction-default
from: BDD::Behave 0.9.5 lib/BDD/Behave/Diff.rakumod:15
license: Artistic-2.0
feature: node When
--- code
sub diff-shape($value) {
  return 'Undef' unless $value.defined;
  given $value {
    when Str                { 'Str' }
    when Mix | MixHash      { 'Mix' }
    when Bag | BagHash      { 'Bag' }
    when Set | SetHash      { 'Set' }
    when Associative        { 'Hash' }
    when Positional         { 'Array' }
    default                 { 'Scalar' }
  }
}
say diff-shape($_) for Any, 'x', <a b>.Bag, <a>.SetHash, %(a => 1), [1], 3.5, (a => 1).Mix;
--- expect
Undef
Str
Bag
Set
Hash
Array
Scalar
Mix

=== ctl-when-definite-types
from: Data::TypeSystem 0.1.8 lib/Data/TypeSystem.rakumod:74
license: Artistic-2.0
feature: node When
--- code
sub depth-ok($depth, $arr-depth = 2) {
    do given $depth {
        when Whatever { True }
        when Int:D { $arr-depth == $_ }
        when Range:D { $arr-depth ∈ $_.List }
        when $_ ~~ (Array:D | List:D | Seq:D) { $arr-depth ∈ $_ }
        default { die 'bad depth' }
    }
}
say depth-ok(*);
say depth-ok(3);
say depth-ok(1..4);
say depth-ok((5, 2));
say depth-ok('x');
--- expect
True
False
True
True
!! X::AdHoc

=== ctl-when-in-for-regex
from: App::RaCoCo 2.0.1 lib/App/Racoco/Cli.rakumod:76
license: Artistic-2.0
feature: node When
--- code
my @args = <-l --exec=prove --reporter=html foo --html bar>;
my (@new-args, @execs, @reporters);
for @args -> $_ {
    when '-l' { push @execs, $_ }
    when /^'--exec'/ { push @execs, $_ }
    when /^'--reporter='/ { push @reporters, $_ }
    when '--html' { push @reporters, $_ }
    default { push @new-args, $_ }
}
say @execs;
say @reporters;
say @new-args;
--- expect
[-l --exec=prove]
[--reporter=html --html]
[foo bar]

