my class Stream {
    method set-channel-mask(*@channels where { @channels.elems <= 16 && all(@channels) ~~ ( 0 ..15 ) }) {
        my int $mask = @channels.map(1 +< *).reduce(&[+|]);
        $mask.base(2)
    }
}
