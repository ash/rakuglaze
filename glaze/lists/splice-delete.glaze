=== list-delete-element-hole
from: Prettier::Table 1.1.3 lib/Prettier/Table.rakumod:860
license: MIT
feature: adverb :delete
--- code
my @rows = <r0 r1 r2>;
my $row-index = 1;
@rows[$row-index]:delete;
say @rows.elems;
say @rows[1].defined;
@rows[2]:delete;
say @rows.elems;
--- expect
3
False
1

=== list-delete-singleton-values
from: List::MoreUtils 0.0.10 lib/List/MoreUtils.rakumod:181
license: Artistic-2.0
feature: adverb :delete
--- code
sub singleton(@values is copy) {
    my %once; my %duplicates;
    for @values.kv -> $index, $_ {
        my $key = .defined ?? .Str !! .^name;
        if %duplicates{$key} { @values[$index]:delete }
        elsif %once{$key}:exists {
            @values[%once{$key}:delete]:delete;
            @values[$index]:delete;
            %duplicates{$key} = 1;
        }
        else { %once{$key} = $index }
    }
    @values[]:v
}
say singleton(<a b a c b a d>);
--- expect
(c d)

=== list-delete-returns-value
from: DOM::Tiny 0.5.2 lib/DOM/Tiny.pm6:837
license: Artistic-2.0
feature: adverb :delete
--- code
my @children = 'root', 'other';
my $tree = @children[0]:delete;
say $tree;
say @children[0]:exists;
say @children[1]:exists;
--- expect
root
False
True

=== list-exists-index
from: JSONL 0.1.6 lib/JSONL/Line.rakumod:29
license: Artistic-2.0
feature: adverb :exists
--- code
my $value = [10, Any, 30];
for 0..3 -> $index {
    say $index, ': ', $value[$index]:exists;
}
--- expect
0: True
1: True
2: True
3: False

=== list-slice-v-adverb
from: Text::CSV 0.022 lib/Text/CSV.rakumod:887
license: Artistic-2.0
feature: adverb :v
--- code
my @fields = <a b c>;
my @crange = 0, 2, 7;
say @crange ?? (@fields[@crange]:v) !! @fields;
say @fields[@crange];
--- expect
(a c)
(a c (Any))
