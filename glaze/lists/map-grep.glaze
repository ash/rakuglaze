# map and grep as modules write them: blocks, WhateverCode, sub forms, smartmatch arguments, :k.

=== list-map-colon-block
from: Bailador 0.0.19 lib/Bailador/Request.pm:145
license: MIT
feature: method map
--- code
my $value = 'a%20b&c;d%21';
my @values = $value.split(/<[&;]>/).map: { .subst(/'%' (<xdigit>**2)/, { chr :16(~$0) }, :g) };
say @values.elems;
say @values.join('|');
--- expect
3
a b|c|d!

=== list-map-sub-form
from: Bailador 0.0.19 lib/Bailador/Command/routes.pm:13
license: MIT
feature: call map
--- code
my @path = <api users list>;
my @indent = map {' ' x $_.chars - 1}, @path;
say @indent.map({ "[$_]" }).join;
say @indent».chars;
--- expect
[  ][    ][   ]
[2 4 3]

=== list-map-ampersand-sub
from: Docker::File 1.1 lib/Docker/File.rakumod:198
license: Artistic-2.0
feature: method map
--- code
sub json-string(Str $s) { '"' ~ $s.subst('"', '\"', :g) ~ '"' }
my @arr = 'echo', 'say "hi"';
say '[' ~ @arr.map(&json-string).join(", ") ~ "]";
--- expect
["echo", "say \"hi\""]

=== list-map-two-params
from: PDF::Class 0.5.30 lib/PDF/Function/Exponential.rakumod:46
license: Artistic-2.0
feature: method map
--- code
my @Domain = 0, 1, -5, 5;
my Range @domain = @Domain.map: -> $a, $b { Range.new($a, $b) };
say @domain.elems;
say @domain.map(*.raku).join(' ');
say 3 ~~ @domain[1];
--- expect
2
0..1 -5..5
True

=== list-map-default-second-param
from: PDF 0.6.15 lib/PDF/IO/Filter/ASCIIHex.rakumod:52
license: Artistic-2.0
feature: method map
--- code
my $str = '4A6';
