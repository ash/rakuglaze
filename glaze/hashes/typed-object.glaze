=== hash-typed-value-class-attr
from: Cache::Async 0.3.4 lib/Cache/Async.rakumod:152
license: Artistic-2.0
feature: typed hash
--- code
my class Entry { has $.value }
my class C {
    has Entry %!entries;
    method put($k, $v) { %!entries{$k} = Entry.new(value => $v) }
    method raw($k, $v) { %!entries{$k} = $v }
    method get($k) { %!entries{$k} andthen .value }
}
my $c = C.new;
$c.put('a', 1);
say $c.get('a');
say $c.get('b').raku;
$c.raw('x', 5);
--- expect
1
Empty
!! X::TypeCheck::Assignment

