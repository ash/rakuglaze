=== ctl-try-block-or-die
from: Backtrace::AsHTML 0.0.1 lib/Backtrace/AsHTML.pm6:107
license: Artistic-2.0
feature: prefix try
--- code
sub opener($file) { $file.ends-with('.txt') ?? "handle:$file" !! die "no such file" }
sub load($file) {
    my $fh = try { opener($file) } or die "cannot open $file: $!";
