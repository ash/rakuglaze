license: Artistic-2.0
feature: quote heredoc
--- code
my @attrs = 'width="10"', 'height="20"';
my $id = 'g1';
my $values = (1..3).map({ "#g{$_}" }).join(';');
print Q:c:s:to/END/;
<svg {@attrs.join(' ')}>
  <use id="$id" values="$values"/>
</svg>
END
--- expect
<svg width="10" height="20">
  <use id="g1" values="#g1;#g2;#g3"/>
</svg>

