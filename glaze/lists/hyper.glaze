=== list-hyper-mean-diff-zip
from: Stats 0.0.6 lib/Stats.pm6:97
license: Artistic-2.0
feature: infix »-»
--- code
sub mean(@x) { @x.sum / @x.elems }
my @x = 1, 2, 3;
my @y = 2, 4, 6;
say 1 / @x.elems * [+]((@x »-» mean(@x)) Z* (@y »-» mean(@y)));
--- expect
1.333333

=== list-hyper-assign-op
from: Math::Matrix 0.4.2 lib/Math/Matrix.rakumod:577
license: Artistic-2.0
feature: infix »-=»
--- code
my @ref = [2, 4, 6], [1, 1, 1];
my ($n, $r, $lead) = 0, 1, 0;
@ref[$n] »-=» @ref[$r] »*» @ref[$n][$lead];
say @ref[$n];
--- expect
[0 2 4]

=== list-hyper-fatarrow
from: RakudoPrereq 1.1 lib/RakudoPrereq.rakumod:6
license: Artistic-2.0
feature: infix »=>»
--- code
my @valid-opts = <no-where no-message>;
my $opts = 'NO-WHERE bogus';
(my %opts = $opts.lc.words »=>» 1).keys.grep(none @valid-opts) and say 'bad option';
say %opts.keys.sort;
--- expect
bad option
(bogus no-where)

=== list-hyper-xx-flat
from: Digest 1.1.0 lib/Digest/RIPEMD.rakumod:44
license: Artistic-2.0
feature: infix »xx»
--- code
my @c = 1, 2;
my @flat = flat @c »xx» 3;
say @flat;
--- expect
[(1 1 1) (2 2 2)]
