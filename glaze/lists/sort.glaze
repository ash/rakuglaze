(br gzip identity)

=== list-sort-list-key
from: Cro::HTTP 0.8.13 lib/Cro/HTTP/Client/CookieJar.rakumod:138
license: Artistic-2.0
feature: method sort
--- code
my @cookie-list = { path => '/a/b', t => 2 }, { path => '/', t => 1 }, { path => '/a/b', t => 1 };
say @cookie-list.sort({ .<path>.comb.elems, .<t> }).map({ .<path> ~ q{@} ~ .<t> });
--- expect
(/@1 /a/b@1 /a/b@2)

=== list-sort-tuple-key-then-whatever
from: Rakuast::RakuDoc::Render 1.1.4 lib/RakuDoc/Plugin/HTML/SCSS.rakumod:56
license: Artistic-2.0
feature: method sort
--- code
my @p-tuples = ('b.css', 2), ('a.css', 2), ('z.css', 1);
my @css = @p-tuples.sort({ .[1], .[0] }).map( *.[0] ).list;
say @css;
--- expect
[z.css a.css b.css]

=== list-sort-paren-key-tuple
from: Template::HAML 0.9.6 lib/Template/HAML/Lint.rakumod:169
license: Artistic-2.0
feature: method sort
--- code
my class Diag { has $.line; has $.column }
my @diags = Diag.new(:line(3), :column(1)), Diag.new(:line(1), :column(9)), Diag.new(:line(1), :column(2));
say @diags.sort({ ($_.line, $_.column) }).List.map({ "{.line}:{.column}" });
--- expect
(1:2 1:9 3:1)

=== list-sort-key-then-sort-value
from: CSS::Properties 0.10.9 lib/CSS/Properties/Optimizer.rakumod:198
license: Artistic-2.0
feature: method sort
--- code
my %groups = a => 2, b => 3, c => 3;
with %groups.pairs.sort(*.key).sort({+.value}).tail {
    say .key;
}
--- expect
c

=== list-sort-assign-method
from: Abbreviations 2.2.3 lib/Abbreviations.rakumod:221
license: Artistic-2.0
feature: method sort
--- code
my @list = <bb a ccc ab b>;
@list .= sort({.Str, .chars});
say @list;
@list .= sort({.chars, .Str});
say @list;
--- expect
[a ab b bb ccc]
[a b ab bb ccc]

=== list-sort-assign-colon-block
from: PDF 0.6.15 lib/PDF/IO/Writer.rakumod:132
license: Artistic-2.0
feature: method sort
--- code
my @idx = { obj-num => 4 }, { obj-num => 1 }, { obj-num => 3 };
