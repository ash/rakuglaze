license: Artistic-2.0
feature: array slice with :delete from a grep with :k
--- code
my @all-pairs = a => 1, b => 2, a => 3;
my $key = 'a';
my @removed = @all-pairs[ @all-pairs.grep({ .defined && .key eqv $key }, :k) ]:delete;
say @removed;
say @all-pairs.grep(*.defined);
--- expect
[a => 1 a => 3]
(b => 2)

