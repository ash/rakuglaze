# Pair objects as modules use them: Pair.new, colonpair forms, Pair in a
# signature and in multi dispatch, `~~ Pair`, `.pairs[0]`, a rw value.

=== hash-pair-new-paren
from: Cro::HTTP 0.8.13 lib/Cro/HTTP/Message.rakumod:106
license: Artistic-2.0
feature: method new
--- code
my @values = 'text/html;q=0.8', 'application/json', 'text/plain;q=0.5';
my @p = @values.map: -> $v {
    my ($value, $q) = $v.split(';q=');
    Pair.new($value, +($q // 1));
}
say @p.sort(-*.value).map(*.key).join(' ');
say @p[0].^name;
--- expect
application/json text/html text/plain
Pair

=== hash-pair-new-colon-array-value
from: Backtrace::Files 0.0.4 lib/Backtrace/Files.rakumod:21
license: Artistic-2.0
feature: method new
--- code
multi sub add-source-lines(@pairs, *%_) { @pairs.map({ "{.key}:{.value.join(',')}" }).join(' ') }
multi sub add-source-lines($file, @lines, *%_) {
    add-source-lines [Pair.new: $file, @lines], |%_
}
say add-source-lines('a.raku', [3, 5]);
--- expect
a.raku:3,5

=== hash-pair-new-colon-closure
from: Lines::Containing 0.0.11 lib/Lines/Containing.rakumod:144
license: Artistic-2.0
feature: method new
--- code
my $with-nr = True;
my &mapper = $with-nr
    ?? -> $linenr, $line { Pair.new: $linenr, $line }
    !! -> $linenr, $line { $line };
say <alpha beta gamma>.kv.map(&mapper).grep(*.value.contains('a')).map(*.gist).join(' | ');
--- expect
0 => alpha | 1 => beta | 2 => gamma

=== hash-pair-new-sub-callable-value
from: String::Utils 0.0.41 lib/String/Utils.rakumod:821
license: Artistic-2.0
feature: method new
--- code
sub make-export($out, &code) {
    Pair.new: "&$out", &code
}
my $p = make-export('shout', *.uc);
say $p.key;
say $p.value()('hi');
--- expect
&shout
HI

=== hash-pair-new-in-map-key
from: Map::Match 0.0.10 lib/Map/Match.rakumod:15
license: Artistic-2.0
feature: method new
--- code
my sub pair(       %map, str $key) { Pair.new: $key, %map.AT-KEY($key) }
my %m = a => 1, b => 2;
say pair(%m, 'b');
say pair(%m, 'z').raku;
--- expect
b => 2
:z(Any)

=== hash-pair-param-sub
from: Cro::Core 0.8.10 lib/Cro/MediaType.rakumod:122
license: Artistic-2.0
feature: type Pair
--- code
sub param-str(Pair $p) {
    $p.value ~~ /^ <[\w-]>+ $/ ?? "{$p.key}={$p.value}" !! "{$p.key}=\"{$p.value}\""
}
say param-str((charset => 'utf-8'));
say param-str((boundary => 'a b'));
--- expect
charset=utf-8
boundary="a b"

=== hash-pair-multi-topic-param
from: CSS::Writer 0.3.3 lib/CSS/Writer.rakumod:412
license: Artistic-2.0
feature: type Pair
--- code
my class Writer {
    multi method write(Pair $_) { "{.key}<{self.write(.value)}>" }
    multi method write(Str $_) { $_ }
    multi method write(Int $_) { "#$_" }
}
say Writer.new.write((ident => 'red'));
say Writer.new.write((num => 3));
say Writer.new.write((outer => (inner => 'x')));
--- expect
ident<red>
num<#3>
outer<inner<x>>

=== hash-pair-multi-defined-sub
from: AttrX::Mooish 1.0.10 lib/AttrX/Mooish/Attribute.rakumod:144
license: Artistic-2.0
feature: type Pair
--- code
my %opts;
multi sub set-option(Pair:D $opt) { %opts{$opt.key} = $opt.value }
multi sub set-option(Str:D $opt) { %opts{$opt} = True }
set-option($_) for (:lazy), 'clearer', (builder => 'mk');
say %opts.sort.map(*.gist).join(' ');
--- expect
builder => mk clearer => True lazy => True

=== hash-pair-multi-method-set
from: Bailador 0.0.19 lib/Bailador/Configuration.pm:156
license: MIT
feature: type Pair
--- code
my class Config {
    has %.values;
    multi method set(Pair $x) { %!values{$x.key} = $x.value }
    multi method set(Str $k, $v) { %!values{$k} = $v }
}
my $c = Config.new;
$c.set((port => 8080));
$c.set('host', 'localhost');
say $c.values.sort.map(*.gist).join(' ');
--- expect
host => localhost port => 8080

