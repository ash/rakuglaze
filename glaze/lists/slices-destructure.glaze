# Subscripts (*-1, 1..*, 0..^*-1, ^n, .end) and list assignment / destructuring.

=== list-index-whatever-minus-one
from: BDD::Behave 0.9.5 lib/BDD/Behave/Benchmark.rakumod:18
license: Artistic-2.0
feature: index *-1
--- code
my @sorted = (5, 1, 9).sort;
my $max = @sorted[*-1];
my $min = @sorted[0];
say "$min..$max";
--- expect
1..9

=== list-assign-whatever-minus-two
from: Bailador 0.0.19 lib/Bailador/Configuration.pm:77
license: MIT
feature: index *-1
--- code
my @pieces = <settings yaml>;
my $extend-me = @pieces[*-2];
@pieces[*-2] = $extend-me ~ '-local';
say @pieces.join('.');
--- expect
settings-local.yaml

=== list-modify-last-part
from: MVC::Keayl 0.9.2 lib/MVC/Keayl/View.rakumod:42
license: Artistic-2.0
feature: index *-1
--- code
my @parts = 'users/form'.split('/');
@parts[*-1] = '_' ~ @parts[*-1];
say @parts.join('/');
--- expect
users/_form

=== list-index-end-method
from: Bailador 0.0.19 lib/Bailador/Command/routes.pm:15
license: MIT
feature: method end
--- code
my @chars = '  ', '  ', '  ';
my @is-last = False, True;
@chars[@chars.end] = @is-last[@is-last.end] ?? "L" !! "T" if +@is-last;
say @chars.join('|');
say [].end;
--- expect
  |  |L
-1

=== list-range-to-end-method
from: Selkie 0.16.0 lib/Selkie/Store.rakumod:850
license: Artistic-2.0
feature: method end
--- code
my @path = <app settings theme>;
my @walked;
for @path[0 ..^ @path.end] -> $key {
    @walked.push: $key;
}
say @walked;
--- expect
[app settings]

=== list-slice-one-to-whatever
from: BDD::Behave 0.9.5 lib/BDD/Behave/Benchmark/Baseline.rakumod:63
license: Artistic-2.0
feature: index 1..*
--- code
my @lines = 'name,time', 'a,1', 'b,2';
for @lines[1..*] -> $raw {
    say $raw.split(',')[1];
}
--- expect
1
2

=== list-slice-to-whatever-minus
from: AlgorithmsIT 0.0.4 lib/AlgorithmsIT/Classes.rakumod:76
license: Artistic-2.0
feature: index 1..*
--- code
my @arr = 9, 4, 5, 6, 0;
my $s = @arr[1..*-1].join(', ');
say $s;
say @arr[1..*-2];
--- expect
4, 5, 6, 0
(4 5 6)

=== list-slice-upto-whatever-minus
from: Config::TOML 0.1.3 lib/Config/TOML/Parser/Actions.rakumod:946
license: Unlicense
feature: index 0..^*-1
--- code
my @path = <a b c>;
say @path[0..^*-1];
my @one = 'x',;
say @one[0..^*-1].elems;
--- expect
(a b)
0

=== list-slice-caret-n
from: Algorithm::KDimensionalTree 0.1.2 lib/Algorithm/KDimensionalTree.rakumod:128
license: Artistic-2.0
feature: prefix ^
--- code
my @points = (1..7).map(* * 10);
my $median = @points.elems div 2;
say @points[^$median];
say @points[$median];
say @points[$median ^.. *];
--- expect
(10 20 30)
40
(50 60 70)

=== list-slice-two-indices
from: Collection 0.18.0 lib/Collection/Progress.rakumod:69
license: Artistic-2.0
feature: index list
--- code
my @t = 0, 5, 7;
my $ts = @t[0] > 0 ?? sprintf("%dh:%dm:%ds", @t) !! sprintf("%dm:%ds",@t[1,2]);
say $ts;
--- expect
5m:7s

=== list-slice-in-call-slip
from: DBIish 0.6.9 lib/DBDish/Oracle/StatementHandle.rakumod:166
license: BSD-2-Clause
feature: prefix |
--- code
my $res = [0, 0, 7, 4];
my $year = 2024;
say sprintf '%04d-%02d-%02d', $year, |$res[2,3];
--- expect
2024-07-04

=== list-destructure-first-rest
from: Cro::Core 0.8.10 lib/Cro.rakumod:142
license: Artistic-2.0
feature: decl my (list)
--- code
my @components = <source xform1 xform2 sink>;
my ($source, @rest) = @components;
say $source;
say @rest;
say @rest.^name;
--- expect
source
[xform1 xform2 sink]
Array

=== list-destructure-split-two
from: Backtrace::Files 0.0.4 lib/Backtrace/Files.rakumod:168
license: Artistic-2.0
feature: decl my (list)
--- code
$_ = 'lib/A.rakumod:lib/B.rakumod:extra';
my ($in,$out) = .split(':', 2);
say $in;
say $out;
