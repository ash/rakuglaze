=== hash-set-sethash-visited
from: Graph 0.1.3 lib/Graph.rakumod:658
license: Artistic-2.0
feature: type SetHash
--- code
my %adjacency-map = a => { b => 1, c => 1 }, b => { c => 1 }, c => { a => 1 };
my $visited = SetHash.new;
my @queue = 'a';
while @queue {
    my $v = @queue.shift;
    next if $visited{$v};
    $visited.set($v);
    @queue.append: %adjacency-map{$v}.keys.sort;
}
say $visited.keys.sort;
--- expect
(a b c)

