license: Artistic-2.0
feature: method message
--- code
my class WrongPath is Exception {
  has $.path;
  method message() { "$.path-name path ｢$!path｣ does not exists." }
  method path-name() { ... }
}
my class WrongLibPath is WrongPath {
  method path-name() { 'lib' }
}
say WrongLibPath.new(path => 'src').message;
--- expect
lib path ｢src｣ does not exists.

=== obj-exception-also-is
from: Crane 0.1.2 lib/X/Crane.rakumod:5
license: Unlicense
feature: node Class
--- code
my class X::Crane::Op {
    also is Exception;
    has Str:D $.operation is required;
    method message() { "Crane op $!operation failed" }
}
{
    X::Crane::Op.new(operation => 'move').throw;
    CATCH { default { say .^name, ': ', .message } }
}
say X::Crane::Op.^parents.map(*.^name);
--- expect
X::Crane::Op: Crane op move failed
(Exception)

=== obj-gist-defined-only
from: Algorithm::KDimensionalTree 0.1.2 lib/Algorithm/KDimensionalTree.rakumod:85
license: Artistic-2.0
feature: method gist
--- code
my class Tree {
    has @.points;
    has @.labels;
    multi method gist(::?CLASS:D:-->Str) {
        my $lblPart = @!labels.elems > 0 ?? ", labels => {@!labels.elems}" !! '';
        return "Tree(points => {@!points.elems}" ~ $lblPart ~ ')';
    }
}
say Tree.new(points => [1, 2, 3]);
say Tree.new(points => [1], labels => <a>);
say Tree;
--- expect
Tree(points => 3)
Tree(points => 1, labels => 1)
(Tree)

=== obj-gist-uses-str
from: Bailador 0.0.19 lib/Bailador/Test.pm:15
license: MIT
feature: method gist
--- code
my class Response {
    has $.status = 200;
    method Str() { "HTTP $!status" }
    method gist() { self.Str }
}
my $r = Response.new(status => 404);
say $r;
put $r;
say "got: $r";
say [$r, Response.new];
--- expect
HTTP 404
HTTP 404
got: HTTP 404
[HTTP 404 HTTP 200]

=== obj-gist-interpolates-str-method
from: BitEnum 0.5 lib/BitEnum.rakumod:75
license: Artistic-2.0
feature: method gist
--- code
my class Flags {
    has Int $.value = 0;
    method Str() { (^4).grep({ $!value +& (1 +< $_) }).map({ "bit$_" }).join('|') }
    method gist()         { "$!value = $.Str()" }
}
say Flags.new(value => 5);
say Flags.new(value => 5).Str;
--- expect
5 = bit0|bit2
bit0|bit2
