# Integer arithmetic as modules write it: div, mod, %%, **, .polymod,
# .is-prime — medians, byte splitting, base conversion, hashing.

=== num-div-median-index
from: Algorithm::KDimensionalTree 0.1.2 lib/Algorithm/KDimensionalTree.rakumod:125
license: Artistic-2.0
feature: infix div
--- code
my @points = (3, 1), (5, 2), (9, 4), (2, 8), (7, 7);
my $median = @points.elems div 2;
say $median;
say @points.sort(*[0])[$median];
say 7 div 2, ' ', -7 div 2;
--- expect
2
(5 2)
3 -4

=== num-div-median-even-odd
from: BDD::Behave 0.9.5 lib/BDD/Behave/Benchmark.rakumod:22
license: Artistic-2.0
feature: infix %%
--- code
sub median(@timings) {
    my @sorted = @timings.sort;
    my $n = @sorted.elems;
    $n %% 2
      ?? (@sorted[$n div 2 - 1] + @sorted[$n div 2]) / 2
      !! @sorted[$n div 2];
}
say median([5, 1, 4, 2]);
say median([5, 1, 4]);
say median([0.5, 0.25]).^name;
--- expect
3
4
Rat

=== num-div-round-up-blocks
from: Base64::Native 0.0.10 lib/Base64/Native.rakumod:14
license: Artistic-2.0
feature: infix div
--- code
for 0, 1, 3, 4, 10 -> $bytes {
    my \out-blocks = ($bytes + 2) div 3;
    say "$bytes -> {out-blocks} blocks, {out-blocks * 4} chars";
}
