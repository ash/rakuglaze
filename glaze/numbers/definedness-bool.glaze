=== num-so-set-membership
from: BDD::Behave 0.9.5 lib/BDD/Behave/Configuration.rakumod:16
license: Artistic-2.0
feature: prefix so
--- code
my constant PARALLEL-MODES = set <thread process off>;
my constant DEFAULT-PARALLEL-MODE = 'off';
sub resolve-parallel-mode($requested --> Str) {
    ($requested // DEFAULT-PARALLEL-MODE).lc;
}
sub is-parallel-mode(Str $mode --> Bool) {
    so $mode ∈ PARALLEL-MODES;
}
say resolve-parallel-mode(Str);
say is-parallel-mode(resolve-parallel-mode('THREAD'));
say is-parallel-mode('fork');
--- expect
off
True
False

=== num-so-first-found
from: Cro::HTTP 0.8.13 lib/Cro/HTTP/Message.rakumod:80
license: Artistic-2.0
feature: prefix so
--- code
my class H { has $.name }
my @headers = H.new(name => 'Content-Type'), H.new(name => 'Host');
sub has-header($name) {
    my $folded = $name.fc;
    so @headers.first(*.name.fc eq $folded)
}
say has-header('host'), ' ', has-header('Accept');
--- expect
True False

=== num-not-condition
from: Astro::Utils 0.0.3 lib/Astro/Utils.rakumod:28
license: Artistic-2.0
feature: prefix not
--- code
for 0, 0.5, 1, -0.1 -> $hours {
    if not (0 <= $hours < 1) {
        say "$hours out of range";
    }
    else {
        say "$hours ok";
    }
}
say not 0, ' ', (not 1).^name;
--- expect
0 ok
0.5 ok
1 out of range
-0.1 out of range
True Bool

