=== ctl-promise-allof-then
from: BDD::Behave 0.9.5 lib/BDD/Behave/Parallel/Queue.rakumod:168
license: Artistic-2.0
feature: method then
--- code
my $start-promise = Promise.kept(0);
my $stdout-done = start { 'out' };
my $stderr-done = start { 'err' };
my $all = Promise.allof($start-promise, $stdout-done, $stderr-done).then({
    "finished: {$stdout-done.result} {$stderr-done.result}"
});
say await $all;
--- expect
