=== rx-parse-args-dynamic-flag
from: DateTime::Grammar 0.1.3 lib/DateTime/Grammar.rakumod:20
license: MIT
feature: method parse
--- code
my role Grammarish {
    token TOP($*extended) { <datetime-param-spec> }
    token datetime-param-spec { <iso-date> | <day-spec> <?{$*extended}> }
    token iso-date { \d**4 '-' \d**2 '-' \d**2 }
    token day-spec { :i today | tomorrow }
}
my grammar DTG does Grammarish { }
sub datetime-parse(Str:D $spec, Str:D :$rule = 'TOP', Bool :$extended = True) {
    return DTG.parse($spec, :$rule, args => $rule eq 'TOP' ?? ($extended,) !! Empty);
}
say so datetime-parse('2024-01-05');
say so datetime-parse('today');
say so datetime-parse('today', :!extended);
say so datetime-parse('Tomorrow', :rule<day-spec>);
--- expect
True
True
False
True

=== rx-parse-actions-made-loop
from: TAP 0.3.15 lib/TAP.rakumod:346
license: Artistic-2.0
feature: method parse
--- code
my grammar Line {
    token TOP { <test> }
    token test { $<nok>=['not ']? 'ok' [\s+ $<num>=\d+]? [\s+ '-'? \s* $<desc>=\N*]? }
}
my class Actions {
    method TOP($/) { make [ $<test>.made, ] }
    method test($/) { make { :ok(!$<nok>), :num(+($<num> // 0)), :desc(~($<desc> // '')) } }
}
for 'ok 1 - first', 'not ok 2 second', 'ok' -> $line {
    for Line.parse($line, :actions(Actions)).made -> $entry {
        say $entry.keys.sort.map({ "$_=$entry{$_}" }).join(' ');
    }
}
--- expect
desc=first num=1 ok=False
desc=second num=2 ok=False
desc= num=0 ok=False

=== rx-parse-ast-or-fail-elsif
from: zef 1.1.4 lib/Zef/Identity.rakumod:44
license: Artistic-2.0
feature: method parse
--- code
my grammar REQUIRE {
    token TOP { ^ <name> $ }
    token name { [<-[:]>+]+ % '::' }
}
my class REQUIRE-Actions {
    method TOP($/) { make { name => $<name>.Str } }
}
sub identity($id) {
    if $id.starts-with('http') { 'url' }
    elsif REQUIRE.parse($id, :actions(REQUIRE-Actions)).ast -> $ident {
        "module {$ident<name>}"
    }
    else { 'unknown' }
}
say identity('https://x');
say identity('JSON::Fast');
say identity('Bad:Name');
--- expect
url
module JSON::Fast
unknown

