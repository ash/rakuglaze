how are you

=== list-tail-n-assign
from: Intl::Format::Number 0.4.0 lib/Intl/Format/Number/Grammar.rakumod:206
license: Artistic-2.0
feature: method tail
--- code
my @grouping = 4, 3, 2;
my ($secondary, $primary) = @grouping.tail(2);
say "$secondary $primary";
say @grouping.tail;
--- expect
3 2
2

=== list-skip-no-arg
from: Pod::To::Man 1.2.1 lib/Pod/To/Man.rakumod:188
license: Artistic-2.0
feature: method skip
--- code
my class C { method m($x, :$y) {} }
my @params = C.^lookup('m').signature.params.skip;
say @params.elems;
say @params.head.name;
--- expect
3
$x

=== list-skip-then-head
from: Cromponent 0.0.13 lib/Cromponent/MetaCromponentRole.rakumod:28
license: Artistic-2.0
feature: method skip
--- code
sub load($self, Int $id, Str $name, *%rest) {}
my $sig = &load.signature.params.skip.head(*-1)>>.gist.join: ", ";
say $sig;
--- expect
Int $id, Str $name

=== list-skip-n-map
from: BDD::Behave 0.9.5 lib/BDD/Behave/DSL.rakumod:540
license: Artistic-2.0
feature: method skip
--- code
my @lines = 'first line', 'second', 'third';
my @tail  = @lines.skip(1).map({ "      $_" });
say @tail.join("\n");
say @lines.skip(5).elems;
--- expect
      second
      third
0

=== list-polymod-skip-reverse
from: Email::Simple 2.1.4 lib/Email/Simple.rakumod:18
license: CC0-1.0
feature: method skip
--- code
sub percent02i($n) { sprintf '%02i', $n }
my $timezone = -19800;
say $timezone.abs.polymod(60,60).skip.reverse.map(&percent02i).join;
--- expect
0530

=== list-reverse-defined-or
from: zef 1.1.4 lib/Zef/Client.rakumod:608
license: Artistic-2.0
feature: infix R//
--- code
my @files = 'lib/A.rakumod', 'META6.json';
my $meta6-prefix = '' R// @files.sort.first({ .IO.basename eq 'META6.json' });
say $meta6-prefix;
say ('' R// @files.first(* eq 'none')).raku;
--- expect
META6.json
""

=== list-reverse-defined-or-assign
from: LibraryMake 1.0.5 lib/LibraryMake.rakumod:165
license: MIT
feature: infix [R//]=
--- code
my %vars = CC => q{gcc}, LD => q{ld};
my %env = CC => q{clang};
for %vars.keys.sort -> $k {
    %vars{$k} [R//]= %env{$k};
}
say %vars<CC>;
say %vars<LD>;
--- expect
clang
ld
