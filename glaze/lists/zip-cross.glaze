# Zip and cross: Z, Z=>, Z~, Z[op], X~, X=>, X-, X*, and reversed R//.

=== list-zip-fatarrow-hash
from: Color::DirColors 0.0.3 lib/Color/DirColors.rakumod:107
license: Artistic-2.0
feature: infix Z=>
--- code
my @bsd-order = <di ln so>;
my $bsd-rules = 'exfxgx';
my %rules = @bsd-order Z=> $bsd-rules.comb(2).map({ .uc });
say %rules.sort;
--- expect
(di => EX ln => FX so => GX)

=== list-zip-fatarrow-infinite-range
from: DBIish 0.6.9 lib/DBDish/Pg/Connection.rakumod:225
license: BSD-2-Clause
feature: infix Z=>
--- code
my @column-names = <id name email>;
my %col-map := (@column-names Z=> (0..*)).Map;
say %col-map<email>;
say %col-map.^name;
--- expect
2
Map

=== list-zip-fatarrow-caret-elems
from: Lingua::NumericWordForms 0.6.2 lib/Lingua/NumericWordForms/Roles/Koremutake/WordedNumberSpec.rakumod:27
license: Artistic-2.0
feature: infix Z=>
