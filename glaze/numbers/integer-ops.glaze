(23 29 31 37 41 43 47 53)
6A09E667

=== num-pow-negative-exponent
from: CBOR::Simple 0.1.4 lib/CBOR/Simple.rakumod:1139
license: Artistic-2.0
feature: infix **
--- code
for (27315, -2), (5, 3), (1, -20) -> ($man, $exp) {
    my $v = $exp >= 0 ?? $man * 10 ** $exp !! do {
        my $de = 10 ** -$exp;
        $de <= 2**64 - 1 ?? Rat.new(   $man, $de)
                         !! FatRat.new($man, $de)
    }
    say "{$v} {$v.^name}";
}
--- expect
273.15 Rat
5000 Int
0.00000000000000000001 FatRat

=== num-pow-signed-bound
from: Cro::HTTP 0.8.13 lib/Cro/HTTP/Router.rakumod:567
license: Artistic-2.0
feature: infix **
--- code
sub fits(Int $v, Int $bits) {
    my $bound = 2 ** ($bits - 1);
    -$bound <= $v < $bound
}
say fits(127, 8), ' ', fits(128, 8), ' ', fits(-128, 8);
say fits(2**62, 64), ' ', fits(2**63, 64);
--- expect
True False True
True False

=== num-pow-chained-range
