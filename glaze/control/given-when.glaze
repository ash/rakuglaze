=== ctl-proceed-type-normalise
from: HTTP::Headers 0.5.0 lib/HTTP/Headers.pm6:41
license: Artistic-2.0
feature: sub proceed
--- code
my @values = 3, 2.5, 'x';
my @out = @values.map(-> $value is copy {
    given $value {
        when Int {
            $value = $value.Rat;
            proceed;
        }
        when Rat {
            $value = sprintf '%.2f', $value;
        }
    }
    $value
});
say @out;
--- expect
[3.00 2.50 x]

=== ctl-proceed-state-machine
from: Cro::HTTP 0.8.13 lib/Cro/HTTP/ResponseParser.rakumod:77
license: Artistic-2.0
feature: sub proceed
--- code
my enum State <StatusLine Header Body>;
my $expecting = StatusLine;
my @lines = 'HTTP/1.1 200', 'A: 1', 'B: 2', '';
my @log;
while @lines {
    given $expecting {
        when StatusLine {
            @log.push: 'status ' ~ @lines.shift.words[1];
            $expecting = Header;
            proceed;
        }
        when Header {
            my $h = @lines.shift;
            if $h eq '' { $expecting = Body }
            else { @log.push: "header $h" }
        }
    }
}
.say for @log;
say $expecting;
--- expect
status 200
header A: 1
header B: 2
Body

=== ctl-proceed-modifier-and
from: DBIish 0.6.9 lib/DBDish/Oracle/StatementHandle.rakumod:66
license: BSD-2-Clause
feature: sub proceed
--- code
my enum T <NUM INT FLT STR>;
sub buffer($dtype is copy, $prec, $scale) {
    do given $dtype {
        when NUM {
            $_ = INT and proceed if $prec > 0 && $scale == 0;
            $_ = FLT and proceed if $scale == -127;
            'num-buffer';
        }
        when INT { "int-buffer" }
        when FLT { "flt-buffer" }
        default  { 'str-buffer' }
    }
}
say buffer(NUM, 5, 0);
say buffer(NUM, 0, -127);
say buffer(NUM, 5, 2);
say buffer(STR, 0, 0);
--- expect
int-buffer
flt-buffer
num-buffer
str-buffer

=== ctl-proceed-in-catch
from: Red 0.2.5 lib/MetamodelX/Red/Model.rakumod:408
license: Artistic-2.0
feature: sub proceed
--- code
my @events;
sub create($data) {
    die "bad $data" if $data < 0;
    @events.push: "ok $data";
    CATCH {
        default {
            @events.push: "error: {.message}";
            proceed
        }
    }
    True
}
say create(1);
say (try create(-1)) // 'escaped';
say $!.message;
.say for @events;
--- expect
True
escaped
bad -1
ok 1
error: bad -1

=== ctl-succeed-value-if
from: Text::ShellWords 0.1.1 lib/Text/ShellWords.rakumod:147
license: Artistic-2.0
feature: sub succeed
--- code
my $keep = False;
sub chunk($c) {
    given $c.key {
        when '~' {
            succeed $c.value if $keep;
            ''
        }
        default { $c.value }
    }
}
say chunk('~' => 'tilde').raku;
say chunk('x' => 'plain');
$keep = True;
say chunk('~' => 'tilde');
--- expect
""
plain
tilde

