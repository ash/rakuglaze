=== ctl-state-typed-hash-converter
from: Getopt::Long 0.4.2 lib/Getopt/Long.rakumod:119
license: Artistic-2.0
feature: decl state
--- code
sub get-converter(Any:U $type) {
	state %converter-for-type{Any:U} = (
		Pair.new(Int,      *.Int),
		Pair.new(Rat,      *.Rat),
		Pair.new(Num,      *.Num),
	);
	if %converter-for-type{$type} -> &converter {
		return &converter;
	}
	Nil
}
say get-converter(Int)(q[42]).^name;
say get-converter(Rat)(q[1.5]).^name;
say get-converter(Str).raku;
--- expect
Int
Rat
Nil

