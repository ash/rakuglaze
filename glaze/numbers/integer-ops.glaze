1 -> 1 blocks, 4 chars
3 -> 1 blocks, 4 chars
4 -> 2 blocks, 8 chars
10 -> 4 blocks, 16 chars

=== num-div-hours-minutes
from: Collection 0.18.0 lib/Collection/Progress.rakumod:66
license: Artistic-2.0
feature: infix div
--- code
for 59, 754, 7384 -> $d {
    my @t = $d div 3600 , ;
    @t[1] = ($d - @t[0] * 3600) div 60;
    @t[2] = $d - @t[0] * 3600 - @t[1] * 60;
    my $ts = @t[0] > 0 ?? sprintf("%dh:%dm:%ds", @t) !! sprintf("%dm:%ds",@t[1,2]);
    say $ts;
}
--- expect
0m:59s
12m:34s
2h:3m:4s

=== num-mod-string-hash
from: Air 0.1.32 lib/Air/Form.rakumod:291
license: Artistic-2.0
feature: infix mod
--- code
sub hash-msg(Str $msg) {
    my $h = 5381;
    for $msg.encode.list -> $byte { $h = ($h * 33 + $byte) mod (2**31) }
    $h
}
say hash-msg('');
say hash-msg('hello');
say hash-msg('a much longer message that overflows');
--- expect
5381
261238937
1429333463

