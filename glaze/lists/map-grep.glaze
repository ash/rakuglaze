=== list-grep-none-junction
from: DOM::Tiny 0.5.2 lib/DOM/Tiny/CSS.pm6:191
license: Artistic-2.0
feature: call none
--- code
my class Comment {}
my class PI {}
my class Tag {}
my @children = Comment.new, PI.new;
say @children.grep(none(Comment, PI)).elems == 0;
@children.push: Tag.new;
say @children.grep(none(Comment, PI)).elems;
--- expect
True
1

