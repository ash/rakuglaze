=== hash-bool-if-empty
from: Cro::HTTP 0.8.13 lib/Cro/HTTP/Router/LinkGenerator.rakumod:113
license: Artistic-2.0
feature: stmt if
--- code
sub link(Str $base, *%nameds) {
    my $result = $base;
    if %nameds {
        $result ~= '?' ~ %nameds.sort(*.key).map({ .key ~ "=" ~ .value.Str }).join('&');
    }
    $result
}
say link('/a');
say link('/a', b => 2, a => 'x');
--- expect
/a
/a?a=x&b=2

