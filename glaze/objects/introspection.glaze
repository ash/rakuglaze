=== obj-add-method-dynamic-accessors
from: DB::Xoos 0.1.1 lib/DB/Xoos/Row.pm6:28
license: Artistic-2.0
feature: method add_method
--- code
my class Row {
    has %.data;
    method TWEAK {
        for %!data.keys.sort -> $key {
            self.^add_method($key, method ($value?) {
                %!data{$key} = $value if $value.defined;
                %!data{$key}
            }) unless self.^can($key);
        }
    }
}
my $r = Row.new(data => { id => 1, title => 'x' });
say $r.title;
$r.title('y');
say $r.title, ' ', $r.id;
--- expect
x
y 1

=== obj-add-method-class-body
from: HTTP::Tinyish 0.4.2 lib/HTTP/Tinyish/Base.rakumod:5
license: Artistic-2.0
feature: method add_method
--- code
my class Base {
    method request($method, $url, *%opts) { "$method $url" ~ (%opts ?? ' +opts' !! '') }
    for <get head put post delete> -> $method {
        ::?CLASS.^add_method: $method, method ($url, *%opts) {
            self.request($method.uc, $url, |%opts)
        };
    }
}
say Base.new.get('/a');
say Base.new.post('/b', :json);
--- expect
GET /a
POST /b +opts

