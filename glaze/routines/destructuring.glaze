# Sub-signatures and destructuring as modules write them: pairs unpacked in
# pointy blocks, `[$a, $b]` and `($a, $b)` element unpacking, `@ (...)` and
# `% (...)` parameter sub-signatures, and `my :(...) :=` binding.

=== sig-destructure-pair-pointy-map
from: Terminal::ANSI 0.0.25 lib/Terminal/ANSI/OO.rakumod:10
license: MIT
feature: sub-signature pair
--- code
my %colornums = red => 1, green => 2;
my %bg = %colornums.map: -> (:$key, :$value) { "bg-$key" => $value}
say %bg.sort.map(*.gist).join(' ');
--- expect
bg-green => 2 bg-red => 1

=== sig-destructure-array-param-is-copy
from: Color 1.004001 lib/Color/Conversion.rakumod:49
license: Artistic-2.0
feature: sub-signature list
--- code
sub cmyk2rgb( @ ($c is copy, $m is copy, $y is copy, $k is copy) )  {
    $_ /= 100 for $c, $m, $y, $k;
    (255 * (1 - $c) * (1 - $k), 255 * (1 - $m) * (1 - $k), 255 * (1 - $y) * (1 - $k))».round
}
say cmyk2rgb([0, 100, 100, 0]);
say cmyk2rgb((0, 0, 0, 50));
cmyk2rgb([1, 2]);
--- expect
(255 0 0)
(128 128 128)
!! X::AdHoc

=== sig-destructure-head-and-rest
from: Config::TOML 0.1.3 lib/Config/TOML/Parser/Actions.rakumod:892
license: Unlicense
feature: sub-signature list
--- code
multi sub pwd(Associative:D $container, @ ($step, *@rest) --> Array:D)
{
    my @path = $step;
    @path.append: pwd($container{$step}, @rest) if @rest;
    @path
}
multi sub pwd($container, @ ()) { [] }
my %t = a => { b => { c => 1 } };
say pwd(%t, <a b c>);
say pwd(%t, ['a']);
--- expect
[a b c]
[a]

=== sig-destructure-if-pointy-errors
from: TAP 0.3.15 lib/TAP.rakumod:457
license: Artistic-2.0
feature: sub-signature list
--- code
my class Result { has @.errors }
for Result.new(errors => <first second third>), Result.new -> $result {
    if $result.errors -> @ ($head, *@tail) {
        say "$head (+{@tail.elems} more)";
    }
    else {
        say 'clean';
    }
}
--- expect
first (+2 more)
clean

