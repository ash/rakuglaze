=== hash-pairs-map-rename-key
from: CSS::Properties 0.10.9 lib/CSS/Properties.rakumod:475
license: Artistic-2.0
feature: method pairs
--- code
my class Props {
    has %!important = color => True, 'margin_top' => False;
    method property-name($k) { $k.subst('_', '-', :g) }
    method important { %!important.pairs.map: { $.property-name(.key) => .value } }
}
say Props.new.important.sort(*.key).map(*.gist).join(' ');
--- expect
color => True margin-top => False

=== hash-pairs-map-sort-strings
from: BDD::Behave 0.9.5 lib/BDD/Behave/Diff.rakumod:169
license: Artistic-2.0
feature: method pairs
--- code
sub format-key($k) { $k ~~ Str ?? "'$k'" !! $k.raku }
my $value = { b => 2, a => 1 };
my @entries = $value.pairs.map({ format-key(.key) ~ ' => ' ~ .value }).sort;
say @entries.join(', ');
--- expect
'a' => 1, 'b' => 2

