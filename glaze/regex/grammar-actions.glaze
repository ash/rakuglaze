=== rx-inline-make-in-token
from: IO::Glob 0.9.0 lib/IO/Glob.pm6:144
license: Artistic-2.0
feature: call make
--- code
my grammar Base {
    token TOP { <term>+ { make $<term>».made } }
    token term {
        || <match> { make $<match>.made }
        || <char>  { make $<char>.made }
    }
    proto token match {*}
    token char { $<char> = . { make $<char>.Str } }
}
my grammar SQL is Base {
    token match:sym<%> { <sym> { make rx/.*?/ } }
    token match:sym<_> { <sym> { make rx/./ } }
}
my @parts = SQL.parse('a%b_').made;
say @parts.map({ $_ ~~ Regex ?? 'rx' !! $_ }).join(' ');
my $re = @parts.reduce(-> $a, $b { rx/ $a $b / });
say <ab axyzbq ab1 abc>.map({ so $_ ~~ /^ $re $/ }).join(' ');
--- expect
a rx b rx
False True True True

