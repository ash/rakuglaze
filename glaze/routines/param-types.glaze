=== sig-where-smartmatch-associative
from: Data::Transformers 0.0.2 lib/Data/Transformers/Rescale.rakumod:81
license: Artistic-2.0
feature: param where
--- code
multi sub rescale(@x) {
    my ($min, $max) = @x.min, @x.max;
    @x.map({ ($_ - $min) / ($max - $min) }).List
}
multi sub rescale($x where * ~~ Associative:D, $domain is copy = Whatever, $codomain is copy = Whatever) {
    my @k = $x.keys.sort;
    (@k Z=> rescale($x{@k})).List
}
say rescale([2, 4, 6]);
say rescale({ a => 10, b => 20, c => 15 });
--- expect
(0 0.5 1)
(a => 0 b => 1 c => 0.5)

