=== list-itemized-at-paren
from: Algorithm::Diff 0.0.5 lib/Algorithm/Diff.rakumod:155
license: Artistic-2.0
feature: prefix @
--- code
my %bMatches = x => [1, 4];
my $ai = 'x';
for @(%bMatches{$ai}) -> $j {
    say $j;
}
my $n = 0;
$n++ for %bMatches{$ai};
say $n;
--- expect
1
4
1

=== list-decont-for
from: Pod::To::Man 1.2.1 lib/Pod/To/Man.rakumod:14
license: Artistic-2.0
feature: postfix <>
--- code
my $pod = ['head', 'para', 'code'];
for $pod<> -> $node {
    print $node, ';';
}
say '';
my $c = 0;
$c++ for $pod;
say $c;
--- expect
head;para;code;
1

=== list-decont-hash-value
from: Anolis 1.0.0 lib/Anolis.rakumod:403
license: Artistic-2.0
feature: postfix <>
--- code
my %areas = 1 => [<a b>], 2 => [<c>];
my @areas = %areas.keys.sort.map(-> $y {
    %areas{$y}<>
}).flat;
say @areas;
--- expect
[a b c]

