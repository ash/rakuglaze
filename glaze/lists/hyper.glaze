# Hyper operators: >>.method, >>op<<, <<op>>, »op», assignment and broadcast forms.

=== list-hyper-dot-method
from: Crypt::LibGcrypt 1.0.11 lib/Crypt/LibGcrypt/Hash.rakumod:119
license: Artistic-2.0
feature: postfix ».
--- code
my $digest = Blob.new(0, 15, 171, 255);
say $digest».fmt("%02x").join;
--- expect
000fabff

=== list-hyper-dot-chained
from: DOM::Tiny 0.5.2 lib/DOM/Tiny/CSS.pm6:316
license: Artistic-2.0
feature: postfix ».
--- code
my @join-op = ' > ', ' + ', ' ~';
say @join-op».Str».trim.raku;
--- expect
[">", "+", "~"]

=== list-hyper-dot-ascii
from: Data::Importers 0.1.8 lib/Data/Importers/HarwellBoeing.rakumod:98
license: Artistic-2.0
feature: postfix >>.
--- code
my @line2 = <10 2 3 5 0 99>;
my ($totcrd, $ptrcrd, $indcrd, $valcrd, $rhscrd) = @line2[^5]>>.Int;
say $totcrd + $ptrcrd + $indcrd + $valcrd + $rhscrd;
say @line2[^5]>>.Int.^name;
--- expect
20
List

=== list-hyper-dot-key
from: Algorithm::KDimensionalTree 0.1.2 lib/Algorithm/KDimensionalTree.rakumod:46
license: Artistic-2.0
feature: postfix >>.
--- code
my @points = (a => [1, 2], b => [3, 4]);
my @labels = @points>>.key;
say @labels;
say @points>>.value>>.sum;
--- expect
[a b]
(3 7)

=== list-hyper-chars-max
from: Data::Dump::Tree 2.9.4 lib/Data/Dump/Tree/Diff.rakumod:34
license: Artistic-2.0
feature: postfix >>.
--- code
my %diff_glyphs = same => '==', changed => '!=!', gone => '-';
my $diff_glyph_width = max(%diff_glyphs.values>>.chars) + 2 ;
say $diff_glyph_width;
--- expect
5

=== list-hyper-infix-mult-reduce
from: Math::DistanceFunctions 0.1.4 lib/Math/DistanceFunctionish.rakumod:176
license: Artistic-2.0
feature: infix >>*<<
--- code
my @v1 = 1, 0, 1;
my @v2 = 1, 1, 0;
sub norm(@v) { sqrt([+] @v »*» @v) }
say 1.0 - ([+] (@v1 >>*<< @v2)) / (norm(@v1) * norm(@v2));
--- expect
0.5000000000000001

=== list-hyper-both-ways-plus
from: Math::Matrix 0.4.2 lib/Math/Matrix.rakumod:685
license: Artistic-2.0
feature: infix <<+>>
--- code
my @m = [1, 2, 3], [4, 5, 6];
my @v = 10, 20, 30;
my $row = 1;
@m[$row] = @m[$row] <<+>> @v;
say @m[$row];
--- expect
[14 25 36]

=== list-hyper-scalar-broadcast
from: Statistics::Distributions 0.1.8 lib/Statistics/Distributions/Utilities.rakumod:65
license: Artistic-2.0
feature: infix <<+>>
--- code
my @indices = 1, 5, 9;
say (@indices <<+>> -1).Array;
--- expect
[0 4 8]

=== list-hyper-row-reduction
from: Math::Matrix 0.4.2 lib/Math/Matrix.rakumod:416
license: Artistic-2.0
feature: infix >>-<<
--- code
my @clone = [2, 4], [6, 9];
my ($rank, $r, $q) = 0, 1, 3;
@clone[$r] = @clone[$rank] >>-<< $q <<*<< @clone[$r];
say @clone[$r];
--- expect
[-16 -23]

=== list-hyper-concat-right
from: Lingua::EN::Numbers 2.8.3 lib/Lingua/EN/Numbers.pm6:8
license: Artistic-2.0
feature: infix »~»
--- code
my @I = <one two three>;
my @C = @I »~» ' hundred';
say @C.join(', ');
--- expect
one hundred, two hundred, three hundred

=== list-hyper-both-sides-quote
from: Rakuast::RakuDoc::Render 1.1.4 lib/RakuDoc/Numeration.rakumod:70
license: Artistic-2.0
feature: infix «~«
