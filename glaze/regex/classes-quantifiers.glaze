# Character classes, unicode properties, quantifiers and separators.

=== rx-class-combined-named-plus-literal
from: Net::HTTP 0.1.0 lib/Net/HTTP/URL.rakumod:15
license: Artistic-2.0
feature: regex +[
--- code
my grammar Parser {
    token TOP { ^^ <scheme> ':' ['//' <host> [':' <port>]?]? [<path> || '/'] $$ }
    token scheme    { <.token>+ }
    token host      { [ '[' <+alnum +[:]>+ ']' ] || <+token -[+]>+ }
    token port      { \d ** 1..5     }
    token path      { <+[\S] -[?#]>* }
    token token     { <.alnum> || < +  - . > }
}
for 'http://example.com:8080/a/b', 'http://[fe80::1]/', 'git+ssh://x.y/' -> $u {
    with Parser.parse($u) { say "{.<scheme>} | {.<host>} | {.<port> // '-'} | {.<path> // '-'}" }
    else { say "no parse: $u" }
}
--- expect
http | example.com | 8080 | /a/b
http | [fe80::1] | - | /
git+ssh | x.y | - | /

=== rx-class-named-union-difference
from: Collection 0.18.0 lib/Collection/Entities.rakumod:12
license: Artistic-2.0
feature: regex alpha
--- code
my token plugin-name {
    <.alpha> <[\w] + [\-] - [\_]>+
};
for <cro-render a1 under_score 9lives x> -> $n {
    say $n, ': ', ($n ~~ /^ <plugin-name> $/ ?? 'ok' !! 'bad');
}
--- expect
cro-render: ok
a1: ok
under_score: bad
9lives: bad
x: bad

