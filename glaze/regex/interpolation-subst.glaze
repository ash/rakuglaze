=== rx-when-prefix-push
from: App::RaCoCo 2.0.1 lib/App/Racoco/Cli.rakumod:76
license: Artistic-2.0
feature: node RegexLit
--- code
my (@execs, @rest);
for <--exec=prove6 --fix --exec-other lib> {
    when /^'--exec'/ { push @execs, $_ }
    default { push @rest, $_ }
}
say @execs;
say @rest;
--- expect
[--exec=prove6 --exec-other]
[--fix lib]

=== rx-when-anchored-alternatives
from: CSS::Properties 0.10.9 lib/CSS/Box.rakumod:166
license: Artistic-2.0
feature: node RegexLit
--- code
for <padding-top border-left margin-bottom margin padding-x> {
    when /^ (padding|border|margin)'-'(top|right|bottom|left) $/ {
        say "$_: box={$0} edge={$1}";
    }
