=== num-narrow-rat-to-int
from: Lingua::EN::Numbers 2.8.3 lib/Lingua/EN/Numbers.pm6:30
license: Artistic-2.0
feature: method narrow
--- code
sub kind($rat is copy) {
    $rat .= Numeric.Rat;
    return "int {$rat.narrow}" if $rat.narrow ~~ Int;
    my ($num, $denom) = $rat.nude;
    "fraction $num over $denom"
}
say kind('4.0');
say kind('0.75');
say kind(6/4);
say 2e0.narrow.^name, ' ', 2.5e0.narrow.^name, ' ', (3+0i).narrow.^name;
--- expect
int 4
fraction 3 over 4
fraction 3 over 2
Int Num Int

=== num-nude-fatrat-sign
from: FatRatStr 0.0.14 lib/FatRatStr.rakumod:58
license: Artistic-2.0
feature: method nude
--- code
sub make-str($fatrat --> Str) {
    my ($num, $den) = $fatrat.nude;
    die "Division by zero" if $den == 0;
    my $sign = ($num < 0) ^ ($den < 0) ?? '-' !! '';
    my $n = $num.abs;
    my $d = $den.abs;
    return '0' if $n == 0;
    "$sign$n/$d"
}
say make-str(FatRat.new(-6, 8));
say make-str(FatRat.new(0, 5));
say make-str(10/4);
--- expect
-3/4
0
5/2

=== num-numerator-denominator-header
from: Data::Dump::Tree 2.9.4 lib/Data/Dump/Tree/DescribeBaseObjects.rakumod:116
license: Artistic-2.0
feature: method numerator
--- code
multi get_header(Rat $r) { $r  ~ ' (' ~ $r.numerator ~ '/' ~ $r.denominator ~ ')', '.' ~ $r.^name }
multi get_header(FatRat $r) { "<$r.numerator()/$r.denominator()>", '.' ~ $r.^name }
say get_header(0.75).join(' ');
say get_header(-1/3).join(' ');
say get_header(FatRat.new(1, 3)).join(' ');
--- expect
0.75 (3/4) .Rat
-0.333333 (-1/3) .Rat
<1/3> .FatRat

=== num-fatrat-new-exact
from: FatRatStr 0.0.14 lib/FatRatStr.rakumod:36
license: Artistic-2.0
feature: method FatRat
--- code
my ($adjusted, $shift) = 314159265358979323846, 20;
my $f = FatRat.new($adjusted, 10**$shift);
say $f;
say $f.^name;
say ($f * 2).^name;
say so $f.Rat;
say ($f + 1/3).nude.join("/").chars;
--- expect
3.14159265358979323846
FatRat
FatRat
False
43

=== num-fatrat-precision-sum
from: Math::SpecialFunctions 0.1.1 lib/Math/SpecialFunctions.rakumod:48
license: Artistic-2.0
feature: method FatRat
--- code
my @a = (^30).map({ FatRat.new(1, $_ + 1) });
my $h = [+] @a;
say $h.^name;
say $h.denominator.chars;
my $r = [+] (^30).map({ 1 / ($_ + 1) });
say $r.^name;
--- expect
FatRat
13
Rat

=== num-rat-zero-denominator
from: App::RaCoCo 2.0.1 lib/App/Racoco/Misc.rakumod:6
license: Artistic-2.0
feature: method Rat
--- code
sub percent($numerator, $denominator) {
    return 100.Rat if $denominator == 0;
    (($numerator / $denominator) * 100).round(0.01)
}
say percent(1, 3);
say percent(5, 0), ' ', percent(5, 0).^name;
say percent(3, 4);
--- expect
33.33
100 Rat
75

=== num-smartmatch-int
from: Anolis 1.0.0 lib/Anolis.rakumod:79
license: Artistic-2.0
feature: infix ~~
