=== ctl-label-for-last
from: Date::Names 2.3.2 lib/Date/Names.rakumod:313
license: Artistic-2.0
feature: sub last
--- code
sub month-num($s) {
    my @ab = <jan feb mar apr>;
    my $ret = 0;
    my $i   = 0;
    ABBREV: for @ab -> $a {
        ++$i;
        if $s ~~ /^:i $a/ {
            $ret = $i;
            last ABBREV;
        }
    }
    $ret
}
say month-num('March');
say month-num('Dec');
--- expect
3
0

=== ctl-label-next-unless-eqv
from: HTTP::Request::Supply 0.2.0 lib/HTTP/Request/Supply.pm6:186
license: Artistic-2.0
feature: sub next
--- code
my sub crlf-line(Buf $buf) {
    my $line-end;
    BYTE: for 0..$buf.bytes - 2 -> $i {
        next BYTE unless $buf[$i..$i+1] eqv (13, 10);
        $line-end = $i;
        last BYTE;
    }
    return Nil without $line-end;
    $buf.subbuf(0, $line-end).decode('latin-1')
}
say crlf-line(Buf.new("GET /\r\nHost".encode('latin-1')));
say crlf-line(Buf.new("partial".encode('latin-1'))).raku;
--- expect
GET /
Nil

=== ctl-label-next-outer
from: AttrX::Mooish 1.0.10 lib/AttrX/Mooish/ClassHOW.rakumod:84
license: Artistic-2.0
feature: sub next
--- code
my %seen-attr;
my @tasks = <a b a c b>;
my @done;
TASK: for @tasks -> $name {
    for 1..2 -> $pass {
        next TASK if %seen-attr{$name};
        %seen-attr{$name} = True if $pass == 2;
    }
    @done.push: $name;
}
say @done;
--- expect
[a b c]

=== ctl-redo-label-block
from: HTTP::UserAgent 1.2.0 lib/HTTP/Request.rakumod:249
license: MIT
feature: sub redo
--- code
my @parts = 'x--b10y', 'z--b11';
my $bno = 10;
my $boundary = "--b$bno";
CHECK_BOUNDARY: {
    for @parts {
        if $_.index($boundary).defined {
            $boundary = "--b{++$bno}";
            redo CHECK_BOUNDARY;
        }
    }
}
say $boundary;
--- expect
!! X::ControlFlow

