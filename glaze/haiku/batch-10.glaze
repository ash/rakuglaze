=== hk-10-trie-trace-path
from: ML::TriesWithFrequencies 0.6.8 lib/ML/TriesWithFrequencies/ChildRandomChooser.rakumod:31
license: Artistic-2.0
feature: @!tracedPaths.append($[|@currentPath, $tr.key => $tr.value])
--- code
my class Tracer {
    has @!tracedPaths;
    method trace(@currentPath, $tr) {
        @!tracedPaths.append($[|@currentPath, $tr.key => $tr.value]);
        @!tracedPaths
    }
}
say Tracer.new.trace(['a'], 'b' => 2).raku;
--- expect
[["a", :b(2)],]

=== hk-10-color-infix-lighten
from: Color 1.004001 lib/Color.rakumod:207
license: Artistic-2.0
feature: multi infix:<◐>(Color $c1, Real:D $Δ) is export
--- code
my class Color { has $.v; method lighten($d) { Color.new(v => $!v + $d) } }
multi infix:<◐>(Color $c1, Real:D $Δ) is export { $c1.lighten($Δ) }
my $c = Color.new(v => 10) ◐ 5;
say $c.v;
--- expect
15

