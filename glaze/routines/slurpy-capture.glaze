=== sig-explicit-percent-underscore-forward
from: Backtrace::Files 0.0.4 lib/Backtrace/Files.rakumod:20
license: Artistic-2.0
feature: param *% slurpy
--- code
my proto sub add-source-lines(|) {*}
my multi sub add-source-lines($file, @lines, *%_) {
    add-source-lines Pair.new($file, @lines), |%_
}
my multi sub add-source-lines(Pair:D $file-lines, :$context = 0) {
