from: Apache::LogFormat * lib/Apache/LogFormat/Formatter.pm6:8
license: Artistic-2.0
feature: colonpair :&name
--- code
my class Formatter {
    has &.callback;
    method new(&callback) {
        return self.bless(:&callback);
    }
    method format($x) { &!callback($x) }
}
say Formatter.new(-> $x { "[$x]" }).format('GET /');
--- expect
[GET /]

=== sig-named-hash-and-callable
from: App::RaCoCo 2.0.1 lib/App/Racoco/RunProc.rakumod:4
license: Artistic-2.0
feature: param :%named
--- code
my class RunProc {
    method run(:%vars, :&error-handler, |c) {
        my $env = %vars.sort.map({ "{.key}={.value}" }).join(' ');
        my $cmd = c.list.join(' ');
        &error-handler ?? error-handler("$env $cmd") !! "$env $cmd"
    }
}
say RunProc.new.run('raku', '-v', vars => { B => 2, A => 1 });
say RunProc.new.run('x', :error-handler({ "failed: $_" }));
--- expect
A=1 B=2 raku -v
failed:  x

