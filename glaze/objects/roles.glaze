=== obj-but-self-anon-role-nextwith
from: Distribution::Common 0.1.0 lib/Distribution/Common.rakumod:31
license: Artistic-2.0
feature: infix but
--- code
my class Dist {
    method ls-files { <lib/A.rakumod README.md> }
    method slurp-rest($path, :$bin) { "contents of $path" ~ ($bin ?? ' (bin)' !! '') }
    method content($name-path) {
        self but role :: {
            method open(|)  { self }
            method slurp-rest(|c) { nextwith($name-path, |c) }
            method e { $name-path ~~ any($.ls-files) }
        }
    }
}
my $h = Dist.new.content('README.md');
say $h.open.slurp-rest;
say $h.slurp-rest(:bin);
say $h.e, ' ', Dist.new.content('nope').e;
--- expect
contents of README.md
contents of README.md (bin)
True False

=== obj-does-mixin-on-attribute-trait
from: AttrX::Lazy 0.0.3 lib/AttrX/Lazy.pm6:48
license: Artistic-2.0
feature: infix does
--- code
my role LazyAttribute { has $.builder is rw = 'default-builder' }
multi trait_mod:<is>(Attribute:D $attr, :$lazy! ) {
    $attr does LazyAttribute;
    $attr.builder = $lazy.value if $lazy ~~ Pair && $lazy.key eq 'builder';
}
my class Thing {
    has $.a is lazy;
    has $.b is lazy(builder => 'make-b');
    has $.c;
}
for Thing.^attributes -> $attr {
    say $attr.name, ' ', $attr ~~ LazyAttribute ?? $attr.builder !! '-';
}
--- expect
$!a default-builder
$!b make-b
$!c -

=== obj-does-associative-class
from: Cro::HTTP 0.8.13 lib/Cro/HTTP/Body.rakumod:9
license: Artistic-2.0
feature: node Class
--- code
my class WWWFormUrlEncoded does Associative {
    has @.pairs;
    method AT-KEY($key) {
        my @v = @!pairs.grep(*.key eq $key).map(*.value);
        @v == 1 ?? @v[0] !! @v.List
    }
    method EXISTS-KEY($key) { so @!pairs.first(*.key eq $key) }
}
my $f = WWWFormUrlEncoded.new(pairs => (a => 1, b => 2, a => 3));
say $f<b>;
say $f<a>;
say $f<z>:exists, ' ', $f<a>:exists;
say $f ~~ Associative;
--- expect
2
(1 3)
False True
True

=== obj-callme-delegates
from: Cro::HTTP 0.8.13 lib/Cro/HTTP/Router/LinkGenerator.rakumod:14
license: Artistic-2.0
feature: method CALL-ME
--- code
my class LinkGenerator {
    has Str $.prefix is required;
    has Callable $!generator = -> *@parts { @parts.join('/') };
    method CALL-ME(|c) { self.absolute(|c) }
    method relative(|c) { $!generator(|c) }
    method absolute(|c) { '/' ~ ($!prefix ?? $!prefix ~ '/' !! '') ~ $!generator(|c) }
}
my $link = LinkGenerator.new(prefix => 'api');
say $link('users', 42);
say $link.relative('users');
say LinkGenerator.new(prefix => '')('x');
--- expect
/api/users/42
users
/x

=== obj-callme-rw-proxy
from: Hash::MultiValue 0.7 lib/Hash/MultiValue.pm6:299
license: Artistic-2.0
feature: method CALL-ME
--- code
my class MultiValue {
    has @.all-pairs;
    method CALL-ME($key) is rw {
        my @all-pairs := @!all-pairs;
        Proxy.new(
            FETCH => method () { @(@all-pairs.grep({ .key eqv $key })».value) },
            STORE => method (*@new) { @all-pairs.push: $key => $_ for @new },
        )
    }
}
my $mv = MultiValue.new(all-pairs => [a => 1, b => 2, a => 3]);
say $mv('a').join(', ');
$mv('b') = 7, 8;
say $mv('b').join(', ');
--- expect
1, 3
2, 7, 8

=== obj-role-own-type-attribute
from: PDF::Class 0.5.30 lib/PDF/Class/OutlineNode.rakumod:7
license: Artistic-2.0
feature: node Role
--- code
my role OutlineNode {
    has $.Title;
    has $.Next is rw;
    method titles {
        my class Siblings {
            has ::?ROLE:D $.first is required;
            method list { my $c = $!first; gather while $c { take $c.Title; $c = $c.Next } }
        }
        Siblings.new(first => self).list
    }
}
my class Item does OutlineNode { }
my $a = Item.new(Title => 'A');
$a.Next = Item.new(Title => 'B');
say $a.titles;
--- expect
(A B)

=== obj-role-fallback-none
from: Definitely 2.1.4 lib/Definitely.rakumod:183
license: MIT
feature: node Role
--- code
my role None {
    method Bool { False }
    method defined { False }
    method FALLBACK (*@rest) {
        return None;
    }
}
my $n = None.new;
say $n.so, ' ', $n.defined;
say $n.anything.^name;
say $n.foo.bar ~~ None;
