=== hk-11-samewith-named
from: Dan 0.0.3 lib/Dan.rakumod:195
license: Artistic-2.0
feature: samewith with named and slurpy arguments
--- code
multi sub series(:@data!, :$index!, *%h) {
    "{@data.join(',')} @ {$index.join(',')}" ~ %h.sort.map({ " {.key}={.value}" }).join
}
multi sub series(:$data!, :$index!, *%h) {
    samewith( data => ($data xx $index.elems).Array, :$index, |%h )
}
say series(data => 0, index => <a b c>);
say series(data => 5, index => <x y>, name => 'n');
say series(data => [1, 2], index => <p q>);
--- expect
0,0,0 @ a,b,c
5,5 @ x,y name=n
1,2 @ p,q

