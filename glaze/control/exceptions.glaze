--- code
my class X::Libarchive is Exception {
    has $.errno;
    has $.error;
    method message { "Error {$!errno}: $!error"; }
}
sub write-entry($ro) {
    fail X::Libarchive.new: errno => 30, error => 'Read-only entry' if $ro;
    True
}
my $r = write-entry(True);
say $r.handled;
say $r.so;
say $r.handled;
say $r.exception.message;
say write-entry(False);
--- expect
False
False
True
Error 30: Read-only entry
True

