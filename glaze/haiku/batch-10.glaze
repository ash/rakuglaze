=== hk-10-cross-tabulate-made
from: DSL::English::DataQueryWorkflows 0.6.5 lib/DSL/English/DataQueryWorkflows/Actions/Spanish/Standard.rakumod:215
license: Artistic-2.0
feature: method cross-tabulate-command($/) { $<cross-tabulation-formula>.made }
--- code
my grammar Cross {
    token TOP { <cross-tabulate-command> }
    token cross-tabulate-command { <cross-tabulation-formula> }
    token cross-tabulation-formula { <[a..z]>+ ' by ' <[a..z]>+ }
}
my class CrossActions {
    method cross-tabulation-formula($/) { make $/.Str.uc }
    method cross-tabulate-command($/) { make $<cross-tabulation-formula>.made }
    method TOP($/) { make $<cross-tabulate-command>.made }
}
say Cross.parse('age by sex', :actions(CrossActions.new)).made;
--- expect
AGE BY SEX

