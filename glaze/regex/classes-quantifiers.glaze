=== rx-unicode-control-subst-escape
from: BDD::Behave 0.9.5 lib/BDD/Behave/Formatter/JsonEvents.rakumod:45
license: Artistic-2.0
feature: regex <:Cc>
--- code
my $out = "line1\nline2\ttab\x[7]";
$out = $out.subst(/<:Cc>/, { sprintf('\\u%04x', $/.Str.ord) }, :g) if $out ~~ /<:Cc>/;
say $out;
my $plain = 'no controls';
$plain = $plain.subst(/<:Cc>/, { sprintf('\\u%04x', $/.Str.ord) }, :g) if $plain ~~ /<:Cc>/;
say $plain;
--- expect
line1\u000aline2\u0009tab\u0007
no controls

