# Grammars with action classes: make/made, proto tokens, parse/subparse with :rule and :actions.

=== rx-ini-grammar-actions
from: App::RaCoCo 2.0.1 lib/App/Racoco/ConfigFile.rakumod:48
license: Artistic-2.0
feature: node Grammar
--- code
my grammar INI {
    token TOP { <.eol>* <toplevel>? <sections>* <.eol>* $ }
    token toplevel { <keyval>* }
    token sections { <header> <keyval>* }
    token header   { ^^ \h* '[' ~ ']' $<text>=<-[ \] \n ]>+ \h* <.eol>+ }
    token keyval   { ^^ \h* <key> \h* '=' \h* <value>? \h* <.eol>+ }
    regex key      { <![#\[]> <-[;=]>+ }
    regex value    { [ <![#;]> \N ]+ }
    token eol      { [ <[#;]> \N* ]? \n }
}
my class INI-Actions {
    method TOP ($/) {
        my %hash = $<sections>».ast;
        %hash<_> = $<toplevel>.ast.hash if $<toplevel>.?ast;
        make %hash;
    }
    method toplevel($/) { make $<keyval>».ast.hash }
    method sections($/) { make $<header><text>.Str => $<keyval>».ast.hash }
    method keyval($/) { make $<key>.Str.trim => $<value>.defined ?? $<value>.ast !! '' }
    method value($/) {
        with $/.Str.trim {
            make $_;
            make True if $_ ~~ any(<yes on true True 1>);
            make False if $_ ~~ any(<no off false False 0>);
        }
    }
}
my %ini = INI.parse("name = x\n[report]\ncolor = yes ; c\nwidth = 80\n", :actions(INI-Actions.new)).ast;
for %ini.sort -> $s { say $s.key, ': ', $s.value.sort.map({ "{.key}={.value.raku}" }).join(' ') }
--- expect
_: name="x"
report: color=Bool::True width="80"

