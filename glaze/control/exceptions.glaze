=== ctl-error-collect-rethrow
from: Cro::Core 0.8.10 lib/Cro/MessageWithBody.rakumod:64
license: Artistic-2.0
feature: method rethrow
--- code
sub decode-with($blob, @encodings) {
    my $result;
    my $error;
    for @encodings -> $try-enc {
        $result = $blob.decode($try-enc);
        CATCH {
            default {
                $error = $_;
            }
        }
    }
    $result // $error.rethrow
}
say decode-with(Blob.new(104, 105), ["utf-8"]);
say decode-with(Blob.new(104, 105), ["bogus-enc", "ascii"]);
decode-with(Blob.new(104), ["bogus-enc"]);
--- expect
hi
hi
!! X::AdHoc

