license: Artistic-2.0
feature: method BagHash
--- code
my @vertexes = <a b c>;
my @degrees = 2, 0, 3;
my $vertexBag = (@vertexes Z=> @degrees).BagHash;
say $vertexBag.total;
say $vertexBag.keys.sort;
--- expect
5
(a c)

=== hash-set-baghash-new-bound
from: Hash::MultiValue 0.7 lib/Hash/MultiValue.pm6:55
license: Artistic-2.0
feature: type BagHash
--- code
my %encountered := BagHash.new;
for <k1 k2 k1> -> $k {
    say "$k seen before" if %encountered{$k}++;
}
say %encountered.^name;
say %encountered.total;
--- expect
k1 seen before
BagHash
3

