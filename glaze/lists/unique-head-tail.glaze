# unique (:as, :with), squish, repeated, reverse, head/tail/skip with counts and *-N.

=== list-unique-as-named-arg
from: Air 0.1.32 lib/Air/Base.rakumod:777
license: Artistic-2.0
feature: method unique
--- code
my class A {}
my class B {}
my @register = A.new, B.new, A.new;
for @register.unique( as => *.^name ) -> $registrant {
    say $registrant.^name;
}
--- expect
A
B

=== list-unique-as-adverb-block
from: zef 1.1.4 lib/Zef/CLI.rakumod:546
license: Artistic-2.0
feature: method unique
--- code
my @hits = { from => 'p6c', id => 'Foo:1' }, { from => 'cpan', id => 'Foo:1' }, { from => 'p6c', id => 'Foo:1' };
my @results = @hits.unique(:as({ .<from> ~ ' ' ~ .<id> }));
say @results.elems;
say @results.map(*<from>);
--- expect
2
(p6c cpan)

=== list-unique-with-lc
from: Template::Jinja2 0.3.0 lib/Template/Jinja2/Filters.rakumod:307
license: Artistic-2.0
feature: method unique
--- code
my @items = 'Foo', 'foo', 42, 'BAR', 42, 'bar';
say @items.unique(:with(-> $a, $b { $a ~~ Str && $b ~~ Str ?? $a.lc eq $b.lc !! $a eqv $b })).list;
--- expect
(Foo 42 BAR)

=== list-unique-then-slip
from: App::RaCoCo 2.0.1 lib/App/Racoco/Cli.rakumod:64
license: Artistic-2.0
feature: method Slip
--- code
my @collect = 'first';
my $unique = <--reporter=html --x --reporter=json --reporter=html>.Set;
push @collect, $unique.keys.grep(*.starts-with('--reporter=')).map(*.substr(11)).unique.Slip;
say @collect.elems;
say @collect.sort;
--- expect
3
(first html json)

=== list-unique-hyper-count
from: CSS::Properties 0.10.9 lib/CSS/Properties/Optimizer.rakumod:151
license: Artistic-2.0
feature: method unique
--- code
my @asts = { prio => 'important' } xx 4;
say @asts == 4 && @asts»<prio>.unique == 1;
@asts[2]<prio> = Nil;
say @asts»<prio>.unique.elems;
--- expect
True
2

=== list-repeated
from: Text::CSV 0.022 lib/Text/CSV.rakumod:648
license: Artistic-2.0
feature: method repeated
--- code
my @row = <id name id email name id>;
if (my @dup = @row.repeated) {
    say @dup;
    say @dup.Bag.sort(*.key).map({ "{$_.key}({$_.value + 1})" }).join: ", ";
}
--- expect
[id name id]
id(3), name(2)

=== list-reverse-indices
from: Array::Agnostic 0.0.18 lib/Array/Agnostic.rakumod:69
license: Artistic-2.0
feature: method reverse
--- code
my @a = <a b c d>;
my @order;
@order.push($_) for (^@a.elems).reverse;
say @order;
say (^4).reverse.^name;
--- expect
[3 2 1 0]
Seq

=== list-reverse-flip-comb
from: MVC::Keayl 0.9.2 lib/MVC/Keayl/Helpers/Number.rakumod:15
license: Artistic-2.0
feature: method reverse
--- code
my $integer = '1234567';
my $delimiter = ',';
my $grouped = $integer.flip.comb(3)>>.flip.reverse.join($delimiter);
say $grouped;
--- expect
1,234,567

=== list-head-n
from: Base64 0.1.0 lib/Base64.rakumod:43
license: Artistic-2.0
feature: method head
--- code
my @res = <Q U J D>;
for 2, 3, 4 -> $n {
    say @res.head( 3 - ( 4 - $n ) );
}
--- expect
(Q)
(Q U)
(Q U J)

=== list-head-whatever-minus
from: Graph 0.1.3 lib/Graph.rakumod:886
license: Artistic-2.0
feature: method head
--- code
sub drop-last(@path) { @path ?? @path.head(*-1) !! [] }
say drop-last(<a b c>);
say drop-last(());
say (1..5).head(*-2);
--- expect
(a b)
[]
(1 2 3)

=== list-tail-whatever-minus
