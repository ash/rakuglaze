license: MIT
feature: call fail
--- code
my @loaded = <JSON::Fast Test>;
sub find-loaded($match) {
    my $found = @loaded.first($match);
    return $found || fail "unable find loaded compunit matching '{$match.gist}'";
}
say find-loaded(/JSON/);
with find-loaded('Nope') { say 'found' } else { say .exception.message }
--- expect
JSON::Fast
unable find loaded compunit matching 'Nope'

