(2)
aaa..mmm

=== list-shaped-array-too-many
from: HarfBuzz 0.1.7 lib/HarfBuzz/Shaper.rakumod:123
license: Artistic-2.0
feature: decl shaped array
ruled: Raku++ throws X::OutOfRange past a shaped array's bound; Rakudo throws X::AdHoc with the same message
--- code
my @scale = 2, 4;
my $size = 12;
my @vec[2] = @scale.map: $size / *;
say @vec;
my @three[2] = 1, 2, 3;
--- expect
[6 3]
!! X::OutOfRange

=== list-multidim-semicolon-index
from: Dan 0.0.3 lib/Dan.rakumod:315
license: Artistic-2.0
feature: index [;]
--- code
my @series = [1, 2, 3], [4, 5, 6];
my @data;
for ^2 -> $i {
    for ^3 -> $j {
        @data[$j;$i] = @series[$i][$j]
    }
}
say @data.elems;
say @data[2;1];
say @data.map(*.join(',')).join(' ');
--- expect
3
6
1,4 2,5 3,6

