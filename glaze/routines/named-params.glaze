=== sig-named-bool-D-default-false
from: Graph 0.1.3 lib/Graph.rakumod:360
license: Artistic-2.0
feature: param :$named
--- code
my class Graph {
    has %.adj = a => { b => 1 }, b => { c => 2 };
    method edges(Bool:D :$dataset = False) {
        my @e = %!adj.sort.map({ my $f = .key; .value.sort.map({ $f => .key }) }).flat;
        $dataset ?? @e.map({ %(from => .key, to => .value) }).List !! @e.map(*.gist).List
    }
}
say Graph.new.edges;
say Graph.new.edges(:dataset).map(*<to>);
Graph.new.edges(dataset => Bool);
--- expect
(a => b b => c)
(b c)
!! X::Parameter::InvalidConcreteness

