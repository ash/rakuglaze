# Match objects: positions, pre/postmatch, captures, caps and chunks.

=== rx-prematch-plus-capture
from: Lingua::EN::Stem::Porter 1.2 lib/Lingua/EN/Stem/Porter.rakumod:84
license: MIT
feature: method prematch
--- code
for <caresses ponies cats caress> -> $word is copy {
    if $word ~~ /[(ss||i)es||(<-[s]>)s]$/ {
        $word = $/.prematch ~ $0;
    }
    say $word;
}
--- expect
caress
poni
cat
caress

=== rx-postmatch-empty-match-guard
from: Bailador 0.0.19 lib/Bailador/Route.pm:35
license: MIT
feature: method postmatch
--- code
my $uri = '/admin/users/42';
my $match = $uri ~~ / '/admin' /;
my $postmatch =
    $match.to == $match.from ??
    $uri.substr($match.to) !!
    $match.postmatch;
my $prematch = $match.prematch;
say "[$prematch] [$postmatch]";
say $match.from, ' ', $match.to;
--- expect
[] [/users/42]
0 6

=== rx-match-to-substr-rest
from: MVC::Keayl 0.9.2 lib/MVC/Keayl/Params.rakumod:37
license: Artistic-2.0
feature: method to
--- code
sub normalize(Str:D $name) {
    return 'no key' unless $name ~~ / ^ <[\[\]]>* (<-[\[\]]>+) <[\]]>* /;
    my $key   = ~$0;
    my $after = $name.substr($/.to);
    "$key | '$after'";
}
say normalize('user[name]');
say normalize('ids[]');
say normalize('plain');
say normalize('[]');
--- expect
user | '[name]'
ids | '[]'
plain | ''
no key

=== rx-from-or-to-by-capture
from: Template::Mustache 1.2.7 lib/Template/Mustache.rakumod:231
license: Artistic-2.0
feature: method from
--- code
for '{{#items}}', '{{/items}}' -> $tag {
    $tag ~~ / '{{' (<[#/^]>) (\w+) '}}' /;
    my %h = :val(~$1.trim), :on($0 ne '/'), :pos($0 eq '/' ?? $/.from !! $/.to);
    say %h.sort.map({ "{.key}={.value}" }).join(' ');
}
--- expect
on=True pos=10 val=items
on=False pos=0 val=items

=== rx-postmatch-stringified
from: Rakuast::RakuDoc::Render 1.1.4 lib/RakuDoc/Render.rakumod:279
license: Artistic-2.0
feature: method postmatch
--- code
my $remaining = 'head: Title text here';
if $remaining ~~ / ^ (\w+) ':' \s* / {
    my $kind = ~$0;
    $remaining = ~$/.postmatch;
    say "$kind -> $remaining";
    say $remaining.WHAT.^name;
}
--- expect
head -> Title text here
Str

=== rx-prematch-or-empty-ternary
from: XML::XPath 0.9.3 lib/XML/XPath/FunctionCall/String.pm6:34
license: Artistic-2.0
feature: method prematch
--- code
sub substring-before(Str $s, Str $sep) {
    my $match = $s.match($sep);
    return $match ?? $match.prematch !! '';
}
sub substring-after(Str $s, Str $sep) {
    my $match = $s.match($sep);
    return $match ?? $match.postmatch !! '';
}
say substring-before('1999/04/01', '/');
say substring-after('1999/04/01', '/');
say substring-before('abc', 'x').raku;
--- expect
1999
04/01
""

=== rx-caps-pairs-key-value
from: CSS::Grammar 0.4.3 lib/CSS/Grammar/AST.rakumod:45
license: Artistic-2.0
feature: method caps
--- code
my $m = 'margin: 1px auto' ~~ / <prop=.ident> ':' [\s* $<val>=\w+]+ /;
for $m.caps -> Pair:D $_ {
    my $key = .key.lc;
    say $key, ' => ', .value.Str;
}
--- expect
prop => margin
val => 1px
val => auto

=== rx-caps-map-value-join
from: Cro::Core 0.8.10 lib/Cro/MediaType.rakumod:88
license: Artistic-2.0
feature: method caps
--- code
my grammar QS {
    token TOP { '"' ~ '"' [<qtext> | <quoted-pair>]* }
    token qtext { <-["\\\n]>+ }
    token quoted-pair { \\ <( . )> }
}
my $m = QS.parse(Q{"say \"hi\" now"});
say $m.caps.map(*.value.Str).join;
say $m.caps.map(*.key).join(',');
--- expect
say "hi" now
qtext,quoted-pair,qtext,quoted-pair,qtext

=== rx-caps-elems-count
from: Data::Dump::Tree 2.9.4 lib/Data/Dump/Tree/ExtraRoles.rakumod:27
license: Artistic-2.0
feature: method caps
--- code
my $m = 'key=value' ~~ / $<k>=\w+ '=' $<v>=\w+ /;
say $m.caps.elems;
say $m.caps>>.kv.map(-> ($k, $v) { "<$k> $v" }).join('; ');
my $none = 'abc' ~~ / \w+ /;
say $none.caps.elems;
--- expect
2
<k> key; <v> value
0

=== rx-chunks-keyed-pieces
from: Text::ShellWords 0.1.1 lib/Text/ShellWords.rakumod:144
license: Artistic-2.0
feature: method chunks
--- code
my token dq {
    '"' ~ '"'
    [$<plain> = <-[\\"]> *] *
        %% $<bs> = [\\ .]
}
my $m = Q{"a\"b\\c"} ~~ / <dq> /;
say $m<dq>.chunks.map(-> $c {
    given $c.key {
        when '~'  { "~({$c.value})" }
        when 'bs' { $c.value.substr(1) }
        default   { $c.value.Str }
    }
}).join('|');
--- expect
~(")|a|"|b|\|c|~(")

=== rx-values-first-made
from: DSL::Shared 0.2.11 lib/DSL/Shared/Actions/Bulgarian/Standard/ListManagementCommand.rakumod:5
license: Artistic-2.0
feature: method made
--- code
my grammar Cmd {
    token TOP { <take> | <drop> }
    token take { 'take' \s+ (\d+) }
    token drop { 'drop' \s+ (\d+) }
}
my class A {
    method TOP($/) { make $/.values[0].made; }
    method take($/) { make "head($0)" }
    method drop($/) { make "skip($0)" }
}
say Cmd.parse('take 3', :actions(A)).made;
say Cmd.parse('drop 10', :actions(A)).made;
--- expect
head(3)
skip(10)

=== rx-named-capture-list-index
from: Intl::Number::Plural 0.5.4 lib/Intl/Number/Plural.pm6:256
license: Artistic-2.0
feature: regex make
--- code
my grammar R {
    token TOP { <value> '..' <value> }
    token value { \d+ }
}
my class RA {
    method TOP ($/) { make $<value>[0].Str.Int..$<value>[1].Str.Int }
}
my $r = R.parse('2..5', :actions(RA)).made;
say $r.raku;
say $r.elems;
--- expect
2..5
4

=== rx-named-inside-positional
from: PDF::Content 0.9.11 lib/PDF/Content/Image.rakumod:48
license: Artistic-2.0
feature: regex ident
--- code
for 'data:image/PNG;base64,iVBOR', 'data:,hello' -> $uri {
    $uri ~~ m/^('data:' [<t=.ident> '/' <s=.ident>]? $<b64>=";base64"? $<start>=",") /;
    my $path = ~ $0;
    my Str $mime-type = ( $0<t> // '(missing)').lc;
    my Str $mime-subtype = ( $0<s> // '').lc;
    my Bool \base64 = ? $0<b64>;
    say "$path | $mime-type | $mime-subtype | {base64}";
}
--- expect
data:image/PNG;base64, | image | png | True
data:, | (missing) |  | True

=== rx-match-pos-zero-no-match
