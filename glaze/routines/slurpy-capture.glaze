=== sig-slurpy-is-copy-method
from: BitEnum 0.5 lib/BitEnum.rakumod:23
license: Artistic-2.0
feature: trait is copy
--- code
my class Bits {
    has Int $.value is rw = 0;
    method set(*@bits is copy --> Nil)
    {
        @bits .= map({ 1 +< $_ });
        $!value +|= $_ for @bits;
    }
}
my $b = Bits.new;
say $b.set(0, 3);
say $b.value;
--- expect
Nil
9

