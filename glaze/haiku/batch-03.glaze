--- code
my class Self {
    method url-for($p) { "url" }
    method path-for($p) { "path" }
}
my $self = Self.new;
my $url = "http://example.com";
my $plural = "items";
my $result = $url ?? $self.url-for($plural) !! $self.path-for($plural);
say $result;
--- expect
url

