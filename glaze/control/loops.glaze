=== ctl-last-phaser-in-map
from: Base64 0.1.0 lib/Base64.rakumod:21
license: Artistic-2.0
feature: phaser LAST
--- code
my $pad = '=';
for (1, 2, 3), (1, 2), (1,) -> $chunk {
    my $padding = 0;
    my $n := [+] $chunk.pairs.map: -> $c {
        LAST { $padding = !$pad ?? 0 !! do with (3 - ($c.key+1) % 3) { $^a == 3 ?? 0 !! $^a } }
        $c.value
    }
    say "$n pad $padding";
}
--- expect
6 pad 0
3 pad 1
1 pad 2

