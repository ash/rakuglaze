=== obj-nextwith-clone-deep
from: Dan 0.0.3 lib/Dan.rakumod:33
license: Artistic-2.0
feature: call nextwith
--- code
my class Series {
    has @.data;
    has Int %.index;
    method clone {
        nextwith( :data(@!data.map(*.clone)), :%!index, |%_ )
    }
}
my $s = Series.new(data => [[1, 2], [3]], index => { a => 0, b => 1 });
my $t = $s.clone;
$t.data[0].push: 99;
say $s.data[0], ' ', $t.data[0];
say $t.index<b>;
say $s.clone(index => { z => 5 }).index.keys;
--- expect
[1 2] [1 2 99]
1
(z)

=== obj-samewith-multi-new
from: Dan 0.0.3 lib/Dan.rakumod:28
license: Artistic-2.0
feature: call samewith
--- code
my class Series {
    has @.data;
    has Int %.index;
    multi method new( List:D :$index, *%h ) {
        samewith( index => $index.map({ $_ => $++ }).Hash, |%h )
    }
}
my $s = Series.new(index => <x y z>, data => [1, 2, 3]);
say $s.index.sort.map(*.kv.join('=')).join(',');
say $s.data;
--- expect
x=0,y=1,z=2
[1 2 3]

=== obj-nextwith-proto-new
from: Intl::LanguageTag 0.12.7 lib/Intl/LanguageTag/BCP47.rakumod:63
license: Artistic-2.0
feature: call nextwith
--- code
my class LanguageTag {
    has @.subtags;
    proto method new(|) {*}
    multi method new(Str $tag) {
        nextwith $tag.lc.split('-')
    }
    multi method new(*@subtags) {
        self.bless: :@subtags
    }
}
say LanguageTag.new('EN-Latn-US').subtags;
say LanguageTag.new('de', 'AT').subtags;
--- expect
[en latn us]
[de AT]

=== obj-callwith-changes-args
from: HTTP::UserAgent 1.2.0 lib/HTTP/Request.rakumod:272
license: MIT
feature: call callwith
--- code
my $CRLF = "\r\n";
my class Message {
    has @.headers;
    method Str($eol = "\n", :$debug, Bool :$bin) { @.headers.join($eol) }
}
my class Request is Message {
    has $.method = 'GET';
    has $.file = 'index.html';
    method Str (:$debug, Bool :$bin) {
        my $s = "$.method /$.file HTTP/1.1";
        $s ~= $CRLF ~ callwith($CRLF, :$debug, :$bin);
    }
}
say Request.new(headers => <Host:x Accept:*>).Str.raku;
--- expect
"GET /index.html HTTP/1.1\r\nHost:x\r\nAccept:*"

=== obj-callwith-mu-new-rest
from: Notcurses::Native 0.6.6 lib/Notcurses/Native/Types.rakumod:141
license: Artistic-2.0
feature: call callwith
--- code
my class Options {
    has $.termtype is rw;
    has uint32 $.margin_t = 0;
    has uint64 $.flags = 0;
    multi method new(Str :$termtype, *%rest) {
        my $self = callwith(|%rest);
        $self.termtype = $termtype.uc;
        $self
    }
}
my $o = Options.new(termtype => 'xterm', flags => 3);
say $o.termtype, ' ', $o.flags, ' ', $o.margin_t;
--- expect
XTERM 3 0

=== obj-nextcallee-wrap-method
from: Method::Protected 0.0.4 lib/Method/Protected.rakumod:2
license: Artistic-2.0
feature: method wrap
--- code
my &protected = my method (|c) {
    my &original = nextcallee;
    "[" ~ original(self, |c) ~ "]"
}
my class Counter {
    method show($n) { "n=$n" }
}
Counter.^find_method('show').wrap(&protected);
say Counter.new.show(3);
--- expect
[n=3]

=== obj-private-method-args
from: Auth::SCRAM::Async 0.0.1 lib/Auth/SCRAM/Async.rakumod:82
license: Artistic-2.0
feature: node Method
--- code
my class Client {
    method !read-session(Str:D $input) {
        $input.split(',').map({ .substr(0, 1) => .substr(2) }).Hash
    }
    method first($server-first) {
        my %response = self!read-session($server-first);
        %response<r> ~ '/' ~ %response<i>;
    }
}
say Client.new.first('r=abc,s=salt,i=4096');
say Client.can('read-session').elems;
--- expect
abc/4096
0

