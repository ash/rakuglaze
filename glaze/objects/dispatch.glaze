3
5

=== obj-submethod-singleton-instance
from: Air 0.1.32 lib/Air/Base.rakumod:282
license: Artistic-2.0
feature: decl submethod
--- code
my class Head {
    my Head $instance;
    has $.made = 0;
    submethod instance {
        unless $instance {
            $instance = Head.bless(made => 1);
        };
        $instance;
    }
}
my class SubHead is Head { }
say Head.instance === Head.instance;
say Head.instance.made;
SubHead.instance;
--- expect
True
1
!! X::Method::NotFound
