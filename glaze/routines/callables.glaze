=== sig-return-postfix-condition
from: Algorithm::SetUnion 0.0.1 lib/Algorithm/SetUnion.pm6:19
license: Artistic-2.0
feature: node Return
--- code
my class SetUnion {
    has @.parent = ^5;
    method find($i) { @!parent[$i] == $i ?? $i !! self.find(@!parent[$i]) }
    method union(Int $left-index, Int $right-index --> Bool:D) {
        my ($left-root, $right-root) = self.find($left-index), self.find($right-index);
        return False if $left-root == $right-root;
        @!parent[$right-root] = $left-root;
        True
    }
}
my $u = SetUnion.new;
say $u.union(0, 1), $u.union(1, 2), $u.union(0, 2);
--- expect
TrueTrueFalse

