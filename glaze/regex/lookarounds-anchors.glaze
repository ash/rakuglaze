=== rx-ordered-alternation-named-regex
from: Bailador 0.0.19 lib/Bailador/Request.pm:46
license: MIT
feature: regex [
--- code
my regex bcharnospace { <[0..9]> || <[ a..z  A..Z]> || "'" || '(' || ')' || '+' || '_' || ',' || '-' || '.'  || '/' || ':' || '=' || '?' };
my $ct = 'multipart/form-data; boundary="----abc_123"';
if $ct ~~ / 'multipart/form-data;'  .* 'boundary' '=' '"' ? ( <bcharnospace> ** 0..69  ) \s* '"' ? / {
    say ~$0;
}
--- expect
----abc_123

=== rx-ordered-alternation-fallback
from: Apache::LogFormat * lib/Apache/LogFormat/Compiler.pm6:12
license: Artistic-2.0
feature: regex [
--- code
my grammar F {
    token TOP { [ <directive> | <literal> ]+ }
    token directive { '%' [ <block-section> || <char-name> ] }
    token block-section { '{' $<block>=<-[}]>+ '}' $<type>=<[a..zA..Z]> }
    token char-name { <[a..zA..Z%]> }
    token literal { <-[\%]>+ }
}
my $m = F.parse('%h %{User-agent}i "%r" %%');
say $m<directive>.map({ .<block-section> ?? "B({.<block-section><block>}:{.<block-section><type>})" !! "C({.<char-name>})" }).join(' ');
--- expect
C(h) B(User-agent:i) C(r) C(%)

=== rx-ltm-vs-ordered
from: Crust 0.0.1 lib/Crust/Request.pm6:70
license: Artistic-2.0
feature: regex [
--- code
my @keys = <HTTP_HOST CONTENT_LENGTH SERVER_NAME http_x>;
say @keys.grep({ m:i/^(HTTP|CONTENT)/ }).join(',');
say ('abcd' ~~ / ab | abcd /).Str;
say ('abcd' ~~ / ab || abcd /).Str;
--- expect
HTTP_HOST,CONTENT_LENGTH,http_x
abcd
ab

=== rx-line-anchors-skip-blank
from: CSS::Specification 0.5.3 lib/CSS/Specification.rakumod:10
license: Artistic-2.0
feature: regex [
--- code
my grammar Spec {
    rule TOP { [<def=.prop-spec> | ^^ $$ || <.unexpected> ] * }
    token prop-spec { ^^ \w+ ':' \N* $$ }
    token unexpected { \N+ }
}
my $m = Spec.parse("color: red\n\nwidth: 1px\n");
say $m<def>.map(*.Str).join(' | ');
--- expect
color: red | width: 1px

=== rx-word-start-end-named-quote
from: Bailador 0.0.19 lib/Bailador/Request/Multipart.pm:16
license: MIT
feature: regex -[
--- code
for 'form-data; name="file"; filename="a.txt"', 'form-data; filename="b.txt"' -> $content-disposition {
    if $content-disposition ~~ / << name >> '=' '"' ( <-["]>+ ) '"' / {
        say "name: $0";
    }
    else {
        say 'no name';
    }
}
--- expect
name: file
no name

