=== hk-07-made-subrule-value-action
from: DSL::Shared 0.2.11 lib/DSL/Shared/Actions/English/TimeIntervalSpec.rakumod:72
license: Artistic-2.0
feature: .made<value> on a subrule match inside an action
--- code
my grammar Week {
    token TOP { <week-number-range> }
    token week-number-range { \d+ }
}
my class WeekAct {
    method week-number-range($/) { make %(value => $/.Int) }
    method TOP($/) { make $<week-number-range>.made<value> }
}
my $m = Week.parse('12', :actions(WeekAct.new));
say $m.made;
--- expect
12

=== hk-07-make-tilde-values-made-pivot
from: DSL::English::DataQueryWorkflows 0.6.5 lib/DSL/English/DataQueryWorkflows/Actions/R/base.rakumod:329
license: Artistic-2.0
feature: make with a ~ concatenation of a .values[0].made
--- code
my grammar Pivot {
    token TOP { <pivot-longer-columns-spec> }
    token pivot-longer-columns-spec { <cols> }
    token cols { \w+ }
}
my class PivotAct {
    method cols($/) { make ~$/ }
    method pivot-longer-columns-spec($/) { make 'varying = list(' ~ $/.values[0].made ~ ' )'; }
}
my $m = Pivot.parse('a', :actions(PivotAct.new));
say $m<pivot-longer-columns-spec>.made;
--- expect
varying = list(a )

