=== hash-when-associative
from: BDD::Behave 0.9.5 lib/BDD/Behave/Benchmark/Format.rakumod:26
license: Artistic-2.0
feature: stmt when
--- code
sub fmt($_) {
    when Associative { '{' ~ .keys.sort.join(',') ~ '}' }
    when Positional  { '[' ~ .join(',') ~ ']' }
    default          { ~$_ }
}
say fmt({ b => 1, a => 2 });
say fmt([1, 2]);
say fmt(Map.new((x => 1)));
say fmt(set <q>);
--- expect
{a,b}
[1,2]
{x}
{q}

