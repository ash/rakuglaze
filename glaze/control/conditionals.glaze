# if/elsif/else, unless, with/orwith/without, ternary chains, `do if`,
# statement modifiers — as modules branch.

=== ctl-elsif-type-chain
from: Abbreviations 2.2.3 lib/Abbreviations.rakumod:37
license: Artistic-2.0
feature: node If
--- code
sub words-of($word-set) {
    if $word-set ~~ Str {
        $word-set.words.List
    }
    elsif $word-set ~~ List {
        $word-set
    }
    else {
        die "unexpected type: {$word-set.^name}";
    }
}
say words-of('a bb c').elems;
say words-of(<x y>).join(',');
say (try words-of(42)) // 'died';
say $!.message;
--- expect
3
x,y
died
unexpected type: Int

=== ctl-elsif-defined-and
from: AlgorithmsIT 0.0.4 lib/AlgorithmsIT/Classes.rakumod:40
license: Artistic-2.0
feature: node If
--- code
my class Span {
    has $.R-start;
    has $.R-end;
    method describe {
        if !$!R-start.defined && !$!R-end.defined { 'empty' }
        elsif $!R-start.defined and $!R-end.defined { "{$!R-start}..{$!R-end}" }
        else { 'open' }
    }
}
say Span.new.describe;
say Span.new(R-start => 1, R-end => 5).describe;
say Span.new(R-start => 1).describe;
--- expect
empty
1..5
open

=== ctl-elsif-all-pairs
from: Algorithm::KDimensionalTree 0.1.2 lib/Algorithm/KDimensionalTree.rakumod:45
license: Artistic-2.0
feature: node If
--- code
sub kind(@points) {
    if @points.all ~~ Positional:D {
        'vectors'
    } elsif @points.all ~~ Pair:D {
        'labelled'
    } else {
        'mixed'
    }
}
say kind([[1, 2], [3, 4]]);
say kind([a => [1, 2], b => [3, 4]]);
say kind([1, a => 2]);
--- expect
vectors
labelled
mixed

=== ctl-unless-block
from: Air 0.1.32 lib/Air/Base.rakumod:283
license: Artistic-2.0
feature: node Unless
--- code
my %instances;
sub instance($name) {
    my $instance = %instances{$name};
    unless $instance {
        $instance = %instances{$name} = "obj-$name";
        say "created $name";
    }
    $instance
}
say instance('a');
say instance('a');
say %instances.elems;
--- expect
created a
obj-a
obj-a
1

=== ctl-unless-postfix-counter
from: Air 0.1.32 lib/Air/Base.rakumod:385
license: Artistic-2.0
feature: node Unless
--- code
my class Site {
    has $!loaded = 0;
    has @.log;
    method defaults { @!log.push: 'defaults' }
    method load { self.defaults unless $!loaded++; self }
}
my $s = Site.new;
$s.load.load.load;
say @($s.log).elems;
say $s.log;
--- expect
1
[defaults]

=== ctl-orwith-chain
from: Cro::Core 0.8.10 lib/Cro/MessageWithBody.rakumod:28
license: Artistic-2.0
feature: node With
--- code
my class Msg {
    has $.body-byte-stream;
    has $.body;
    method stream {
        with $!body-byte-stream {
            "stream: $_"
        }
        orwith $!body {
            "body: $_"
        }
        else {
            'empty'
        }
    }
}
say Msg.new(body-byte-stream => 'bytes', body => 'b').stream;
say Msg.new(body => 0).stream;
say Msg.new.stream;
--- expect
stream: bytes
body: 0
empty

=== ctl-orwith-junction
from: Archive::Libarchive 0.0.17 lib/Archive/Libarchive.rakumod:304
license: Artistic-2.0
feature: node With
--- code
sub mode($format, @filters) {
    with ($format, @filters[0]).all {
        "format $format, filter @filters[0]"
    } orwith ($format, @filters[0]).any {
        'Both format and filter must be defined.'
    } else {
        'by extension'
    }
}
say mode('zip', ['gzip']);
say mode('zip', []);
say mode(Any, []);
--- expect
format zip, filter gzip
Both format and filter must be defined.
by extension

=== ctl-without-block
from: Archive::Libarchive 0.0.17 lib/Archive/Libarchive.rakumod:259
license: Artistic-2.0
feature: node Without
--- code
my class Archive {
    has $!archive;
    method open($name) {
        without $!archive {
            $!archive = "handle:$name";
            say 'opened';
        }
        $!archive
    }
}
my $a = Archive.new;
say $a.open('x.tar');
say $a.open('y.tar');
--- expect
opened
handle:x.tar
handle:x.tar

=== ctl-without-postfix-autoviv
from: Anolis 1.0.0 lib/Anolis.rakumod:101
license: Artistic-2.0
feature: node Without
--- code
my %areas;
for (1, 'a'), (2, 'b'), (1, 'c') -> ($y, $name) {
    %areas{$y} = [] without %areas{$y};
    %areas{$y}.push: $name;
}
say "$_: %areas{$_}.join(',')" for %areas.keys.sort;
--- expect
1: a,c
2: b

