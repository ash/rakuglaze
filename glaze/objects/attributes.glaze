=== obj-default-chain-in-role
from: Terminal::LineEditor 0.0.23 lib/Terminal/LineEditor/EditableBuffer.rakumod:372
license: Artistic-2.0
feature: node Role
--- code
my class Buffer { has $.cursors = 0; method add-cursor { "cursor-{++$!cursors}" } }
my role SingleLineTextInput {
    has $.buffer-class  = Buffer;
    has $.buffer        = $!buffer-class.new;
    has $.insert-cursor = $!buffer.add-cursor;
}
my class Input does SingleLineTextInput { }
my $in = Input.new;
say $in.insert-cursor;
say $in.buffer.cursors;
--- expect
cursor-1
1

=== obj-default-shares-object
from: Anolis 1.0.0 lib/Anolis.rakumod:28
license: Artistic-2.0
feature: node Class
--- code
my class Screen { has Int $.cursor-x is rw = 0 }
my class Term {
    has Screen $.norm-screen .= new;
    has Screen $.alt-screen .= new;
    has Screen $.screen = $!norm-screen;
}
my $t = Term.new;
$t.screen.cursor-x = 5;
say $t.norm-screen.cursor-x;
say $t.screen === $t.norm-screen;
say $t.alt-screen.cursor-x;
--- expect
5
True
0

=== obj-dot-equals-new-per-instance
from: BDD::Behave 0.9.5 lib/BDD/Behave/Runner.rakumod:86
license: Artistic-2.0
feature: method new
--- code
my class RunResult { has @.failures }
my class Runner {
    has RunResult $.result .= new;
}
my ($a, $b) = Runner.new, Runner.new;
$a.result.failures.push: 'boom';
say $a.result.failures.elems, ' ', $b.result.failures.elems;
say $a.result === $b.result;
--- expect
1 0
False

=== obj-lock-handles-protect
from: PDF::API6 0.2.10 lib/PDF/API6.rakumod:29
license: Artistic-2.0
feature: trait handles
--- code
my class Doc {
    has Lock $!lock handles<protect> .= new() ;
    has $.count = 0;
    method bump { self.protect: { $!count++ } }
}
my $d = Doc.new;
$d.bump for ^3;
say $d.count;
say $d.protect({ 'inside' });
--- expect
3
inside

=== obj-handles-private-list
from: Audio::Sndfile 0.0.16 lib/Audio/Sndfile.rakumod:485
license: Artistic-2.0
feature: trait handles
--- code
my class File {
    method close { 'closed' }
    method error-number { 0 }
    method sync { 'synced' }
}
my class Sndfile {
    has File $!file handles <close error-number sync>;
    submethod BUILD { $!file = File.new }
}
my $s = Sndfile.new;
say $s.close, ' ', $s.error-number, ' ', $s.sync;
say Sndfile.can('file').elems;
--- expect
closed 0 synced
0

