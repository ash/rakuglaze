=== sig-signature-returns-name
from: Duckie 0.0.12 lib/Duckie.rakumod:744
license: MIT
feature: method returns
--- code
my %RAKU2DUCKIE = Int => 'BIGINT', Str => 'VARCHAR', Num => 'DOUBLE';
sub register(&function) {
    my $name    = &function.name.subst('-', '_', :g);
    my @params  = &function.signature.params.map: { %RAKU2DUCKIE{.type.^name} // 'VARCHAR' };
    my $returns = %RAKU2DUCKIE{&function.signature.returns.^name} // 'VARCHAR';
    "{$name}({@params.join(', ')}) -> $returns"
}
sub add-one(Int $x --> Int) { $x + 1 }
sub greet(Str $who, $times) { }
say register(&add-one);
say register(&greet);
--- expect
add_one(BIGINT) -> BIGINT
greet(VARCHAR, VARCHAR) -> VARCHAR

