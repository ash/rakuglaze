=== sig-fail-message-defined
from: CSS::Selector::To::XPath 0.0.9 lib/CSS/Selector/To/XPath.rakumod:244
license: Artistic-2.0
feature: call fail
--- code
sub selector-to-xpath($css) {
    return "//$css" if $css ~~ /^ \w+ $/;
    fail "unable to parse CSS selector: $css";
}
say selector-to-xpath('div');
my $r = selector-to-xpath('>>');
say $r.defined;
say $r.exception.message;
say selector-to-xpath('p') // 'none';
say selector-to-xpath('!!') // 'none';
--- expect
//div
False
unable to parse CSS selector: >>
//p
none

=== sig-fail-exception-object
from: Concurrent::Stack 1.3 lib/Concurrent/Stack.rakumod:28
license: Artistic-2.0
feature: call fail
--- code
my class X::Stack::Empty is Exception {
    has $.operation;
    method message() { "Cannot $!operation from an empty stack" }
}
my class Stack {
    has @!items;
    method pop() {
        @!items ?? @!items.pop !! fail X::Stack::Empty.new(:operation<pop>)
    }
}
my $v = Stack.new.pop;
say $v.exception.^name;
say $v.exception.message;
Stack.new.pop.sink;
--- expect
X::Stack::Empty
Cannot pop from an empty stack
!! X::Stack::Empty

