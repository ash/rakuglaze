=== hash-duckmap-records
from: ML::NLPTemplateEngine 0.1.9 lib/ML/NLPTemplateEngine/Ingestion.rakumod:93
license: Artistic-2.0
feature: method duckmap
--- code
sub merge-param-records(Str $s) { $s.uc }
my %res = a => 'x', b => ['y', 'z'], c => { d => 'w' };
%res = %res.duckmap(&merge-param-records);
say %res<a>, ' ', %res<b>, ' ', %res<c><d>;
--- expect
X [Y Z] W
