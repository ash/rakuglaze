from: Crypt::LibGcrypt 1.0.11 lib/Crypt/LibGcrypt/Cipher.rakumod:101
license: Artistic-2.0
feature: samewith in multi method with Buf reallocate
--- code
my class Cipher {
    has $!keylen = 4;
    multi method pad(Str $key) { samewith Buf.new($key.ords).reallocate($!keylen) }
    multi method pad(Blob $key) { $key.reallocate($!keylen) }
}
say Cipher.new.pad('ab').list
--- expect
(97 98 0 0)

=== hk-12-role-smartmatch-self
from: PDF::Content 0.9.11 lib/PDF/Content/FontObj.rakumod:134
license: Artistic-2.0
feature: smartmatch against role type in method
--- code
my role SubsetFontLike { }
my class Font does SubsetFontLike { method is-subset { so (self ~~ SubsetFontLike) } }
my class Plain { method is-subset { so (self ~~ SubsetFontLike) } }
say Font.new.is-subset;
say Plain.new.is-subset
--- expect
True
False

