=== sig-named-alias-bool-default-true
from: Algorithm::KDimensionalTree 0.1.2 lib/Algorithm/KDimensionalTree.rakumod:137
license: Artistic-2.0
feature: param :alias(:$named)
--- code
my class Tree {
    has @.points = 1, 5, 9, 12;
    multi method k-nearest($point where * !~~ Iterable:D, UInt $k = 1, Bool :v(:$values) = True) {
        my @near = @!points.sort({ abs($_ - $point) }).head($k);
        $values ?? @near.List !! @near.map({ @!points.first($_, :k) }).List
    }
}
my $t = Tree.new;
say $t.k-nearest(6);
say $t.k-nearest(6, 2);
say $t.k-nearest(6, 2, :!v);
--- expect
(5)
(5 9)
(1 2)

=== sig-call-negated-flag
from: Algorithm::KDimensionalTree 0.1.2 lib/Algorithm/KDimensionalTree.rakumod:26
license: Artistic-2.0
feature: colonpair :!name
--- code
my class Tree {
    has $.distance-function;
    method get-distance-function($spec, :$warn = True) {
        $warn ?? "warned:$spec" !! "quiet:$spec"
    }
    submethod TWEAK() {
        $!distance-function = self.get-distance-function('euclid', :!warn);
    }
}
say Tree.new.distance-function;
say Tree.new.get-distance-function('cos');
--- expect
quiet:euclid
warned:cos

