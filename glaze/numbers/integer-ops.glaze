=== num-polymod-timezone
from: Email::Simple 2.1.4 lib/Email/Simple.rakumod:18
license: CC0-1.0
feature: method polymod
--- code
my sub percent02i($value) { $value < 10 ?? "0$value" !! $value.Str }
my sub timezone(Int() $timezone) {
    my str $tz =
      $timezone.abs.polymod(60,60).skip.reverse.map(&percent02i).join;
    $timezone < 0 ?? "-$tz" !! "+$tz"
}
say timezone(3600);
say timezone(-16200);
say timezone("19800");
--- expect
+0100
-0430
+0530

