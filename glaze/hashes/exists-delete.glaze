# Hash key tests and removal as modules write them: `:exists`, `:!exists`,
# `:delete` as a value, `:delete // default`, `with ...:delete`, adverb
# combinations on slices.

=== hash-exists-if
from: Abbreviations 2.2.3 lib/Abbreviations.rakumod:103
license: Artistic-2.0
feature: adverb :exists
--- code
my %ah = ab => 'abbrev', co => 'company';
for <ab xy co> -> $abbrev {
    if %ah{$abbrev}:exists {
        say "$abbrev -> %ah{$abbrev}";
    }
    else {
        say "$abbrev unknown";
    }
}
--- expect
ab -> abbrev
xy unknown
co -> company

=== hash-exists-undefined-value
from: CSS::Grammar 0.4.3 lib/CSS/Grammar/Test.rakumod:62
license: Artistic-2.0
feature: adverb :exists
--- code
my %expected = warnings => Any, ast => 'x';
if %expected<warnings>:exists && ! %expected<warnings>.defined {
    say 'warnings key present but undefined';
}
say %expected<missing>:exists;
say %expected<ast>.defined;
--- expect
warnings key present but undefined
False
True

=== hash-exists-die-unique
from: Air 0.1.32 lib/Air/Base.rakumod:604
license: Artistic-2.0
feature: adverb :exists
--- code
my %stubs;
sub add-stub($s) {
    die "Error: Stubs must be unique!" if %stubs{$s}:exists;
    %stubs{$s} = True;
}
add-stub('a');
add-stub('b');
say %stubs.keys.sort.join(',');
try add-stub('a');
say $!.message;
--- expect
a,b
Error: Stubs must be unique!

=== hash-not-exists
from: Graph 0.1.3 lib/Graph.rakumod:39
license: Artistic-2.0
feature: adverb :!exists
--- code
my %adjacency-map;
for <a b a c b> -> $v {
    if %adjacency-map{$v}:!exists {
        %adjacency-map{$v} = {};
        say "added $v";
    }
}
say %adjacency-map.elems;
--- expect
added a
added b
added c
3

=== hash-not-exists-postfix-if
from: BDD::Behave 0.9.5 lib/BDD/Behave/Watch.rakumod:45
license: Artistic-2.0
feature: adverb :!exists
--- code
my %env = PATH => '/bin';
%env<BEHAVE_DISABLE_CONFIG> = '1' if %env<BEHAVE_DISABLE_CONFIG>:!exists;
%env<PATH> = '/usr/bin' if %env<PATH>:!exists;
say %env.sort.map({ "{.key}={.value}" }).join(' ');
--- expect
BEHAVE_DISABLE_CONFIG=1 PATH=/bin

=== hash-exists-none-junction-slice
from: Red 0.2.5 lib/Red/Traits.rakumod:112
license: Artistic-2.0
feature: adverb :exists
--- code
my %column = references => 'x';
if %column<references>:exists && (%column{<model-name model-type>.none}:exists) {
    say 'bare reference';
}
%column<model-name> = 'M';
say so %column{<model-name model-type>.none}:exists;
--- expect
bare reference
False

=== hash-exists-in-grep
from: AttrX::Mooish 1.0.10 lib/AttrX/Mooish/Attribute.rakumod:238
license: Artistic-2.0
feature: adverb :exists
--- code
my %attrinit = foo-alias => 1, other => 2;
my $base-name = 'foo';
my @init-args = <foo-alias f>;
with ($base-name, |@init-args).grep( { %attrinit{$_}:exists } ).head {
    say "init via $_";
}
--- expect
init via foo-alias

=== hash-exists-or-chain
from: ORM::Factory 0.9.1 lib/ORM/Factory.rakumod:178
license: Artistic-2.0
feature: adverb :exists
--- code
my class Factory {
    has %!overrides = name => 'Bob';
    has @!effective-attributes = 'age';
    method has-value(Str:D $name --> Bool) {
        %!overrides{$name}:exists ||
        @!effective-attributes.first(* eq $name).defined;
    }
}
my $f = Factory.new;
say "$_: {$f.has-value($_)}" for <name age email>;
--- expect
name: True
age: True
email: False

=== hash-exists-scalar-container
from: Date::Calendar::Strftime 0.1.1 lib/Date/Calendar/Strftime.rakumod:168
license: Artistic-2.0
feature: adverb :exists
--- code
my $res = 'default';
my $fmt = { string => 'custom' };
if $fmt<string>:exists { $res = $fmt<string> }
say $res;
say $fmt<other>:exists;
--- expect
custom
False

