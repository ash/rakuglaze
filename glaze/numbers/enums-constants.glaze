=== num-constant-hash-dow
from: Date::Utils 0.7.0 lib/Date/Utils.rakumod:7
license: Artistic-2.0
feature: decl constant
--- code
my subset DoW of Int where { 0 < $_ < 8 }
my constant %dow-hash = %(
    1 => "Monday"    ,
    2 => "Tuesday"   ,
    7 => "Sunday"    ,
);
sub name(DoW $d) { %dow-hash{$d} // '?' }
say name(1), ' ', name(7), ' ', name(3);
say name(8);
--- expect
Monday Sunday ?
!! X::TypeCheck::Binding::Parameter

=== num-constant-svals-types
from: CBOR::Simple 0.1.4 lib/CBOR/Simple.rakumod:735
license: Artistic-2.0
feature: decl constant
--- code
my constant %svals = 20 => False, 21 => True, 22 => Any, 23 => Mu;
for 20..23 -> $k {
    my $v := %svals{$k};
    say "$k {$v.^name} {$v.defined}";
}
--- expect
20 Bool True
21 Bool True
22 Any False
23 Mu False

=== num-constant-sigilless-pow
from: Digest 1.1.0 lib/Digest/MD5.rakumod:21
license: Artistic-2.0
feature: infix ∘
--- code
my constant MASK = 2**32;
my constant K = blob32.new: map &floor ∘ * * MASK ∘ &abs ∘ &sin ∘ * + 1, ^4;
