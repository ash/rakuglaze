# splice in its many arities, :delete / :exists / :v on array elements.

=== list-splice-remove-front
from: Algorithm::Diff 0.0.5 lib/Algorithm/Diff.rakumod:422
license: Artistic-2.0
feature: method splice
--- code
my @cdif = 1, 2, 3, 4, 5;
my @gone = @cdif.splice( 0, 2 );
say @gone;
say @cdif;
--- expect
[1 2]
[3 4 5]

=== list-splice-insert
from: Array::Sorted::Util 0.0.11 lib/Array/Sorted/Util.rakumod:178
license: Artistic-2.0
feature: method splice
--- code
my @a = 1, 3, 5;
my $pos = 2;
my \value = 4;
@a.splice($pos, 0, value);
say @a;
--- expect
[1 3 4 5]

=== list-splice-whatever-to-end
from: BDD::Behave 0.9.5 lib/BDD/Behave/DSL.rakumod:577
license: Artistic-2.0
feature: method splice
--- code
my @failures = <f1 f2 f3 f4>;
my $watermark = 1;
say @failures.splice($watermark, *);
say @failures;
--- expect
[f2 f3 f4]
[f1]

=== list-splice-drain-join
from: Bailador 0.0.19 lib/Bailador/Test.pm:16
license: MIT
feature: method splice
--- code
my @buf = 'he', 'llo';
sub wipe() { @buf.splice(0, @buf.elems).join: '' }
say wipe();
say @buf.elems;
--- expect
hello
0

