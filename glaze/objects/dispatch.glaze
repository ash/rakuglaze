=== obj-multi-class-method-plus
from: App::RaCoCo 2.0.1 lib/App/Racoco/Report/Data.rakumod:39
license: Artistic-2.0
feature: decl multi
--- code
my class Data {
    has $.lines;
    multi method plus(::?CLASS:U: ::?CLASS:D $data, $ --> ::?CLASS) { $data }
    multi method plus(::?CLASS:D: ::?CLASS:D $data, $ --> ::?CLASS) {
        Data.new(lines => $!lines + $data.lines)
    }
}
say Data.plus(Data.new(lines => 3), Nil).lines;
