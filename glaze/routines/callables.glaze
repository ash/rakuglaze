=== sig-assuming-method-object-self
from: Math::DistanceFunctions 0.1.4 lib/Math/DistanceFunctionish.rakumod:55
license: Artistic-2.0
feature: method assuming
--- code
my %distance-functions = euclid => 'euclidean', city => 'manhattan';
my class Dist {
    method euclidean(@a, @b) { sqrt [+] (@a Z- @b) X** 2 }
    method manhattan(@a, @b) { [+] (@a Z- @b)».abs }
    method get-distance-function($spec) {
        return self.^lookup(%distance-functions{$spec}).assuming(self);
    }
}
my &d = Dist.new.get-distance-function('city');
say d([1, 2], [4, 6]);
say Dist.new.get-distance-function('euclid')([0, 0], [3, 4]);
--- expect
7
5

=== sig-signature-one-positional
from: Crane 0.1.2 lib/Crane/Utils.rakumod:10
license: Unlicense
feature: method signature
--- code
sub is-valid-callable-signature(&c --> Bool:D)
{
    &c.signature.params.elems == 1
        && &c.signature.params.grep({ .positional }).elems == 1;
}
say is-valid-callable-signature(-> $x { $x });
say is-valid-callable-signature(-> $x, $y { $x });
say is-valid-callable-signature(-> :$x { $x });
say is-valid-callable-signature({ $_ });
--- expect
True
False
False
True

