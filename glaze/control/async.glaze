(4 6)

=== ctl-supplier-tap-emit
from: Crust 0.0.1 lib/HTTP/Message/P6W.pm6:11
license: Artistic-2.0
feature: method tap
--- code
my $supplier = Supplier.new;
my @seen;
my $tap = $supplier.Supply.tap: -> $v { @seen.push: "got $v" }, done => { @seen.push: 'done' };
$supplier.emit($_) for 1, 2;
$supplier.done;
say @seen;
--- expect
[got 1 got 2 done]
