=== sig-temp-closure-variable
from: Data::Dump 0.0.18 lib/Data/Dump.rakumod:89
license: Artistic-2.0
feature: prefix temp
--- code
our $colorizor = sub (Str $s) { "<$s>" };
sub dump($obj, :$color = True) {
    temp $colorizor = sub (Str $s) { '' } unless $color;
    $colorizor('k') ~ $obj
}
say dump('v');
say dump('v', :!color);
say $colorizor('again');
--- expect
<k>v
v
<again>
