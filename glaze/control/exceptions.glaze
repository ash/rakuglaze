=== ctl-try-block-with-catch-when
from: Bailador 0.0.19 lib/Bailador/Request.pm:20
license: MIT
feature: phaser CATCH
--- code
sub unescape($s, :$no_utf8) { $no_utf8 ?? "latin:$s" !! ($s.contains('%FF') ?? die('bad utf8') !! "utf8:$s") }
sub uri_unescape($uri) {
    my $decoded;
    try {
        $decoded = unescape($uri);
        CATCH {
            when X::AdHoc {
                $decoded = unescape($uri, :no_utf8);
            }
        }
    }
    $decoded
}
say uri_unescape('a%20b');
say uri_unescape('a%FF');
--- expect
utf8:a%20b
latin:a%FF

=== ctl-catch-when-junction-types
from: CodeUnit 0.0.11 lib/CodeUnit.rakumod:59
license: Artistic-2.0
feature: phaser CATCH
--- code
my class X::Missing is Exception { method message { 'missing' } }
my class X::FailGoal is Exception { method message { 'goal' } }
sub run($what) {
    CATCH {
        when X::Missing | X::FailGoal { return "more input ({.message})" }
        when X::AdHoc { return "adhoc: {.message}" }
        default { return "other: {.^name}" }
    }
    $what()
}
say run({ X::Missing.new.throw });
say run({ X::FailGoal.new.throw });
say run({ die 'plain' });
say run({ X::NYI.new(feature => q[f]).throw });
say run({ 'fine' });
--- expect
more input (missing)
more input (goal)
adhoc: plain
other: X::NYI
fine

=== ctl-catch-when-regex-message
from: CBOR::Simple 0.1.4 lib/CBOR/Simple.rakumod:591
license: Artistic-2.0
feature: phaser CATCH
--- code
sub decode($blob) {
    CATCH {
        when /^ 'read_buf out of bounds' / {
            return 'Early end of input';
        }
        default { .rethrow }
    }
    die 'read_buf out of bounds at 3' if $blob < 0;
    die 'corrupt' if $blob == 0;
    "decoded $blob"
}
say decode(5);
say decode(-1);
say decode(0);
--- expect
decoded 5
Early end of input
!! X::AdHoc

=== ctl-catch-default-resume
from: LogP6 1.6.4 lib/LogP6.rakumod:117
license: Artistic-2.0
feature: method resume
--- code
my @errors;
sub logp6-error($e) { @errors.push: $e.message }
my @done;
for <a b c> {
    @done.push: $_;
    warn "skip $_" if $_ eq 'b';
    CATCH { default { logp6-error($_); .resume } }
    CONTROL { when CX::Warn { @errors.push: "warned: {.message}"; .resume } }
}
sub cfg { my $x = die 'broken writer'; "after die, got {$x.^name}" }
say do { CATCH { default { logp6-error($_); .resume } }; cfg() };
say @done;
.say for @errors;
--- expect
after die, got Any
[a b c]
warned: skip b
broken writer

=== ctl-control-warn-resume
from: Gnome::N 0.1.54 lib/Gnome/N/GObjectSupport.rakumod:127
license: Artistic-2.0
feature: phaser CONTROL
--- code
my @seen;
sub convert($v) {
    CONTROL { when CX::Warn {  @seen.push: .message; .resume; } }
    warn "deprecated value $v" if $v < 0;
    $v.abs
}
say convert(-3);
say convert(4);
say @seen;
--- expect
3
4
[deprecated value -3]

=== ctl-control-keep-warnings
from: CodeUnit 0.0.11 lib/CodeUnit.rakumod:104
license: Artistic-2.0
feature: phaser CONTROL
--- code
my class Unit {
    has @.warnings;
    has $.keep-warnings = True;
    method eval(&code) {
        CONTROL {
            when CX::Warn {
                $!keep-warnings ?? @!warnings.push($_) !! .message.say;
                .resume;
            }
        }
        code()
    }
}
my $u = Unit.new;
say $u.eval({ warn 'first'; warn 'second'; 'result' });
say $u.warnings.map(*.message);
say $u.warnings[0].^name;
--- expect
result
(first second)
CX::Warn

=== ctl-quietly-block
from: Lingua::NumericWordForms 0.6.2 lib/Lingua/NumericWordForms/NumericWordForms.rakumod:211
license: Artistic-2.0
feature: prefix quietly
--- code
my %forms = english => { three => 3 }, french => { trois => 3 };
sub from-word($spec, :$lang) {
    warn "no $lang" unless %forms{$lang}{$spec}:exists;
    %forms{$lang}{$spec}
}
my $res;
for <english french> -> $l {
    quietly {
        $res = from-word('trois', lang => $l);
    }
    last if $res.defined;
}
say $res;
--- expect
3

