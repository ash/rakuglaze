=== hash-delete-then-call
from: ORM::ActiveRecord 0.9.4 lib/ORM/ActiveRecord/Adapter/Sql/Exec.rakumod:106
license: Artistic-2.0
feature: adverb :delete
--- code
my class Stmt { has $.sql; method dispose { say "disposed $!sql" } }
my %stmt-cache = 'SELECT 1' => Stmt.new(sql => 'SELECT 1');
my $sql = 'SELECT 1';
(%stmt-cache{$sql}:delete).dispose;
say %stmt-cache.elems;
--- expect
