=== ctl-exception-to-failure
from: Concurrent::Stack 1.3 lib/Concurrent/Stack.rakumod:40
license: Artistic-2.0
feature: method Failure
--- code
my class X::Empty is Exception {
    has $.operation;
    method message { "Cannot $!operation an empty stack" }
}
my class Stack {
    has @!items;
    method push($v) { @!items.push: $v; self }
    method peek {
        @!items
          ?? @!items.tail
          !! X::Empty.new(:operation<peek>).Failure
    }
}
my $s = Stack.new;
with $s.peek { say "top $_" } else { say "empty: {.exception.message}" }
$s.push(7);
with $s.peek { say "top $_" } else { say 'empty' }
--- expect
empty: Cannot peek an empty stack
top 7

