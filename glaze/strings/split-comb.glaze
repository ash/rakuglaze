=== str-split-blank-line-separator
from: Cro::HTTP 0.8.13 lib/Cro/HTTP/BodyParsers.rakumod:172
license: Artistic-2.0
feature: method split
--- code
my $part = "Content-Type: text/plain\r\nX-A: 1\r\n\r\nbody text\r\n\r\nmore";
my ($header, $body-str) = $part.split("\r\n\r\n", 2);
say $header.lines.elems;
say $body-str.raku;
--- expect
2
"body text\r\n\r\nmore"

=== str-split-regex-char-class
from: Bailador 0.0.19 lib/Bailador/Request.pm:141
license: MIT
feature: method split
--- code
my $cookies = 'a=1; b=2, c=3';
for $cookies.split(/<[;,]>\s/) -> $cookie {
    my ($name, $value) = $cookie.trim.split(/\s*\=\s*/, 2);
    say "$name -> $value";
}
--- expect
a -> 1
b -> 2
c -> 3

