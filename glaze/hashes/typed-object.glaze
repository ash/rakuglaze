=== hash-for-assign-nested-key
from: Identity::Utils 0.0.29 lib/Identity/Utils.rakumod:249
license: Artistic-2.0
feature: stmt for
--- code
my @identities = 'Foo:auth<zef:a>', 'Foo:auth<zef:b>', 'Bar:auth<zef:a>';
sub short-name($id) { $id.split(':')[0] }
sub auth($id) { $id ~~ / 'auth<' (<-[>]>+) / ?? ~$0 !! '' }
my %by-short-name;
%by-short-name{short-name $_}{auth $_} = $_ for @identities;
say %by-short-name<Foo>.keys.sort;
say %by-short-name<Bar><zef:a>;
--- expect
(zef:a zef:b)
Bar:auth<zef:a>

