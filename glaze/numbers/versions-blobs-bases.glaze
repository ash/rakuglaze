=== num-base-fixed-digits
from: Data::MessagePack 0.1.4 lib/Data/MessagePack/Packer.rakumod:119
license: Artistic-2.0
feature: method base
--- code
for 0.375, 0.8125 -> $frac-shifted {
    my $grs = (($frac-shifted - $frac-shifted.Int) * 2**3).base(2).Int;
    say "$frac-shifted $grs";
}
