from: Bailador 0.0.19 lib/Bailador/Context.pm:12
license: MIT
feature: trait is rw
--- code
my class Context {
    has %!env;
    method env is rw {
        Proxy.new(
            FETCH => -> $ { %!env },
            STORE => -> $, %new { %!env = %new.map({ .key.uc => .value }) },
        )
    }
}
my $c = Context.new;
$c.env = { path => '/x' };
say $c.env;
--- expect
{PATH => /x}

