=== ctl-loop-bare-last-if
from: BDD::Behave 0.9.5 lib/BDD/Behave/Bisect.rakumod:108
license: Artistic-2.0
feature: node Loop
--- code
my $failing = 6;
my @current = 1..8;
my $steps = 0;
loop {
  last if @current.elems <= 1;
  my $mid = @current.elems div 2;
  my @left = @current[0 ..^ $mid].List;
  my @right = @current[$mid .. *].List;
  @current = @right.first(* == $failing).defined ?? @right !! @left;
  $steps++;
}
say "@current[] after $steps steps";
--- expect
6 after 3 steps

