# Typed hashes, object hashes (non-Str keys), `is default` on hashes, and a
# hash in boolean, numeric and smartmatch context.

=== hash-object-keyed-by-type
from: Auth::SCRAM::Async 0.0.1 lib/Auth/SCRAM/Async.rakumod:19
license: Artistic-2.0
feature: object hash
--- code
my role Digest {}
my class SHA1 does Digest {}
my class SHA256 does Digest {}
my %info-for{Digest} = (
    (SHA1)   => { :hash-size(20) },
    (SHA256) => { :hash-size(32) },
);
say %info-for{SHA256}<hash-size>;
say %info-for.keys.map(*.^name).sort;
say %info-for{SHA1}:exists;
--- expect
32
(SHA1 SHA256)
True

