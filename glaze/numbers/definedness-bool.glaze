# Definedness and truth as modules test them: .defined, .DEFINITE,
# :D/:U smartmatch, Nil checks, === on type objects, prefix ? / ! / so /
# not, .so, .Bool.

=== num-defined-ternary-default
from: Apache::LogFormat * lib/Apache/LogFormat/Compiler.pm6:44
license: Artistic-2.0
feature: method defined
--- code
for 1.75, Nil, 0 -> $reqtime {
    say ($reqtime.defined ?? $reqtime.Int !! '-');
}
--- expect
1
-
0

=== num-not-defined-default-step
from: Algorithm::Diff 0.0.5 lib/Algorithm/Diff.rakumod:444
license: Artistic-2.0
feature: method defined
--- code
sub advance($pos, $steps is copy = Nil) {
    $steps = 1 if !$steps.defined;
    $pos + $steps
}
say advance(10);
say advance(10, 0);
say advance(10, 5);
--- expect
11
10
15

=== num-defined-skip-zero-key
from: CSS::Grammar 0.4.3 lib/CSS/Grammar/AST.rakumod:51
license: Artistic-2.0
feature: method defined
--- code
my %ast = '0' => 'x', color => 'red', margin => Any, width => 0;
my @kept;
for %ast.sort(*.key) -> (:$key, :$value) {
    next if $key eq '0' || !$value.defined;
    @kept.push: "$key=$value";
}
say @kept.join(' ');
--- expect
color=red width=0

=== num-defined-or-match
from: CSS::Stylesheet 0.1.5 lib/CSS/Stylesheet.rakumod:83
license: Artistic-2.0
feature: method defined
--- code
my class Rule {
    has $.media;
    method applies($query) { !$!media.defined || !$query.defined || $query ~~ $!media }
}
say Rule.new.applies('print');
say Rule.new(media => 'screen').applies(Str);
say Rule.new(media => 'screen').applies('screen');
say Rule.new(media => 'screen').applies('print');
--- expect
True
True
True
False

