--- code
for 1e0, -2.5e0, 0e0 -> $num {
    my $uint = buf8.write-num32(0, $num).read-uint32(0);
    my $sign = ($uint +& 0x80000000) +> 16;
    my $exp  =  $uint +& 0x7F800000;
    say "{$uint.base(16)} $sign {$exp +> 23}";
}
--- expect
