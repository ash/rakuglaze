# Slurpy parameters, captures and flattening into calls, as modules write them:
# `*@`/`*%`, `+@`, `**@`, `is raw` slurpies, `|c` captures, `\(...)` literals,
# `|@args`/`|%opts` at the call site and the implicit `%_` of methods.

=== sig-slurpy-pos-and-named-forward
from: Air::Plugin::Hilite 0.0.10 lib/Air/Plugin/Hilite.rakumod:80
license: Artistic-2.0
feature: param *@ slurpy
--- code
my class Hilite {
    has @.lines;
    has $.lang;
    method new(*@lines, *%h) { self.bless(:@lines, |%h) }
}
sub hilite(*@a, *%h) { Hilite.new( |@a, |%h ) };
my $h = hilite('a = 1', 'b = 2', :lang<raku>);
say $h.lines.elems;
say $h.lang;
--- expect
2
raku

=== sig-slurpy-say-forward
from: App::GPTrixie 0.29 lib/GPT/DumbGenerator.pm6:8
license: Artistic-2.0
feature: param *@ slurpy
--- code
my $debug = True;
sub	debug(*@stuff) {
    say(|@stuff) if $debug;
}
debug('found ', 3, ' types');
debug();
$debug = False;
debug('hidden');
say 'done';
--- expect
found 3 types

done

=== sig-slurpy-named-only
from: BDD::Behave 0.9.5 lib/BDD/Behave.rakumod:301
license: Artistic-2.0
feature: param *% slurpy
--- code
sub hash-including(*%pairs) {
    -> %h { so all(%pairs.map({ %h{.key}:exists && %h{.key} eqv .value })) }
}
my &m = hash-including(a => 1, b => 'x');
