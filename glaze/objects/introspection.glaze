=== obj-methods-grep-trait-role
from: Cromponent 0.0.13 lib/Cromponent/MetaCromponentRole.rakumod:105
license: Artistic-2.0
feature: method methods
--- code
my role Accessible { method is-accessible { True } }
multi trait_mod:<is>(Method $m, :$accessible!) { $m does Accessible }
my class Component {
    method edit is accessible { 'edit' }
    method delete is accessible { 'delete' }
    method internal { 'internal' }
}
my $component = Component.new;
for $component.^methods.grep(*.?is-accessible).sort(*.name) -> $meth {
    say $meth.name, ' -> ', $meth($component);
}
--- expect
delete -> delete
edit -> edit

