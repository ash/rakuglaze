=== obj-built-false-ignored
from: IRC::Client 4.0.15 lib/IRC/Client.rakumod:344
license: Artistic-2.0
feature: trait is built
--- code
my class Server { has $.host }
my class Client {
    has Server   %.servers     is built(False);
    method add($name, $host) { %!servers{$name} = Server.new(:$host) }
}
my $c = Client.new(servers => { x => Server.new(host => 'nope') });
say $c.servers.elems;
$c.add('libera', 'irc.libera.chat');
say $c.servers<libera>.host;
--- expect
0
irc.libera.chat

=== obj-built-false-rw-enum
from: CodeUnit 0.0.11 lib/CodeUnit.rakumod:22
license: Artistic-2.0
feature: trait is built
--- code
my enum Status <OK MORE-INPUT CONTROL>;
my class CodeUnit {
    has Status $.state is rw is built(False) = OK;
}
my $cu = CodeUnit.new(state => CONTROL);
say $cu.state;
$cu.state = MORE-INPUT;
say $cu.state, ' ', $cu.state.value;
--- expect
OK
MORE-INPUT 1

=== obj-built-false-handles-tweak
from: Code::Coverage 0.0.9 lib/Code/Coverage.rakumod:13
license: Artistic-2.0
feature: trait is built
--- code
my class Coverage {
    has @.targets;
    has %.coverables          is built(False) handles <keys>;
    method TWEAK() {
        %!coverables = @!targets.map: { .uc => .chars }
    }
}
my $c = Coverage.new(targets => <foo ba>);
say $c.keys.sort;
say $c.coverables<FOO>;
--- expect
(BA FOO)
3

=== obj-built-required-private
from: App::RaCoCo 2.0.1 lib/App/Racoco/Configuration.rakumod:102
license: Artistic-2.0
feature: trait is required
--- code
my class Key {
    has $!get is built is required;
    method value(%h) { $!get(%h) }
}
my $k = Key.new(get => -> %h { %h<lib> // 'lib' });
say $k.value({ lib => 'src' });
say $k.value({});
Key.new;
--- expect
src
lib
!! X::Attribute::Required

=== obj-callable-private-attr
from: Apache::LogFormat * lib/Apache/LogFormat/Formatter.pm6:5
license: Artistic-2.0
feature: node Class
--- code
my class Formatter {
    has &!callback;
    method new(&callback) { self.bless(:&callback) }
    submethod BUILD(:&!callback) { }
    method format(*@args) { &!callback(|@args) }
}
my $f = Formatter.new(-> $a, $b { "$a - $b" });
say $f.format('GET', 200);
--- expect
GET - 200

=== obj-callable-public-attr
from: Cache::Async 0.3.4 lib/Cache/Async.rakumod:145
license: Artistic-2.0
feature: node Class
--- code
my class Cache {
    has &.producer;
    has Int $.max-size = 1024;
    method get($k) { &!producer($k) }
}
my $c = Cache.new(max-size => 10, producer => sub ($k) { $k x 2 });
say $c.get('ab');
say $c.producer.('z');
say $c.producer.arity;
--- expect
abab
zz
1

