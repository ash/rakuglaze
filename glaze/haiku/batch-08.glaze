=== hk-08-supexpr-ternary-any
from: LaTeX::Grammar 0.0.5 lib/LaTeX/Actions/MathJSON.rakumod:366
license: Artistic-2.0
feature: ?? !! on a capture
--- code
my grammar Sup {
    token TOP { <base> [ '^' <supexpr> ]? }
    token base { \w }
    token supexpr { \d+ }
}
my class SupActions {
    method supexpr($/) { make $/.Str.Int }
    method TOP($/) {
        my $upper = $<supexpr> ?? $<supexpr>.made !! Any;
        make $upper
    }
}
say Sup.parse('x^2', actions => SupActions.new).made;
say Sup.parse('x', actions => SupActions.new).made.raku;
--- expect
2
Any

