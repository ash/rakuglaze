=== obj-private-method-other-instance
from: Math::SparseMatrix 0.0.15 lib/Math/SparseMatrix/CSR.rakumod:703
license: Artistic-2.0
feature: node Method
--- code
my class CSR {
    has %!rows;
    method !row-map($i) { %!rows{$i} // {} }
    method set($i, $j, $v) { %!rows{$i}{$j} = $v; self }
    method dot-row(CSR $other, $i) {
        my %row-a = self!row-map($i);
        my %row-b = $other!row-map($i);
        [+] %row-a.keys.map({ %row-a{$_} * (%row-b{$_} // 0) })
    }
}
my $a = CSR.new.set(0, 0, 2).set(0, 1, 3);
my $b = CSR.new.set(0, 1, 5);
say $a.dot-row($b, 0);
--- expect
15

=== obj-trusts-other-class
from: Intl::CLDR 0.7.6 lib/Intl/CLDR/Types/CompoundUnitSet.rakumod:22
license: Artistic-2.0
feature: node Class
--- code
my class Selector { ... }
my class CompoundUnitSet {
    trusts Selector;
    has %!units = (per => '{0}/{1}', times => '{0}⋅{1}');
    method !unit($k) { %!units{$k} }
}
my class Selector {
    method pick(CompoundUnitSet $s, $k) { $s!CompoundUnitSet::unit($k) }
}
say Selector.pick(CompoundUnitSet.new, 'per');
say Selector.pick(CompoundUnitSet.new, 'times');
--- expect
{0}/{1}
{0}⋅{1}

=== obj-qualified-parent-method
from: Data::Translators 0.1.18 lib/Data/Translators/R.rakumod:19
license: Artistic-2.0
feature: node Method
--- code
my class HTML {
    method convert-json-node($x) { $x ~~ Whatever ?? '(Whatever)' !! "<td>{$x}</td>" }
}
my class R is HTML {
    method convert-json-node($x) {
        return self.HTML::convert-json-node($x).subst(/ ^ '(Whatever)' $/, {"\"{$/.Str}\""});
    }
}
say R.new.convert-json-node(*);
say R.new.convert-json-node(5);
--- expect
"(Whatever)"
<td>5</td>

