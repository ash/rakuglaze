my sub nexts(\haystack, \needle, :&cmp) {
    my &c = &cmp // &infix:<cmp>;
    haystack.first({ c($_, needle) == More }, :k)
}
my @h = <apple banana cherry>;
say nexts(@h, 'b');
say nexts(@h, 'b', :cmp({ $^a.chars <=> $^b.chars }));
--- expect
1
0

