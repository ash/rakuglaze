=== ctl-promise-then-result
from: CPAN::Uploader::Tiny 0.1.0 lib/CPAN/Uploader/Tiny.rakumod:89
license: Artistic-2.0
feature: method then
--- code
my &cb = -> $r { "callback got $r" };
sub post($url) { start { "posted $url" } }
my $p = post('/upload').then: -> $p { &cb($p.result) };
say await $p;
my $f = start { die 'refused' };
say (await $f.then(-> $p { $p.status ~ ': ' ~ $p.cause.message }));
--- expect
callback got posted /upload
Broken: refused

=== ctl-promise-vow-keep
from: DBIish::Pool 1.1.0 lib/DBIish/Pool.rakumod:182
license: CC0-1.0
feature: method vow
--- code
my $connection-promise = Promise.new;
my $v = $connection-promise.vow();
say $connection-promise.status;
$v.keep('dbh#1');
say $connection-promise.status;
say await $connection-promise;
try $connection-promise.keep('again');
say $!.^name;
--- expect
Planned
Kept
dbh#1
X::Promise::Vowed

=== ctl-lock-protect-counter
from: Cro::Core 0.8.10 lib/Cro.rakumod:489
license: Artistic-2.0
feature: method protect
--- code
my $next-label-lock = Lock.new;
my $next-label = 0;
sub label { $next-label-lock.protect: { $next-label++ } }
my @labels = await (^8).map: { start { label() } };
say @labels.sort;
say $next-label;
--- expect
(0 1 2 3 4 5 6 7)
8

=== ctl-supply-from-list-flat
from: HTTP::Server::Ogre 0.0.4 lib/HTTP/Server/Ogre/HTTP2/ResponseSerializer.pm6:39
license: Artistic-2.0
feature: method from-list
--- code
my $body = (<a b>, <c>);
my $body-supply = Supply.from-list($body.flat);
my @got;
$body-supply.tap: -> $v { @got.push: $v };
say @got;
say Supply.from-list(1..3).map(* * 2).grep(* > 2).list;
