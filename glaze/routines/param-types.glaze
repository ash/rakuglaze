=== sig-is-copy-positional
from: Algorithm::Diff 0.0.5 lib/Algorithm/Diff.rakumod:42
license: Artistic-2.0
feature: trait is copy
--- code
our sub _replaceNextLargerWith( @array, $aValue, $high is copy ) {
    $high ||= +@array-1;
    my $low = 0;
    while $low <= $high {
        my $index = ($high + $low) div 2;
        if @array[$index] < $aValue { $low = $index + 1 } else { $high = $index - 1 }
    }
    @array[$low] = $aValue;
    $low
}
my @t = 1, 4, 9;
say _replaceNextLargerWith(@t, 5, 0);
say @t;
--- expect
2
[1 4 5]

