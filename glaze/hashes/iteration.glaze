=== hash-grep-sort-negated-block
from: Data::Summarizers 0.2.6 lib/Data/Summarizers/ParetoPrincipleStatistic.rakumod:48
license: Artistic-2.0
feature: method grep
--- code
my %hvec = a => 5, b => 'n/a', c => 9, d => 1;
my @tally = %hvec.grep({ $_.value ~~ Numeric }).sort({ -$_.value });
say @tally.map(*.key);
say @tally>>.value;
--- expect
(c a d)
[9 5 1]

=== hash-sort-dollar-a-b-value
from: Stats 0.0.6 lib/Stats.pm6:136
license: Artistic-2.0
feature: method sort
--- code
my $x = (10, 30, 20).List;
my $mean = 20;
my $sd = 10;
my @z = $x.pairs.map({$_.key => ($_.key - $mean) / $sd }).sort({$^a.value <=> $^b.value}).list;
say @z.map(*.key);
--- expect
(0 1 2)

