=== sig-plus-slurpy-is-raw-method
from: Array::Agnostic 0.0.18 lib/Array/Agnostic.rakumod:123
license: Artistic-2.0
feature: param +@ slurpy
--- code
my role Appendable {
    has @!store;
    method append(::?ROLE:D: +@values is raw) { @!store.append(@values); self }
    method all() { @!store.join(',') }
}
my class Bag2 does Appendable { }
my $b = Bag2.new;
$b.append(1, 2).append([3, 4]).append(5);
say $b.all;
--- expect
1,2,3,4,5

=== sig-double-star-keeps-structure
from: BDD::Behave 0.9.5 lib/BDD/Behave/Expectation.rakumod:474
license: Artistic-2.0
feature: param **@ slurpy
--- code
my class Expect {
    has @.got;
    method include(**@items, *%pairs) {
        my $ok = so all(@items.map({ $_ (elem) @!got }));
        $ok && so all(%pairs.map({ .key (elem) @!got }))
    }
}
my $e = Expect.new(got => ['a', 'b', 'c']);
say $e.include('a', 'c');
say $e.include('a', 'z');
say $e.include('a', :b);
say $e.include(['a', 'b']);
--- expect
True
False
True
False

=== sig-double-star-is-raw-join
from: Bailador 0.0.19 lib/Bailador/Test.pm:24
license: MIT
feature: param **@ slurpy
--- code
my class Out {
    has $.buf = '';
    method !add-string($s) { $!buf ~= $s }
    multi method print(**@args is raw) { self!add-string( join '', @args.map: *.Str ) }
}
my $o = Out.new;
$o.print('a', 1, 'b');
$o.print([1, 2], 3);
say $o.buf;
--- expect
a1b1 23

