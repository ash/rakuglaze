=== sig-named-short-alias
from: Color::Names 2.0.0 lib/Color/Names.rakumod:3
license: BSD-2-Clause
feature: param :alias(:$named)
--- code
sub find-color ( $colors, Str $needle, :ex(:$exact) ) {
    $colors.grep({ $exact ?? $_ eq $needle !! .contains($needle) }).List
}
my @c = <red darkred blue>;
say find-color(@c, 'red');
say find-color(@c, 'red', :ex);
say find-color(@c, 'red', :exact);
--- expect
(red darkred)
(red)
(red)

