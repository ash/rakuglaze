# Hash subscripts as modules write them: slices, nested autovivification,
# `//=` caches, counters, `.push` onto an element, slice adverbs.

=== hash-slice-angle-destructure
from: Air 0.1.32 lib/Air/Form.rakumod:362
license: Artistic-2.0
feature: postcircumfix <>
--- code
my %ch = question => 'What is 6*7?', token => 'abc', extra => 1;
my ($q, $t) = %ch<question token>;
say $q;
say $t;
--- expect
What is 6*7?
abc

