=== list-list-cached-twice
from: BDD::Behave 0.9.5 lib/BDD/Behave/Bisect.rakumod:27
license: Artistic-2.0
feature: method cache
--- code
my %initial = executed => (1..3).map(* * 2);
my @executed = %initial<executed>.list.cache;
say @executed;
my $s = (1..3).map(* + 1);
my $c = $s.cache;
say $c.elems, ' ', $c.sum;
--- expect
[2 4 6]
3 9

