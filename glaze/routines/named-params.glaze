=== sig-named-key-value-pair-call
from: JSON::RPC 1.0.6 lib/JSON/RPC/Client.rakumod:33
license: Artistic-2.0
feature: method assuming
--- code
sub transport(Str :$uri!, Str :$body = '{}') { "POST $uri $body" }
my class Client {
    has $!transport;
    submethod BUILD(Str :$uri) {
        $!transport = &transport.assuming( uri => $uri );
    }
    method call($body) { $!transport(:$body) }
}
my $c = Client.new(uri => 'http://rpc');
say $c.call('{"id":1}');
--- expect
POST http://rpc {"id":1}
