# Named parameters as modules declare and pass them: defaults, `!`, aliases,
# `:$x?`, `is copy`, typed and callable nameds, and the `:$x`/`:!x`/`:&f`
# colon-pair shorthands at the call site.

=== sig-named-default-enum
from: Abbreviations 2.2.3 lib/Abbreviations.rakumod:218
license: Artistic-2.0
feature: param :$named
--- code
my enum SortType <LS SL AH>;
sub sort-list(@List, :$type = LS, :$reverse) {
    my @s = $type == LS ?? @List.sort({ .chars, $_ }) !! @List.sort;
    $reverse ?? @s.reverse.List !! @s.List
}
say sort-list(<ccc a bb>);
say sort-list(<ccc a bb>, :type(AH));
say sort-list(<ccc a bb>, :reverse);
--- expect
(a bb ccc)
(a bb ccc)
(ccc bb a)

