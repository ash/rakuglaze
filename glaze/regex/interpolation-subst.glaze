=== rx-when-long-option-captures
from: Crust 0.0.1 lib/Crust/Runner.pm6:54
license: Artistic-2.0
feature: node RegexLit
--- code
my %opts;
for <--port=5000 --host=0.0.0.0 -v app.psgi> {
    when /^\-\-(<-[\=]>+)\=(.*)$/ {
        %opts{$0} = ~$1;
    }
    default { %opts<args>.push: $_ }
}
say %opts.sort.map({ "{.key}={.value}" }).join(' ');
--- expect
args=-v app.psgi host=0.0.0.0 port=5000

=== rx-split-v-named-captures
from: Template6 0.16.0 lib/Template6/Parser.rakumod:215
license: Artistic-2.0
feature: method split
--- code
my $template = "Hello [% name %]!\n[%# note %]Bye";
my @segments = $template.split(/ $<prefix-linebreak>=(\n?) '[%' $<comment-signature>=('#'?) \s* $<tokens>=(.*?) \s* '%]' /, :v);
for @segments -> $segment {
    if $segment ~~ Stringy {
        say "text: {$segment.raku}";
    }
    elsif $segment ~~ Match && !~$segment<comment-signature> {
        say "tag: {$segment<tokens>}";
    }
    else {
        say "comment: {$segment<tokens>}";
    }
}
--- expect
text: "Hello "
tag: name
text: "!"
comment: note
text: "Bye"

