=== hk-03-multi-method-concat
from: Data::Dump::Tree 2.9.4 lib/Data/Dump/Tree/DescribeBaseObjects.rakumod:95
license: Artistic-2.0
feature: multi method with string concatenation
--- code
my class T {
    multi method get_header (utf8 $b) { 
        "." ~ $b.^name ~ "[" ~ $b.elems ~ "]"
    }
}
my $t = T.new;
my $result = $t.get_header("test".encode);
say $result;
--- expect
.utf8[4]
