=== rx-m-c-g-i-positions
from: PostCocoon::Url 1.1 lib/PostCocoon/Url.rakumod:34
license: Artistic-2.0
feature: regex adverb :c
--- code
sub url-encode(Str:D $data --> Str:D) {
    my $start = 0;
    my @out;
    for $data ~~ m:c:g:i/<-[a .. z 0 .. 9 \- \. _]>/ -> $match {
        my $current-start = $start + $match.from;
        my $current-end = $start + $match.to;
        my $current-match = ~$match;
        @out.push: "$current-start..$current-end " ~ $current-match.encode("utf-8")>>.base(16).map({ "%" ~ $_ }).join;
    }
    @out.join("\n");
}
say url-encode('a b/Č');
--- expect
1..2 %20
3..4 %2F
4..5 %C4%8C

=== rx-match-rx-g-pointy-slash
from: Auth::SCRAM::Async 0.0.1 lib/Auth/SCRAM/Async.rakumod:63
license: Artistic-2.0
feature: method match
--- code
my $input = 'r=fyko+d2lbbFgONRv9qkxdawL,s=QSXCR+Q6sek8bf92,i=4096';
my %parsed;
for $input.match(rx{ $<key>=<[a..z]> '=' $<value>=[<-[,]>+] }, :g) -> $/ {
    %parsed{~$<key>} = ~$<value>;
}
say %parsed.sort.map({ "{.key}: {.value}" }).join("\n");
--- expect
i: 4096
r: fyko+d2lbbFgONRv9qkxdawL
s: QSXCR+Q6sek8bf92

=== rx-match-adverb-on-call
from: Data::Translators 0.1.18 lib/Data/Translators/HTML.rakumod:173
license: Artistic-2.0
feature: method match
--- code
my $html = '<table><tr><TH>Name</TH><th>Age</th></tr></table>';
if $html.match( /:i '<th>' $<header>=(.*?) '</th>' /):g {
    say $/.elems;
    say $/.map({ ~$_<header> }).join(',');
}
--- expect
2
Name,Age

