=== obj-type-identity-mu
from: Cro::HTTP 0.8.13 lib/Cro/HTTP/Router.rakumod:606
license: Artistic-2.0
feature: infix =:=
--- code
my sub p(Int $x, $y, Str $z) { }
for &p.signature.params -> $param {
    my $type := $param.type;
    if $type =:= Mu || $type =:= Any || $type =:= Str {
        say "{$param.name} matches literally";
    }
    else { say "{$param.name} is {$type.^name}" }
}
--- expect
$x is Int
$y matches literally
$z matches literally
