=== list-reduce-concat-map
from: DOM::Tiny 0.5.2 lib/DOM/Tiny/HTML.pm6:287
license: Artistic-2.0
feature: prefix [~]
--- code
my class Node { has $.tag; method render(:$xml) { $xml ?? "<$!tag/>" !! "<$!tag>" } }
my @children = Node.new(:tag<br>), Node.new(:tag<hr>);
sub render-children(:$xml) { [~] @children.map({ .render(:$xml) }); }
say render-children();
say render-children(:xml);
--- expect
<br><hr>
<br/><hr/>

