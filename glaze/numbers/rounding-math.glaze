=== num-round-map-components
from: Color 1.004001 lib/Color.rakumod:126
license: Artistic-2.0
feature: method round
--- code
my class RGB {
    has $.r; has $.g; has $.b;
    method rgb()   { map { .round }, $.r, $.g, $.b      }
}
say RGB.new(r => 254.6, g => 127.5, b => 0.4).rgb;
say RGB.new(r => 1e0, g => 2.5e0, b => -0.5e0).rgb.map(*.^name);
--- expect
(255 128 0)
(Int Int Int)

=== num-round-version-fixed
from: Font::FreeType 0.5.16 lib/Font/FreeType/Raw/TT_Sfnt.rakumod:66
license: Artistic-2.0
feature: method round
--- code
my class Header {
    has $.version;
    method version { Version.new: ($!version / (2  ** 16 )).round(.01) }
}
say Header.new(version => 0x00010000).version;
say Header.new(version => 0x00028000).version;
--- expect
v1
v2.5

