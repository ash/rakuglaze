=== ctl-for-dynvar-destructure
from: Intl::CLDR 0.7.6 lib/Intl/CLDR/Types/CurrencyFormats.rakumod:382
license: Artistic-2.0
feature: node For
--- code
my @currency-existence-table = True, False;
sub describe { "$*currency/$*length" }
my @out;
for <standard accounting> Z ^2 -> ($*currency, $currency-cell) {
    next unless @currency-existence-table[$currency-cell];
    for <short long> Z ^2 -> ($*length, $length-cell) {
        @out.push: describe();
    }
}
say @out;
--- expect
[standard/short standard/long]

