# Building hashes and maps as modules write them: %( ... ) literals, Map.new,
# .Map/.Hash coercion, Z=> and X=> zips, typed and object hashes,
# `is default`, merging by list assignment and slips.

=== hash-literal-colonpairs-return
from: DSL::Shared 0.2.11 lib/DSL/Shared/Actions/English/TimeIntervalSpec.rakumod:276
license: Artistic-2.0
feature: node HashLit
--- code
my class Interval {
    has $!unit = 'day';
    has $!length = 3;
    method spec { return %(:$!unit, :$!length) }
}
my %s = Interval.new.spec;
say %s.sort.map({ "{.key}={.value}" }).join(' ');
--- expect
length=3 unit=day

