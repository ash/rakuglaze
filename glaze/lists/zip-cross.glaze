=== list-cross-for-destructure
from: Digest 1.1.0 lib/Digest/SHA3.rakumod:41
license: Artistic-2.0
feature: infix X
--- code
my @lanes[3;3] = (0 xx 3) xx 3;
my @D = 1, 2, 4;
for ^3 X ^3 -> ($x, $y) { @lanes[$x;$y] +^= @D[$x] }
say @lanes[2;1];
say @lanes.shape;
--- expect
4
(3 3)
