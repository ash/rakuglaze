# Version objects, numeric Blob/Buf access, and radix conversion
# (.base, .parse-base, :16<..>) as modules use them.

=== num-version-from-int-parts
from: DBIish 0.6.9 lib/DBDish/Pg.rakumod:89
license: BSD-2-Clause
feature: method Version
--- code
for 160004, 90624 -> $libver {
    my $ver = $libver;
    $ver = Version.new((gather for ^3 { take $ver mod 100; $ver div= 100 }).reverse);
    say $ver, ' ', $ver.parts.elems;
}
--- expect
v16.0.4 3
v9.6.24 3

=== num-version-before-literal
from: Duckie 0.0.12 lib/Duckie.rakumod:657
license: MIT
feature: method Version
--- code
for 'v1.0.0', 'v1.1.0', 'v1.10.2' -> $s {
    my $ver = Version.new($s.subst(/^'v'/, ''));
    say $ver before v1.1.0 ?? "$ver too old" !! "$ver ok";
}
--- expect
1.0.0 too old
1.1.0 ok
1.10.2 ok

=== num-version-strip-v-part
from: META6 0.0.31 lib/META6.rakumod:221
license: Artistic-2.0
feature: method parts
--- code
sub unmarsh-version( $v --> Version ) {
    my $ver = Version.new($v.Str);
    if $ver.parts[0] eq 'v' {
        my @parts = $ver.parts;
        @parts.shift;
        $ver = Version.new(@parts.join('.'));
    }
    $ver
}
say unmarsh-version('0.0.1').parts;
say unmarsh-version('1.2.3').parts.map(*.^name);
--- expect
(0 0 1)
(Int Int Int)

