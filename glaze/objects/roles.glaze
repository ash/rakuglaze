# Roles as modules write them: parameterized roles over a type capture or a
# value, stub methods, forward declarations, also does, runtime mixins with
# `does` and `but`, anonymous roles, Associative and CALL-ME classes.

=== obj-role-type-capture-stub
from: App::RaCoCo 2.0.1 lib/App/Racoco/Configuration.rakumod:9
license: Artistic-2.0
feature: node Role
--- code
my role Key[::Type] {
    has Str $.name is required;
    method convert(Str $value --> Type) { ... }
    multi method of(Str() $name) { self.bless: :$name }
}
my class BoolKey does Key[Bool] {
    method convert($value --> Bool) {
        return Nil without $value;
        return False if $value.lc eq 'false' || $value eq '0';
        so $value;
    }
}
my $k = BoolKey.of('fail-level');
say $k.name, ' ', $k.convert('false'), ' ', $k.convert('yes');
say BoolKey ~~ Key, ' ', BoolKey ~~ Key[Bool], ' ', BoolKey ~~ Key[Str];
--- expect
fail-level False True
True True False

=== obj-role-returns-type-param
from: Cro::Core 0.8.10 lib/Cro.rakumod:280
license: Artistic-2.0
feature: node Role
--- code
my class Http2State { }
my role ConnectionState[::T] {
    method connection-state-type() { T }
}
my class Frames does ConnectionState[Http2State] { }
my class Plain { }
for Frames.new, Plain.new -> $comp {
    if $comp ~~ ConnectionState {
        my $cs-type = $comp.connection-state-type;
        say $cs-type.^name, ' ', $cs-type.new.^name;
    }
    else { say 'stateless' }
}
--- expect
Http2State Http2State
stateless

