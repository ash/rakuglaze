=== ctl-ternary-concat-pieces
from: Cro::HTTP 0.8.13 lib/Cro/HTTP/Router/LinkGenerator.rakumod:19
license: Artistic-2.0
feature: infix ?? !!
--- code
sub link($root-url, $prefix, $path) {
    $root-url ~ ($root-url.ends-with('/') ?? '' !! '/') ~ ($prefix ?? "$prefix/" !! '') ~ $path
}
say link('http://h', 'api', 'users');
say link('http://h/', '', 'users');
--- expect
http://h/api/users
http://h/users

=== ctl-ternary-die-branch
from: Data::Dump 0.0.18 lib/Data/Dump.rakumod:57
license: Artistic-2.0
feature: infix ?? !!
--- code
sub flag($k, $v) {
    $v ~~ Bool
    ?? $v
    !! ($v.lc eq 'true' ?? True !! ($v.lc eq 'false' ?? False !! die "$k can only be set to 'true' or 'false', got: '$v'"))
}
say flag('color', 'TRUE');
say flag('color', 'false');
say flag('color', False);
say flag('color', 'maybe');
--- expect
True
False
False
!! X::AdHoc

=== ctl-do-if-elsif
from: Audio::Sndfile 0.0.16 lib/Audio/Sndfile.rakumod:499
license: Artistic-2.0
feature: prefix do
--- code
my enum Mode <Read Write ReadWrite>;
sub mode(:$r, :$w, :$rw) {
    do if $r {
        Read;
    }
    elsif $w {
        Write;
    }
    else {
        ReadWrite;
    }
}
say mode(:r);
say mode(:w);
say mode(:rw);
--- expect
Read
Write
ReadWrite

=== ctl-do-if-destructure
from: CSS::Properties 0.10.9 lib/CSS/PageBox.rakumod:63
license: Artistic-2.0
feature: prefix do
--- code
sub page(@length, $width = 595, $height = 842) {
    my $auto = False;
    my ($page-width, $page-height) = do if @length {
        @length[1] //= @length[0];
        @length;
    } else {
        $auto = True;
        ($width, $height);
    }
    "$page-width x $page-height auto=$auto"
}
say page([300]);
say page([300, 400]);
say page([]);
--- expect
300 x 300 auto=False
300 x 400 auto=False
595 x 842 auto=True

