=== rx-capture-markers-proto-negated-class
from: File::Ignore 1.2 lib/File/Ignore.rakumod:24
license: Artistic-2.0
feature: regex <( )>
--- code
my grammar Glob {
    token TOP { <matcher>+ }
    proto token matcher    { * }
    token matcher:sym<*>   { <sym> }
    token matcher:sym<?>   { <sym> }
    token matcher:sym<[]>  { '[' [$<negate>='!']? <( <-[\]]>+ )> ']' }
    token matcher:sym<lit> { <-[/*?[]>+ }
}
for Glob.parse('a*[!xy]?.[ch]')<matcher> -> $m {
    say $m.Str, ($m<negate> ?? ' (negated)' !! '');
}
--- expect
a
*
xy (negated)
?
.
ch

