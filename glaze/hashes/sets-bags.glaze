=== hash-set-mix-zip
from: ML::TriesWithFrequencies 0.6.8 lib/ML/TriesWithFrequencies/ChildRandomChooser.rakumod:53
license: Artistic-2.0
feature: call Mix
--- code
my %children = a => 0.5, b => 1.5, c => 2;
my @keys = %children.keys.sort;
my $mix = Mix(@keys Z=> @keys.map({ %children{$_} }));
say $mix.total;
say $mix.sort(*.key).map({ "{.key}:{.value}" }).join(' ');
--- expect
4
a:0.5 b:1.5 c:2

=== hash-set-mix-hash-rescale
from: Data::Transformers 0.0.2 lib/Data/Transformers/Rescale.rakumod:84
license: Artistic-2.0
feature: type Mix
--- code
sub rescale($x) {
    given $x {
        when $_ ~~ Mix:D { rescale($_.Hash) }
        when $_ ~~ Hash:D { $_.sort.map({ "{.key}={.value * 2}" }).join(' ') }
    }
}
say rescale((a => 0.25, b => 1).Mix);
--- expect
a=0.5 b=2
