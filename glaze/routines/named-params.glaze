license: Artistic-2.0
feature: param :&named
--- code
multi select-columns($data, :vars(:$column-names)!, :&chooser = &infix:<(elem)>) {
    $data.map({ .grep({ chooser(.key, $column-names) }).sort.map(*.value).List }).List
}
