=== str-index-not-nil
from: DB::Xoos 0.1.1 lib/DB/Xoos.pm6:115
license: Artistic-2.0
feature: method index
--- code
my $base = 'App';
for 'x/lib/App/Model.pm6', 'x/t/test.t' -> $f {
    next unless $f.index("lib/$base") !~~ Nil;
    say $f.substr($f.index("lib/$base") + 4, $f.rindex('.') - $f.index("lib/$base") - 4);
}
--- expect
App/Model

=== str-index-zero-is-falsy
from: HTTP::UserAgent 1.2.0 lib/HTTP/Message.rakumod:188
license: MIT
feature: method index
--- code
for 'text/html', '/root', 'plain' -> $third {
    if $third.index('/') {
        say "$third: has slash after start";
    }
    else {
        say "$third: no";
    }
}
--- expect
text/html: has slash after start
/root: no
plain: no

=== str-index-without-guard
from: IO::Socket::Async::SSL 0.8.2 lib/IO/Socket/Async/SSL.rakumod:1106
license: Artistic-2.0
feature: method index
--- code
sub wildcard($name) {
    return False without $name.index('*');
    True
}
say wildcard('*.example.com');
say wildcard('www.example.com');
--- expect
True
False

=== str-index-int-pointy
from: Identity::Utils 0.0.29 lib/Identity/Utils.rakumod:373
license: Artistic-2.0
feature: method index
--- code
my $identity = 'Foo::Bar:ver<1.2>:auth<zef:me>';
with $identity.rindex('::') -> int $offset {
    with $identity.index(':', $offset + 2) -> int $chars {
        say $identity.substr(0, $chars);
    }
}
--- expect
Foo::Bar

=== str-rindex-with-substr
from: Cro::HTTP 0.8.13 lib/Cro/HTTP/Router.rakumod:1553
license: Artistic-2.0
feature: method rindex
--- code
for '/static/css/site.css', 'favicon.ico' -> $path {
    say do with $path.rindex('/') { $path.substr($_ + 1) } else { $path }
}
--- expect
site.css
favicon.ico

=== str-rindex-defined-or-chain
from: Cro::WebApp 0.10.1 lib/Cro/WebApp/Form.rakumod:528
license: Artistic-2.0
feature: method rindex
--- code
for '2026-10-01T12:00:00.250', '2026-10-01T12:00:00+02', '12:00' -> $ts {
    my $cutoff = $ts.rindex(".") // $ts.rindex("-") // $ts.rindex("+");
    say $cutoff // 'none';
}
--- expect
19
7
none

=== str-rindex-topic-plus-one
from: Code::Coverage 0.0.9 lib/Code/Coverage.rakumod:56
license: Artistic-2.0
feature: method rindex
--- code
my $lines = [];
for 'covered line 12', 'covered line 7' {
