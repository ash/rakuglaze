sub get-ap(:$axis = 0, :$pair = 0) {
    given $axis, $pair {
        when 0, 0 { 'array' }
        when 0, 1 { 'pairs' }
        when 1, 0 { 'columns' }
        default   { 'column pairs' }
    }
}
say get-ap;
