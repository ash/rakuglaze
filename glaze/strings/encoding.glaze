# Bytes and code points: encode/decode, Blob/Buf/utf8, ord/chr/ords/chrs, codes, base/parse-base, Str/Int/Numeric.

=== str-encode-utf8-list-bytes
from: BDD::Behave 0.9.5 lib/BDD/Behave/Parallel/Distribution.rakumod:163
license: Artistic-2.0
feature: method encode
--- code
my $hash = 0;
for 'né'.encode('utf-8').list -> $byte {
    $hash = ($hash * 31 + $byte) % 65536;
    print $byte, ' ';
}
say $hash;
--- expect
110 195 169 46388

