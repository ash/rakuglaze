    has $.tagline;
    method parts { my @inners = |@.inners, $.nav // Empty, $.tagline // Empty; @inners }
}
say Page.new(inners => <a b>, nav => 'N').parts;
say Page.new(inners => <a>, tagline => 'T').parts;
say Page.new.parts.elems;
--- expect
[a b N]
[a T]
0

