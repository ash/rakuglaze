=== sig-is-rw-param
from: DOM::Tiny 0.5.2 lib/DOM/Tiny/HTML.pm6:408
license: Artistic-2.0
feature: trait is rw
--- code
my sub _end($end, $xml, $current is rw) {
    $current = $current<parent> while $current<parent> && $current<tag> ne $end;
    $current = $current<parent> // $current;
}
my %root = tag => 'root';
my %div = tag => 'div', parent => %root;
my $cur = { tag => 'b', parent => %div };
_end('div', False, $cur);
say $cur<tag>;
_end('x', False, 42);
--- expect
root
