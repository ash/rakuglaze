=== num-duration-attr-default
from: Cro::HTTP 0.8.13 lib/Cro/HTTP/Auth/WebToken.rakumod:8
license: Artistic-2.0
feature: method Duration
--- code
my class Token {
    has $.expiration = Duration.new(60 * 30);
    method minutes { $!expiration / 60 }
}
say Token.new.expiration;
say Token.new.minutes;
my $issued = DateTime.new('2024-01-01T00:00:00Z');
say $issued.later(seconds => Token.new.expiration.Int);
say DateTime.new('2024-01-01T01:00:00Z') - $issued;
