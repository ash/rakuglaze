=== num-divisible-reduce-and
from: CSS::Writer 0.3.3 lib/CSS/Writer.rakumod:474
license: Artistic-2.0
feature: infix %%
--- code
sub write-rgb-mask(@mask) {
    my $reducable = [&&] @mask.map: { $_ %% 17 };
    my @hex-digits = $reducable
        ?? @mask.map: {($_ div 17).fmt: "%X"}
        !! @mask.map: {.fmt: "%02X"};
    [~] '#', @hex-digits.Slip;
}
say write-rgb-mask([170, 119, 255]);
say write-rgb-mask([170, 120, 255]);
--- expect
#A7F
#AA78FF

=== num-divisible-where-blob
from: Crypt::LibGcrypt 1.0.11 lib/Crypt/LibGcrypt/Cipher.rakumod:158
license: Artistic-2.0
feature: infix %%
--- code
my class Cipher {
    has $.blklen = 4;
    multi method encrypt(Blob:D $in where *.bytes %% $!blklen --> Blob) {
        Blob.new: $in.list.map(* +^ 0xFF)
    }
    multi method encrypt(Blob:D $in) { "unpadded: {$in.bytes} bytes" }
}
say Cipher.new.encrypt(Blob.new(1, 2, 3, 4)).list;
say Cipher.new.encrypt(Blob.new(1, 2, 3));
--- expect
(254 253 252 251)
unpadded: 3 bytes

=== num-polymod-base58
from: Base58 0.0.5 lib/Base58.rakumod:19
license: MIT
feature: method polymod
--- code
my @alphabet = <1 2 3 4 5 6 7 8 9 A B C D E F G H J K L M N P Q R S T U V W X Y Z a b c d e f g h i j k m n o p q r s t u v w x y z>;
sub encode(blob8 $b) {
    ($b.map(+(* == 0)).join.match(/^1*/)) ~
    $b
    .Array
    .reduce(256 * * + *)
    .polymod(58 xx *)
    .reverse
    .map({@alphabet[$_]})
    .join;
}
say encode('Hello World!'.encode);
say encode(blob8.new(0, 0, 1));
--- expect
2NEpo7TZRRrLZSi2U
112

