=== sig-named-typed-defaults-callable
from: BDD::Behave 0.9.5 lib/BDD/Behave/Benchmark.rakumod:80
license: Artistic-2.0
feature: param :$named
--- code
our proto sub benchmark(|) {*}
our multi sub benchmark(&block, Int :$iterations = 100, Int :$warmup = 0, Str :$label) {
    my $runs = 0;
    for ^($warmup + $iterations) { block(); $runs++ }
    ($label // 'bench') ~ ": $runs"
}
say benchmark({ 1 + 1 });
say benchmark({ 1 + 1 }, :iterations(5), :warmup(2), :label<sum>);
say benchmark({ 1 }, :iterations<5>);
--- expect
bench: 100
sum: 7
bench: 5

