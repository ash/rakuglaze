=== rx-not-after-octet-suffix
from: Email::Valid 1.0.7 lib/Email/Valid.rakumod:31
license: Artistic-2.0
feature: regex !after
--- code
my grammar IP {
    token TOP { <ipv4-host> }
    token octet { \d ** 1..3 <?{ $/ <= 255 }> }
    token multicast  { (<.octet>)<?{ $0 ~~ 224..239}>\.<.octet> ** 3 % '.' }
    token ipv4 { <.octet> ** 4 % '.' }
    token ipv4-host  { <!before [<multicast>]>[<ipv4>] <!after '.0'> }
}
for <10.1.2.3 230.1.1.1 10.1.2.0 300.1.1.1 192.168.1.10> -> $ip {
    say $ip, ': ', so IP.parse($ip);
}
--- expect
10.1.2.3: True
230.1.1.1: False
10.1.2.0: False
300.1.1.1: False
192.168.1.10: True

