2024-07-04T08:00:00Z

=== num-day-of-week-mod-seven
from: MVC::Keayl 0.9.2 lib/MVC/Keayl/Caching.rakumod:12
license: Artistic-2.0
feature: method day-of-week
--- code
my @day-names    = <Sun Mon Tue Wed Thu Fri Sat>;
my @month-names  = <Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec>;
sub http-date(DateTime:D $when --> Str) {
  my $utc = $when.utc;
  sprintf('%s, %02d %s %04d %02d:%02d:%02d GMT',
    @day-names[$utc.day-of-week % 7], $utc.day, @month-names[$utc.month - 1],
    $utc.year, $utc.hour, $utc.minute, $utc.second.Int)
}
say http-date(DateTime.new(2024, 12, 29, 23, 30, 15.75, timezone => -3600));
say http-date(DateTime.new('1994-11-06T08:49:37Z'));
--- expect
Mon, 30 Dec 2024 00:30:15 GMT
Sun, 06 Nov 1994 08:49:37 GMT

=== num-day-of-week-minus-one
from: Crust 0.0.1 lib/Crust/Utils.pm6:82
license: Artistic-2.0
feature: method day-of-week
--- code
sub format-datetime-rfc1123(DateTime $dt) {
    state @mon-abbr = <Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec>;
    state @dow-abbr = <Mon Tue Wed Thu Fri Sat Sun>;
    my $utc = $dt.utc;
    return sprintf("%s %02d %s %04d %02d:%02d:%02d GMT",
        @dow-abbr[$utc.day-of-week - 1],
        $utc.day-of-month, @mon-abbr[$utc.month-1], $utc.year,
        $utc.hour, $utc.minute, $utc.second);
}
say format-datetime-rfc1123(DateTime.new(2000, 1, 1, 0, 0, 0, :timezone(3600)));
--- expect
Fri 31 Dec 1999 23:00:00 GMT

=== num-datetime-formatter-sub
from: Cro::HTTP 0.8.13 lib/Cro/HTTP/Cookie.rakumod:152
license: Artistic-2.0
feature: method DateTime
--- code
sub rfc1123-formatter(DateTime $_ --> DateTime) {
    my constant %month-names = 1 => 'Jan', 2 => 'Feb', 3 => 'Mar',
                      4 => 'Apr', 5 => 'May', 6 => 'Jun',
                      7 => 'Jul', 8 => 'Aug', 9 => 'Sep',
                      10 => 'Oct', 11 => 'Nov', 12 => 'Dec';
    my constant %weekdays = 1 => 'Mon', 2 => 'Tue', 3 => 'Wed', 4 => 'Thu',
                   5 => 'Fri', 6 => 'Sat', 7 => 'Sun';
    my $rfc1123-format = sub ($self) { sprintf "%s, %02d %s %04d %02d:%02d:%02d GMT",
                                       %weekdays{.day-of-week}, .day,
                                       %month-names{.month}, .year,
                                       .hour, .minute, .second given $self.utc; }
    DateTime.new(.Str, formatter => $rfc1123-format);
}
my $dt = rfc1123-formatter(DateTime.new('2015-10-21T16:29:00-07:00'));
say $dt;
say $dt.year;
--- expect
Wed, 21 Oct 2015 23:29:00 GMT
2015

=== num-datetime-epoch-timezone-formatter
from: Git::Blame::File 0.0.11 lib/Git/Blame/File.rakumod:5
license: Artistic-2.0
feature: method DateTime
--- code
my sub datetimize(Int() $epoch, $offset --> DateTime:D) {
    my int $timezone = $offset.substr(0,3).Int * 3600;
    my int $minutes  = $offset.substr(3).Int;
    $timezone += 60 * ($timezone < 0 ?? -$minutes !! $minutes);
    DateTime.new: $epoch, :$timezone, :formatter({
        my int $tz = .timezone;
        sprintf '%4d-%02d-%02d %2d:%02d:%02d %s%02d%02d',
          .year, .month, .day, .hour, .minute, .second,
          $tz < 0 ?? '-' !! '+',
          $tz.abs div 3600,
          ($tz.abs mod 3600) div 60
    })
}
say datetimize('1700000000', '+0530');
say datetimize(0, '-0930');
say datetimize(86399, '+0000').posix;
--- expect
2023-11-15  3:43:20 +0530
1969-12-31 14:30:00 -0930
86399

=== num-datetime-offset-round
from: Bailador 0.0.19 lib/Bailador/Log/Formatter.pm:74
license: MIT
feature: method offset
--- code
sub dateTime-to-Str( DateTime:D $date-time ) {
  my @months = <Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec>;
  with $date-time {
    sprintf '%02d/%s/%04d:%02d:%02d:%02d %s%02d%02d',
      .day, @months[.month-1], .year, .hour, .minute, .second,
      .offset-in-hours >= 0 ?? '+' !! '-' , round(.offset / 3600), round .offset%3600/60
  }
}
say dateTime-to-Str(DateTime.new(2024, 6, 1, 9, 5, 7, timezone => 7200));
say dateTime-to-Str(DateTime.new(2024, 6, 1, 9, 5, 7, timezone => 19800));
--- expect
01/Jun/2024:09:05:07 +0200
01/Jun/2024:09:05:07 +0630

=== num-datetime-plus-seconds
from: Datetime::Math 0.6.2 lib/DateTime/Math.rakumod:41
license: Artistic-2.0
feature: method DateTime
--- code
sub plus(DateTime:D $dt, Numeric:D $x) {
    $dt.WHAT.new($dt.Numeric + $x,
      :timezone($dt.timezone), :formatter($dt.formatter))
}
my $dt = DateTime.new('2024-02-28T23:00:00+01:00');
say plus($dt, 3600 * 25);
say plus($dt, -60).timezone;
say $dt.Numeric;
--- expect
2024-03-01T00:00:00+01:00
3600
Instant:1709157637

