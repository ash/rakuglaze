# Item containers ($[], @$x, <>, .item), coercions (.list/.List/.Array/.Seq/.cache/.eager), arrays of arrays, shaped and multi-dim arrays.

=== list-itemized-push-append
from: Data::Dump::Tree 2.9.4 lib/Data/Dump/Tree/Diff.rakumod:295
license: Artistic-2.0
feature: term $[...]
--- code
my @as = [1, 2], [3, 4];
my @zip;
for ^2 -> $index {
    @zip.append: $[ $index, |(@as.map: { $_[$index] }) ], ;
}
say @zip.elems;
say @zip[1];
--- expect
2
[1 2 4]

=== list-itemized-empty-compare
from: Data::Reshapers 0.3.8 lib/Data/Reshapers/ToLongFormat.rakumod:56
license: Artistic-2.0
feature: term $[...]
--- code
for (Nil, $[], $['id'], Whatever) -> $idColsSpec {
    if !(so $idColsSpec) or $idColsSpec eq $[] or $idColsSpec.isa(Whatever) { say 'none' }
    else { say $idColsSpec.join(',') }
}
--- expect
none
none
id
none

=== list-itemized-array-deref-for
from: App::GPTrixie 0.29 lib/GPT/FileGenerator.pm6:20
license: Artistic-2.0
feature: prefix @
--- code
my $gpt-conf = [ { name => 'a' }, { name => 'b' } ];
for @$gpt-conf -> $mod-conf {
    say $mod-conf<name>;
}
for $gpt-conf -> $all { say $all.elems }
--- expect
a
b
2

