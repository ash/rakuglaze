=== rx-parse-with-rule-option
from: Getopt::Long 0.4.2 lib/Getopt/Long.rakumod:385
license: Artistic-2.0
feature: method parse
--- code
my grammar Parser {
    token TOP { <name> <argument>? }
    token name { \w+ }
    token argument { '=' $<type>=<[sif]> $<repeat>=['@']? }
}
for '=s', '=i@', 'x' -> $pattern {
    with Parser.parse($pattern, :rule('argument')) -> $match {
        say "$pattern: type {$match<type>}", ($match<repeat> ?? ' repeated' !! '');
    }
    else {
        say "$pattern: no argument";
    }
}
--- expect
=s: type s repeated
=i@: type i repeated
x: no argument

