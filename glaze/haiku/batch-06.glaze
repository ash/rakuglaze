my class CountStore { has $.key; has $.converter; has $.constraints; has %.values }
my $arg = Arg.new;
my $key = 'count';
my %values = a => 1, b => 2;
my $store = CountStore.new(:$key, :converter($arg.converter), :constraints($arg.constraints), :%values);
