=== obj-int-default-overridden
from: DB::MySQL 0.8 lib/DB/MySQL.pm6:8
license: BSD-2-Clause
feature: node Class
--- code
my class MySQL {
    has Int $.port = 3306;
    has $.host = 'localhost';
    method dsn { "$!host:$!port" }
}
say MySQL.new.dsn;
say MySQL.new(port => 3307).dsn;
MySQL.new(port => '3307');
