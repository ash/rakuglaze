# Bitwise integer operators as binary-format modules use them:
# +& +| +^ +< +>, their assignment forms, prefix +^, and ?^.

=== num-bitand-low-bit
from: Algorithm::Diff 0.0.5 lib/Algorithm/Diff.rakumod:534
license: Artistic-2.0
feature: infix +&
--- code
my class Hunk {
    has $._Same = 0;
    has $._Pos;
    method same { return 0 if $._Same == ( 1 +& $._Pos ); 1 }
}
say Hunk.new(_Pos => 4).same;
say Hunk.new(_Pos => 5).same;
--- expect
0
1

=== num-bitxor-fnv-hash
from: BDD::Behave 0.9.5 lib/BDD/Behave/Parallel/Distribution.rakumod:164
license: Artistic-2.0
feature: infix +^
--- code
sub fnv1a(Str $s) {
    my $h = 0x811C9DC5;
    for $s.encode.list -> $byte {
        $h = (($h +^ $byte) * 0x01000193) +& 0xFFFFFFFF;
    }
    $h
}
say fnv1a('');
say fnv1a('a');
say fnv1a('spec/foo.rakutest') % 4;
--- expect
2166136261
3826002220
0

