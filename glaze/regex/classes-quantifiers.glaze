=== rx-separator-star-percent-group
from: Cro::WebApp 0.10.1 lib/Cro/WebApp/Template/Parser.rakumod:367
license: Artistic-2.0
feature: regex % separator
--- code
my token parameter { '$' \w+ }
my token signature { '(' \s* <parameter>* % [\s* ',' \s*] \s* ')' }
for '($a, $b ,$c)', '()', '( $x )', '($a,)' -> $s {
    with $s ~~ /^ <signature> $/ { say +.<signature><parameter>, ': ', .<signature><parameter>.join(' ') }
    else { say "no: $s" }
}
--- expect
3: $a $b $c
0: 
1: $x
no: ($a,)

=== rx-separator-trailing-allowed-plus
from: CSS::Nested 0.0.1 lib/CSS/Nested.rakumod:14
license: Artistic-2.0
feature: regex %% separator
--- code
my grammar S {
    rule TOP { <selector> }
    rule selector { <op=.combinator>? <simple-selector> +%% <op=.combinator>? }
    token combinator { '>' | '+' | '~' }
    token simple-selector { \w+ }
}
for 'a > b', '> a + b ~', 'a b' -> $s {
    my $m = S.parse($s);
    say $s, ': ', $m ?? $m<selector><simple-selector>.elems ~ ' / ' ~ $m<selector><op>.elems !! 'fail';
}
--- expect
a > b: 2 / 1
> a + b ~: 2 / 3
a b: 2 / 0

=== rx-separator-double-percent-star-lines
from: Docker::File 1.1 lib/Docker/File.rakumod:262
license: Artistic-2.0
feature: regex %% separator
--- code
my grammar DF {
    token TOP { <instruction>* %% <insignificant-lines> }
    token instruction { <[A..Z]>+ \h+ \N+ }
    token insignificant-lines { [\h* ['#' \N*]? \n]+ }
}
my $m = DF.parse("FROM alpine\n# comment\n\nRUN make\n");
say $m<instruction>.map(*.Str.words[0]).join(',');
--- expect
FROM,RUN

