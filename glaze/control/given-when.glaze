# given/when/default with every kind of smartmatch target, proceed and
# succeed, `when` inside `for`, statement-modifier `when`.

=== ctl-when-ranges-open-end
from: Color 1.004001 lib/Color/Conversion.rakumod:100
license: Artistic-2.0
feature: node When
--- code
sub rgb-from-c-x($h, $c, $x) {
    my ($r, $g, $b);
    given $h {
        when   0..^60  { ($r, $g, $b) = ($c, $x, 0) }
        when  60..^120 { ($r, $g, $b) = ($x, $c, 0) }
        when 120..^180 { ($r, $g, $b) = (0, $c, $x) }
        when 180..^360 { ($r, $g, $b) = (0, 0, $c) }
    }
    "$r $g $b"
}
say rgb-from-c-x(0, 1, 0.5);
say rgb-from-c-x(60, 1, 0.5);
say rgb-from-c-x(150.5, 1, 0.5);
say rgb-from-c-x(359, 1, 0.5);
--- expect
1 0.5 0
0.5 1 0
0 1 0.5
0 0 1

=== ctl-given-list-when-list
