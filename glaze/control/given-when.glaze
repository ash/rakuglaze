=== ctl-when-file-tests-adverb
from: FileSystem::Helpers 0.1.2 lib/FileSystem/Helpers.rakumod:26
license: Artistic-2.0
feature: node When
--- code
my class Entry {
    has $.name;
    has Bool $.is-dir;
    method d { $!is-dir }
}
for Entry.new(name => 'src', :is-dir), Entry.new(name => 'a.txt', :!is-dir) {
    given $_ {
        when :d { say "dir {.name}" }
        default { say "file {.name}" }
    }
}
--- expect
dir src
file a.txt
