=== hk-11-colon-call-new-named-exception
from: Red 0.2.5 lib/Red/Driver/Pg.rakumod:283
license: Artistic-2.0
feature: colon-call new with colonpair arguments and a match capture
--- code
my grammar Field {
    token TOP { <field> }
    token field { \w+ }
}
my class Unique is Exception {
    has $.driver;
    has $.orig-exception;
    has $.fields;
    method message() { "unique on {$!fields}" }
}
my $m = Field.parse('email');
my $x = 'duplicate key';
my $err = Unique.new: :driver<Pg>, :orig-exception($x), :fields($m<field>.Str);
say $err.message;
say $err.driver
--- expect
unique on email
Pg
