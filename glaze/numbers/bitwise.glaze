=== num-boolxor-endianness
from: CBOR::Simple 0.1.4 lib/CBOR/Simple.rakumod:787
license: Artistic-2.0
feature: infix ?^
--- code
for (True, True), (True, False), (False, True), (False, False) -> ($is-little-endian, $on-little-endian) {
    my $is-same-endian   = !($is-little-endian ?^ $on-little-endian);
    say "$is-little-endian $on-little-endian -> $is-same-endian";
}
say (1 ?^ 0).^name;
--- expect
True True -> True
True False -> False
False True -> False
False False -> True
Bool
