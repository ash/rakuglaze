=== ctl-exception-hierarchy-cause
from: AttrX::Mooish 1.0.10 lib/AttrX/Mooish/X.rakumod:16
license: Artistic-2.0
feature: method message
--- code
my class Fatal is Exception { }
my class NotAllowed is Fatal {
    has Str:D $.op is required;
    has Str $.cause;
    method message {
        "Operation '$!op' is not allowed at this time" ~ ($!cause ?? ": $!cause" !! "")
    }
}
for NotAllowed.new(op => 'store'), NotAllowed.new(op => 'clear', cause => 'locked') -> $ex {
    $ex.throw;
    CATCH { when Fatal { say .message } }
}
say NotAllowed.new(op => 'x') ~~ Fatal;
--- expect
Operation 'store' is not allowed at this time
Operation 'clear' is not allowed at this time: locked
True

