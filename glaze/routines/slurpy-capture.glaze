=== sig-call-dot-paren-flatten
from: CompUnit::Util 0.7.0 lib/CompUnit/Util.rakumod:219
license: MIT
feature: prefix |
--- code
my %sym;
my @pos = 'x', 2;
my @makers = -> $k, $v { $k => $v }, -> $k, $v { "$k$v" => $v * 10 };
for @makers {
    %sym.append: .(|@pos);
}
say %sym.sort.map({ "{.key}={.value}" }).join(' ');
--- expect
x=2 x2=20

=== sig-attr-callable-call-flatten
from: Cache::Async 0.3.4 lib/Cache/Async.rakumod:280
license: Artistic-2.0
feature: prefix |
--- code
my class Cache {
    has &.producer;
    method get($key, +@args) {
        my $prod-result = &.producer.($key, |@args);
        $prod-result
    }
}
my $c = Cache.new(producer => -> $k, *@rest { "$k:" ~ @rest.sum });
say $c.get('a', 1, 2, 3);
say $c.get('b');
--- expect
a:6
b:0
