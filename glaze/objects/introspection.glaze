# Introspection as modules use it: .^name / .^shortname, .^attributes with
# get_value / set_value, .^methods, .^mro, .^parents, .^roles, .^find_method,
# .^lookup, .^add_method, .^can, .^does, .can, .isa, .does, WHAT, WHO.

=== obj-attributes-get-value-hash
from: Actionable 0.0.7 lib/Actionable.rakumod:236
license: Artistic-2.0
feature: method get_value
--- code
my class Action {
    has $.verb = 'run';
    has $!target = 'all';
    has @.flags = <q v>;
    method Hash { self.^attributes.map({ .name.substr(2) => .get_value(self) }).Hash }
}
my %h = Action.new.Hash;
say %h.keys.sort;
say %h<target>, ' ', %h<flags>;
--- expect
(flags target verb)
all [q v]

=== obj-attributes-required-names
from: Air 0.1.32 lib/Air/Form.rakumod:388
license: Artistic-2.0
feature: method attributes
--- code
my class Form {
    has Str $.name is required;
    has Str $.email is required;
    has Str $.note;
    method required-fields {
        ::?CLASS.^attributes.grep({ .^can('required') && .required }).map(*.name.substr(2)).list
    }
}
say Form.required-fields;
--- expect
(name email)

=== obj-attributes-first-get-value
from: Air 0.1.32 lib/Air/Form.rakumod:410
license: Artistic-2.0
feature: method get_value
--- code
my class Form {
    has $!answer = 42;
    method lookup($name) {
        my $answer = self.^attributes.first({ .name eq "\$!$name" }).get_value(self).Str;
