my class Obj { }
my class Validator {
    has $.klass-name;
}
my @validators = Validator.new(klass-name => 'Obj'), Validator.new(klass-name => 'Other');
my $obj = Obj.new;
for @validators -> $validator {
    next unless $obj.^name eq $validator.klass-name;
    say "validate with {$validator.klass-name}";
}
--- expect
validate with Obj

