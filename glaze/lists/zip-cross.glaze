=== list-zip-comma-styles
from: Terminal::Table 0.1.1 lib/Terminal/Table/Generator.rakumod:145
license: MIT
feature: infix Z,
--- code
my @array = [1, 2], [3, 4];
my @styles = 'bold', 'dim';
for @array Z, @styles -> ($inner_array, $inner_style) {
    say "$inner_style: {$inner_array.join('+')}";
}
--- expect
bold: 1+2
dim: 3+4

=== list-zip-hash-literal
from: FastCGI 0.9.0 lib/FastCGI/Protocol.rakumod:31
license: Artistic-2.0
feature: infix Z
--- code
my @vals = 1, 7, 512, 0;
my %h = %('type', 'request-id', 'content-length', 'padding-length' Z @vals);
say %h.sort.map({ "{.key}={.value}" }).join(' ');
--- expect
content-length 512=padding-length 0 type 1=request-id 7

