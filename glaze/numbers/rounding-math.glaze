=== num-sign-abs-assign
from: Math::FractionalPart 0.0.6 lib/Math/FractionalPart.rakumod:97
license: Artistic-2.0
feature: method abs
--- code
for -2.5, 0, 17, -1e3 -> $n {
    my $x = $n;
    $x .= Real;
    my $sign = $x.sign;
    $x .= abs;
    $x .= Str;
    say "$sign $x";
}
--- expect
-1 2.5
0 0
1 17
-1 1000

=== num-abs-threshold-map
from: Graph 0.1.3 lib/Graph.rakumod:492
license: Artistic-2.0
feature: method abs
--- code
my %d = a => -0.05, b => 0.7, c => -3, d => 0.1;
my $threshold = 0.1;
my %adj = %d.map({ $_.key => $_.value.abs ≤ $threshold ?? 0 !! 1 }).Hash;
say %adj.sort.map({ "{.key}={.value}" }).join(' ');
--- expect
a=0 b=1 c=1 d=0

