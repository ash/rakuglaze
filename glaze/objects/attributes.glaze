# Attributes and their traits as modules declare them: is rw, is built,
# is default, typed and defined-only attributes, defaults computed from
# other attributes, Callable attributes, private delegation.

=== obj-rw-typed-no-default
from: BDD::Behave 0.9.5 lib/BDD/Behave/Configuration.rakumod:62
license: Artistic-2.0
feature: trait is rw
--- code
my class Configuration {
    has Str      $.format               is rw;
}
my $c = Configuration.new;
say $c.format.raku;
$c.format = 'documentation';
say $c.format;
$c.format = 42;
--- expect
Str
documentation
!! X::TypeCheck::Assignment

=== obj-rw-append-in-place
from: CSS::Writer 0.3.3 lib/CSS/Writer.rakumod:7
license: Artistic-2.0
feature: trait is rw
--- code
my class Writer {
    has Str $.indent is rw = '';
    method line($s) { $.indent ~ $s }
}
my $w = Writer.new;
say $w.line('a {').raku;
$w.indent ~= '  ';
say $w.line('color: red').raku;
--- expect
"a \{"
"  color: red"

=== obj-readonly-accessor-assign
from: Air 0.1.32 lib/Air/Base/Elements.rakumod:1060
license: Artistic-2.0
feature: node Class
--- code
my class Spinner {
    has Int  $.width = 150;
}
my $s = Spinner.new(width => 80);
say $s.width;
say Spinner.new.width;
$s.width = 10;
--- expect
80
150
!! X::Assignment::RO

=== obj-built-private
from: Air 0.1.32 lib/Air/Base.rakumod:596
license: Artistic-2.0
feature: trait is built
--- code
my class Page {
    has Str  $!stub is built;
    method url { "/" ~ ($!stub // "index") }
}
say Page.new(stub => "about").url;
say Page.new.url;
say Page.can("stub").elems;
--- expect
/about
/index
0

=== obj-built-bind-shares
from: AttrX::Mooish 1.0.10 lib/AttrX/Mooish/Attribute.rakumod:11
license: Artistic-2.0
feature: trait is built
--- code
my class Wrapper {
    has $!attribute is built(:bind);
    method grow { $!attribute.push: 'x' }
}
my @list = <a b>;
my $w = Wrapper.new(attribute => @list);
$w.grow;
say @list;
--- expect
[a b x]

=== obj-built-bind-default
from: CodeUnit 0.0.11 lib/CodeUnit.rakumod:10
license: Artistic-2.0
feature: trait is built
--- code
my class CodeUnit {
    has Mu $.compiler is built(:bind) = "Raku";
}
say CodeUnit.new.compiler;
