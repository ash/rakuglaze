=== num-subset-num-whatever
from: LLM::Chat 0.10.0 lib/LLM/Chat/Backend/Settings.rakumod:3
license: Artistic-2.0
feature: decl subset
--- code
my subset Probability of Num where 0 <= * <= 1;
my subset PositiveInt of Int where * >= 0;
say 0.5e0 ~~ Probability, ' ', 0.5 ~~ Probability, ' ', 1.5e0 ~~ Probability;
say 0 ~~ PositiveInt, ' ', -3 ~~ PositiveInt;
my Probability $t = 0.7e0;
say $t;
--- expect
True False False
True False
0.7

=== num-subset-numeric-junction
from: OpenSSL 0.2.9 lib/OpenSSL.rakumod:28
license: MIT
feature: decl subset
--- code
my subset ProtocolVersion of Numeric where * == 2| 3| 1| 1.1| 1.2| 1.3| -1;
for 1.2, 1.25, -1, 3e0, 4 {
    say "$_: {$_ ~~ ProtocolVersion}";
}
--- expect
1.2: True
1.25: False
-1: True
3: True
4: False

=== num-subset-literal-zero
from: LibXML 0.11.3 lib/LibXML/XPath/Context.rakumod:221
license: Artistic-2.0
feature: decl subset
--- code
my subset Zero of Int where 0;
multi sizeof(Zero) { 'empty' }
multi sizeof(Int $n) { "$n items" }
say sizeof(0);
say sizeof(3);
say 0.0 ~~ Zero, ' ', 0 ~~ Zero;
--- expect
empty
3 items
False True

=== num-uint-typed-var
from: Air 0.1.32 lib/Air/Component.rakumod:268
license: Artistic-2.0
feature: type UInt
--- code
my  UInt $next = 1;
$next++ for ^3;
say $next;
say UInt.^name, ' ', 5 ~~ UInt, ' ', -5 ~~ UInt, ' ', 5.0 ~~ UInt;
$next = -1;
--- expect
4
UInt True False False
!! X::TypeCheck::Assignment
