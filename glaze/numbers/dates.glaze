=== num-datetime-later-weeks-same-month
from: DateTime::TimeZone 0.10.2 lib/DateTime/TimeZone/Zone.rakumod:57
license: Artistic-2.0
feature: method later
--- code
my $datetime = DateTime.new(2024, 3, 3, 2, 0, 0);
loop {
    my $new-dt = $datetime.later(weeks => 1);
    if $new-dt.month == $datetime.month {
        $datetime = $new-dt;
    }
    else {
        last;
    }
}
say $datetime;
say $datetime.later(:days(2)).earlier(:hours(3));
--- expect
2024-03-31T02:00:00Z
2024-04-01T23:00:00Z

=== num-day-of-week-given-when
from: Bailador 0.0.19 lib/Bailador/Response.pm:24
license: MIT
feature: method day-of-week
--- code
my $dt = DateTime.new('2024-07-04T10:00:00+02:00').utc;
my $wdy = do given $dt.day-of-week {
    when 1 { <Mon> }
    when 2 { <Tue> }
    when 3 { <Wed> }
    when 4 { <Thu> }
    when 5 { <Fri> }
    when 6 { <Sat> }
    when 7 { <Sun> }
}
my $day = $dt.day-of-month.fmt('%02d');
say "$wdy, $day";
say $dt;
--- expect
