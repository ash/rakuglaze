--- code
my grammar COS {
    rule trailer { 'trailer' '<<' <entry>* '>>' }
    rule entry { '/' (\w+) (\d+) }
}
my class Scan {
    method trailer($/) { make $<entry>.map({ ~.[0] => +.[1] }).Hash }
}
my $trailer = "  trailer << /Size 12 /Root 3 >>\nstartxref\n";
my $parse = COS.subparse( $trailer.trim, :rule<trailer>, actions => Scan );
say $parse.made.sort.map({ "{.key}={.value}" }).join(' ');
say $parse.to, ' of ', $trailer.trim.chars;
say so COS.parse($trailer.trim, :rule<trailer>);
--- expect
Root=3 Size=12
31 of 40
False

