# kv/pairs/antipairs and for loops with several variables, destructuring, do-for.

=== list-kv-for-index-value
from: Cro::Core 0.8.10 lib/Cro.rakumod:240
license: Artistic-2.0
feature: method kv
--- code
my @transforms = <parse route serialize>;
for @transforms.kv -> $i, $t {
    say "$i: $t";
}
--- expect
0: parse
1: route
2: serialize

=== list-kv-map-two-params
from: Getopt::Long 0.4.2 lib/Getopt/Long.rakumod:646
license: Artistic-2.0
feature: method kv
--- code
my @list = <file.txt out.txt>;
my @positionals = @list.kv.map: -> $index, $value {
    "\$$index=$value"
};
say @positionals;
--- expect
[$0=file.txt $1=out.txt]

=== list-kv-hash-antipairs
from: Base64 0.1.0 lib/Base64.rakumod:40
license: Artistic-2.0
feature: method antipairs
--- code
my @alpha = <A B C D>;
my %lookup = @alpha.kv.hash.antipairs;
say %lookup<C>;
say %lookup.keys.sort;
--- expect
2
(A B C D)

=== list-kv-hash-invert
from: Graph 0.1.3 lib/Graph.rakumod:514
license: Artistic-2.0
feature: method invert
--- code
my @vertex-list = <c a b>;
my %vertexToInd = @vertex-list.sort.kv.Hash.invert;
say %vertexToInd.sort(*.value).map(*.key);
--- expect
(a b c)

=== list-antipairs-map-lookup
from: HTTP::Tiny 0.2.6 lib/HTTP/Tiny.rakumod:176
license: Artistic-2.0
feature: method antipairs
--- code
my constant MoY = <Jan Feb Mar Apr>;
my %args = month => 'Mar';
my $month = MoY.antipairs.Map.{ %args<month>:delete } + 1;
say $month;
say %args.elems;
--- expect
3
0

=== list-pairs-of-array
from: Algorithm::KDimensionalTree 0.1.2 lib/Algorithm/KDimensionalTree.rakumod:44
license: Artistic-2.0
feature: method pairs
--- code
my @points = [1, 2], [3, 4];
@points = @points.pairs;
say @points[1].key;
say @points[1].value;
say @points[0].^name;
--- expect
1
[3 4]
Pair

=== list-pairs-postfix-for
from: DSL::Shared 0.2.11 lib/DSL/Shared/FiniteStateMachines/CoreFSM.rakumod:186
license: Artistic-2.0
feature: method pairs
--- code
my class T { has $.id }
my @transitions = T.new(:id<go>), T.new(:id<stop>);
say "[{.key + 1}] {.value.id}" for @transitions.pairs;
--- expect
[1] go
[2] stop

=== list-pairs-sum-bitshift
from: Base64 0.1.0 lib/Base64.rakumod:20
license: Artistic-2.0
feature: method pairs
--- code
my $chunk = (77, 97, 110);
my $n := [+] $chunk.pairs.map: -> $c {
    $c.value +< ((2 - $c.key) * 8)
};
say $n;
say $n.base(16);
--- expect
5071214
4D616E

=== list-for-three-vars
from: Template6 0.16.0 lib/Template6/Parser.rakumod:101
license: Artistic-2.0
feature: node For
--- code
my @defs = 'x', '=', 1, 'y', '+=', 2;
for @defs -> $name, $op, $value {
    say "$name $op $value";
}
--- expect
x = 1
y += 2

=== list-for-sub-signature-destructure
from: Cro::WebApp 0.10.1 lib/Cro/WebApp/Form.rakumod:757
license: Artistic-2.0
feature: node For
--- code
my @validations = [* > 0, 'must be positive'], [* < 10, 'too big'];
my $v = 12;
for @validations -> [$check, $message] {
    say $message unless $check($v);
}
--- expect
too big

=== list-for-paren-destructure-pairs
from: Bailador 0.0.19 lib/Bailador/Configuration.pm:96
license: MIT
feature: node For
--- code
my @args = ('port', 3000), ('host', 'localhost');
for @args -> ($k, $v) {
    say "$k => $v";
}
--- expect
port => 3000
host => localhost

=== list-for-sorted-kv-destructure
from: DOM::Tiny 0.5.2 lib/DOM/Tiny/HTML.pm6:366
license: Artistic-2.0
feature: node For
--- code
my %attr = id => 'main', class => 'box';
my $result = '';
$result ~= [~] gather for %attr.sort».kv -> ($key, $value) {
    take qq{ $key="$value"};
};
say "<div$result>";
--- expect
<div class="box" id="main">

=== list-for-reverse-typed
from: Crust 0.0.1 lib/Crust/Builder.pm6:61
license: Artistic-2.0
feature: method reverse
--- code
my @middlewares = &uc, &flip;
my $app = 'app';
for @middlewares.reverse -> $mw {
    $app = $mw($app);
}
say $app;
--- expect
PPA

=== list-do-for-collects
from: Data::Generators 0.1.11 lib/Data/Generators/RandomFunctions.rakumod:224
license: Artistic-2.0
feature: prefix do
--- code
my $size = 4;
my @r = do for ^$size -> $i {
    $i ** 2
}
say @r;
--- expect
[0 1 4 9]

=== list-paren-for-collects
from: Data::Importers 0.1.8 lib/Data/Importers/HarwellBoeing.rakumod:145
license: Artistic-2.0
feature: node For
--- code
my $nnzero = 3;
my @values = (for ^$nnzero -> $k {
    $k * 10 + 1
});
say @values;
--- expect
[1 11 21]

=== list-statement-modifier-for-index
from: Dan 0.0.3 lib/Dan.rakumod:226
license: Artistic-2.0
feature: node For
--- code
my @data = <x y z>;
my %index;
my $i = 0;
%index{~$i} = $i++ for ^@data;
say %index.sort.map({ "{.key}:{.value}" }).join(' ');
--- expect
0:0 1:1 2:2
