# Interpolation into regexes, s/// forms, subst with match closures, regexes in when, split :v.

=== rx-interp-string-as-regex
from: DSL::Shared 0.2.11 lib/DSL/Shared/Utilities/FuzzyMatching.rakumod:253
license: Artistic-2.0
feature: regex make
--- code
my @knownRegexes = 'data \s* frame', 'tib+le';
for 'data  frame', 'my dataframe here', 'tibbble', 'table' -> $candidate {
    for False, True -> $contains {
        for @knownRegexes -> $rx {
            if $candidate ~~ ( $contains ?? / (<$rx>) / !! / ^ (<$rx>) $ / ) {
                say "$candidate ({$contains ?? 'contains' !! 'whole'}): $0";
            }
        }
    }
}
--- expect
data  frame (whole): data  frame
data  frame (contains): data  frame
my dataframe here (contains): dataframe
tibbble (whole): tibbble
tibbble (contains): tibbble

=== rx-interp-string-literal-vs-regex
from: Term::Choose 2.0.6 lib/Term/Choose.rakumod:1643
license: Artistic-2.0
feature: node RegexLit
--- code
my $search_str = 'a.c';
my Regex $regex = rx:i/<$search_str>/;
my Regex $literal = rx:i/$search_str/;
for <ABC a.c xa.cy> -> $s {
    say "$s: ", so($s ~~ $regex), ' ', so($s ~~ $literal);
}
--- expect
ABC: True False
a.c: True True
xa.cy: True True

=== rx-interp-closure-assertion
from: BDD::Behave 0.9.5 lib/BDD/Behave/DocExtractor.rakumod:102
license: Artistic-2.0
feature: method match
--- code
sub description-matches-pattern(Str $description, Str $pattern --> Bool) {
    if $pattern.chars > 2
       && $pattern.starts-with('/')
       && $pattern.ends-with('/') {
        my $body = $pattern.substr(1, $pattern.chars - 2);
        my $rx = / <{ $body }> /;
        return so $description.match($rx);
    }
    $description.contains($pattern);
}
say description-matches-pattern('adds two numbers', '/ \d+ | two /');
say description-matches-pattern('adds 2 numbers', '/^ subtract/');
say description-matches-pattern('adds 2 numbers', 'adds');
--- expect
True
False
True

=== rx-interp-array-in-subset
from: Base58 0.0.5 lib/Base58.rakumod:10
license: MIT
feature: decl subset
--- code
my @alphabet = <
  1 2 3 4 5 6 7 8 9
  A B C D E F G H   J K L M N   P Q R S T U V W X Y Z
  a b c d e f g h i j k   m n o p q r s t u v w x y z
>;
my subset Base58Str of Str where /^<@alphabet>*$/;
for <3mJr7AoUXx2Wqd 0OIl abc> -> $s {
    say "$s: ", $s ~~ Base58Str;
}
--- expect
3mJr7AoUXx2Wqd: True
0OIl: False
abc: True

