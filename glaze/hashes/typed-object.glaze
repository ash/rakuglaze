=== hash-typed-whatever-or-type
from: Getopt::Long 0.4.2 lib/Getopt/Long.rakumod:98
license: Artistic-2.0
feature: typed hash
--- code
my class Store {
    has $!values = {};
    has $!key = 'define';
    has $!type;
    submethod BUILD(:$!type) {}
    method store($k, $v) {
        $!values{$!key} //= $!type === Any ?? Hash !! Hash[$!type].new;
        $!values{$!key}{$k} = $v;
        $!values{$!key}
    }
}
say Store.new(type => Int).store('n', 3).^name;
say Store.new(type => Any).store('n', 'x').^name;
--- expect
Hash[Int]
Hash

