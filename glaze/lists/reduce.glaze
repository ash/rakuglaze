=== list-reduce-plus-zip-times
from: Math::SparseMatrix 0.0.15 lib/Math/SparseMatrix/Utilities.rakumod:76
license: Artistic-2.0
feature: infix Z*
--- code
my @row = 1, 2, 3;
my @matrix2 = [1, 0], [0, 1], [1, 1];
my @result;
for ^2 -> $j {
    @result[0][$j] = [+] @row Z* @matrix2.map({ $_[$j] });
}
say @result[0];
--- expect
[4 5]

