=== rx-grammar-role-composed-tokens
from: LaTeX::Grammar 0.0.5 lib/LaTeX/Grammarish.rakumod:10
license: Artistic-2.0
feature: node Grammar
--- code
my role Grammarish {
    token ws { \s* }
    rule TOP { [ <command> ]+ }
    token command { '\\' <name=.ident> [ '{' <arg> '}' ]? }
    token arg { <-[}]>* }
}
my grammar LaTeX does Grammarish { }
my $m = LaTeX.parse(Q{\section{Intro}  \newline \emph{x}});
say $m<command>.map({ .<name> ~ (.<arg> ?? "({.<arg>})" !! '') }).join(' ');
