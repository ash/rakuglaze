=== obj-callable-default-from-attr
from: Auth::SCRAM::Async 0.0.1 lib/Auth/SCRAM/Async.rakumod:39
license: Artistic-2.0
feature: node Class
--- code
my %info-for = sha1 => { digest => *.flip, hash-size => 20 },
               md5  => { digest => *.uc,   hash-size => 16 };
my class Client {
    has Str:D $.digest is required;
    has &!digest = %info-for{$!digest}<digest>;
    has Int:D $.hash-size   = %info-for{$!digest}<hash-size>;
    method run($s) { &!digest($s) }
}
my $c = Client.new(digest => 'sha1');
say $c.run('abc'), ' ', $c.hash-size;
say Client.new(digest => 'md5').run('abc');
--- expect
cba 20
ABC

=== obj-is-default-scalar-nil
from: Crypt::LibGcrypt 1.0.11 lib/Crypt/LibGcrypt/Cipher.rakumod:13
license: Artistic-2.0
feature: trait is default
--- code
my class Cipher {
    has Bool $.debug is default(False);
}
say Cipher.new.debug;
say Cipher.new(debug => True).debug;
say Cipher.new(debug => Nil).debug;
--- expect
False
True
False

=== obj-is-default-array-attr
from: Intl::LanguageTag 0.12.7 lib/Intl/LanguageTag/BCP47.rakumod:430
license: Artistic-2.0
feature: trait is default
--- code
my class Type {
    has Str $.id;
    has Str @.subtags is default('');
    multi method new(*$id, *@subtags) { self.bless: :$id, :@subtags }
}
my $t = Type.new('ca', 'gregory');
say $t.id;
say $t.subtags.raku;
say $t.subtags[3].raku;
--- expect
ca
Array[Str].new("gregory")
""

