=== list-sequence-countdown-exclusive-start
from: CSS::Properties 0.10.9 lib/CSS/Properties/Optimizer.rakumod:98
license: Artistic-2.0
feature: infix ^...
--- code
my @expr = <a b c d>;
my @seen;
for +@expr ^... 1 {
    @seen.push: $_;
}
say @seen;
--- expect
[3 2 1]

=== list-sequence-countdown-sigilless
from: Astro::Utils 0.0.3 lib/Astro/Utils.rakumod:257
license: Artistic-2.0
feature: infix ^...
--- code
my \c = 1, 2, 3;
my \t = 2;
my \xi = (c.elems ^... 0).map: -> \i { t ** i };
say xi;
--- expect
(4 2 1)

=== list-sequence-halving
from: Graph 0.1.3 lib/Graph/Harary.rakumod:15
license: Artistic-2.0
feature: infix ...
--- code
my $k = 7;
my @js;
for (1 ... $k div 2) -> $j {
    @js.push: $j;
}
say @js;
--- expect
[1 2 3]
