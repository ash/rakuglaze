=== obj-role-param-my-per-specialization
from: MUGS::Core 0.1.4 lib/MUGS/Util/ImplementationRegistry.rakumod:5
license: Artistic-2.0
feature: node Role
--- code
my class Game { }
my class Chess is Game { }
my class Go is Game { }
my role Registry[::Constraint] {
    my %implementation;
    method register-implementation(Str:D $moniker, Constraint:U $class) {
        %implementation{$moniker} = $class;
    }
    method implementation-class(Str:D $moniker) { %implementation{$moniker} }
    method known-implementations() { %implementation.keys.sort }
}
my class GameRegistry does Registry[Game] { }
GameRegistry.register-implementation('chess', Chess);
GameRegistry.register-implementation('go', Go);
say GameRegistry.known-implementations;
say GameRegistry.implementation-class('go').^name;
GameRegistry.register-implementation('bad', Int);
--- expect
(chess go)
Go
!! X::TypeCheck::Binding::Parameter

=== obj-role-hash-value-param-build
from: Cro::Core 0.8.10 lib/Cro/Policy/Timeout.rakumod:23
license: Artistic-2.0
feature: node Role
--- code
my role Timeout[%phase-defaults] {
    has Real() $.total is required;
    has Real() %.phases;
    submethod BUILD(Real:D() :$!total, *%phases --> Nil) {
        for %phase-defaults.kv -> $kind, $default {
            my $supplied-value = %phases{$kind}:delete;
            %!phases{$kind} = $supplied-value ~~ Real ?? Real($supplied-value) !! Real($default);
        }
    }
}
my class ClientTimeout does Timeout[%( connection => 60, headers => 30 )] { }
my $t = ClientTimeout.new(total => '90', headers => 5);
say $t.total, ' ', $t.total.^name;
say $t.phases.sort.map(*.kv.join('=')).join(' ');
--- expect
90 Int
connection=60 headers=5

