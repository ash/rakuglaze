# Date, DateTime and Duration with fixed dates: construction from
# strings, parts and named args, .later/.earlier, .day-of-week,
# .days-in-month, formatters, time zones, epoch arithmetic.

=== num-date-new-parse-or-fail
from: Cro::WebApp 0.10.1 lib/Cro/WebApp/Form.rakumod:372
license: Artistic-2.0
feature: method Date
--- code
for '2024-02-29', '2023-02-29', 'soon' -> $value {
    my $d = try Date.new($value);
    say $d.defined ?? "{$d.yyyy-mm-dd} {$d.day-of-week}" !! "unparseable $value";
}
--- expect
2024-02-29 4
unparseable 2023-02-29
unparseable soon

