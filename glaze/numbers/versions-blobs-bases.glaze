=== num-parse-base-binary-sextets
from: HTTP::Tiny 0.2.6 lib/HTTP/Tiny.rakumod:410
license: Artistic-2.0
feature: method parse-base
--- code
sub base64-encode ( Blob $blob --> Str ) {
    my constant %enc = ( 'A'...'Z', 'a'...'z', 0...9, '+', '/' ).pairs;
    my $out = $blob».fmt('%08b').join.comb(6)
        .map({ %enc{ .fmt('%-6s').subst(' ', '0', :g).parse-base(2) } })
        .join;
    $out ~ '=' x (-$out.chars % 4)
}
say base64-encode('Man'.encode);
say base64-encode('Ma'.encode);
--- expect
TWFu
TWE=

