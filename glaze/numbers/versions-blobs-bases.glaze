=== num-buf-write-uint16-be
from: Cro::WebSocket 0.8.10 lib/Cro/WebSocket/FrameSerializer.rakumod:28
license: Artistic-2.0
feature: method write-uint16
--- code
for 5, 300, 70000 -> $payload-len {
    my $message = Buf.new(0x81, 0);
    if $payload-len < 126 {
        $message[1] = $payload-len;
    }
    elsif $payload-len < 65536 {
        $message[1] = 126;
        $message.write-uint16(2, $payload-len, BigEndian);
    }
    else {
        $message[1] = 127;
        $message.write-uint64(2, $payload-len, BigEndian);
    }
    say $message.list.fmt('%02x');
}
--- expect
81 05
81 7e 01 2c
81 7f 00 00 00 00 00 01 11 70

