feature: method wrap
--- code
my @calls;
sub plan($n) { "plan $n" }
my \routine = &plan;
my &wrapper = -> |c { @calls.push: c.list[0]; callsame() ~ ' (wrapped)' };
routine.wrap(&wrapper);
say plan(3);
say @calls;
--- expect
plan 3 (wrapped)
[3]

