=== num-constant-but-role
from: DBIish 0.6.9 lib/DBDish/StatementHandle.rakumod:75
license: BSD-2-Clause
feature: infix but
--- code
my role IntTrue { method Bool { True } }
my constant TRUE_ZERO = 0 but IntTrue;
for 3, 0 -> $affected-rows {
    my $rows = $affected-rows == 0 ?? TRUE_ZERO !! $affected-rows;
    say "$rows {?$rows}";
}
say TRUE_ZERO + 5, ' ', TRUE_ZERO ~~ Int;
--- expect
3 True
0 True
5 True

