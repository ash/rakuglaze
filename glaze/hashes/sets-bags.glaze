=== hash-set-cont-sethash
from: HTTP::Headers 0.5.0 lib/HTTP/Headers.pm6:248
license: Artistic-2.0
feature: infix ∋
--- code
my @headers = (Accept => 'a'), (Host => 'h'), (Accept => 'b');
my $seen = SetHash.new;
my %h;
for flat @headers».kv -> $k, $v {
    if $seen ∋ $k {
        %h{$k}.push: $v;
    }
    else {
        %h{$k} = [$v];
        $seen{$k} = True;
    }
}
say %h.sort.map({ "{.key}={.value.join('+')}" }).join(' ');
--- expect
Accept=a+b Host=h

