# Building strings: interpolation forms, heredocs and Q adverbs, x / ~ / ~= / [~] / join, leg/cmp, trans, S///, sprintf corners.

=== str-interp-method-call-parens
from: Cro::Core 0.8.10 lib/Cro/MediaType.rakumod:123
license: Artistic-2.0
feature: node InterpStr
--- code
my $out = 'text/html';
for (charset => 'utf-8', q => '0.9') -> $p {
    my $prefix = "; $p.key()=";
    $out ~= $prefix ~ $p.value;
}
say $out;
my $p = a => 1;
say "no call: $p.key";
--- expect
text/html; charset=utf-8; q=0.9
no call: a	1.key

=== str-interp-array-zen-slice
from: Getopt::Long 0.4.2 lib/Getopt/Long.rakumod:239
license: Artistic-2.0
feature: node InterpStr
--- code
my @names = 'foo', 'b@r', '-x';
my $msg = "Invalid name(s): @names[]";
say $msg;
say "not interpolated: @names";
say "one: @names[1] and email: user@example.com";
--- expect
Invalid name(s): foo b@r -x
not interpolated: @names
one: b@r and email: user@example.com

