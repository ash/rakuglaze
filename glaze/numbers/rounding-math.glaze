10
2.7183 True

=== num-inf-abs-finite-check
from: Data::Transformers 0.0.2 lib/Data/Transformers/Rescale.rakumod:104
license: Artistic-2.0
feature: term Inf
--- code
for (0, 10, 0, 1), (-Inf, 10, 0, 1) -> ($min, $max, $vmin, $vmax) {
    if $min.abs < Inf && $max.abs < Inf && $vmin.abs < Inf && $vmax.abs < Inf {
        say 'finite';
    }
    else {
        say 'infinite';
    }
}
--- expect
finite
infinite

=== num-inf-nan-json
from: CBOR::Simple 0.1.4 lib/CBOR/Simple.rakumod:1370
license: Artistic-2.0
feature: method isNaN
--- code
sub JS-Num($v) {
    $v.isNaN   ??  'NaN'      !!
    $v ==  Inf ??  'Infinity' !!
    $v == -Inf ?? '-Infinity' !! ~$v
}
say JS-Num($_) for NaN, Inf, -Inf, 1.5e0, 1e300 * 1e300, 0e0 / 1;
--- expect
NaN
Infinity
-Infinity
1.5
Infinity
0

=== num-inf-nan-string-check
from: BDD::Behave 0.9.5 lib/BDD/Behave/Formatter/JsonEvents.rakumod:24
license: Artistic-2.0
feature: term NaN
--- code
for NaN, Inf, -Inf, 3.25, 10 -> $v {
    given $v {
        when Real { my $s = $v.Str; say $s eq 'NaN' || $s eq 'Inf' || $s eq '-Inf' ?? 'null' !! $s }
    }
}
say NaN == NaN, ' ', NaN === NaN;
