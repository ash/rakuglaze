=== num-mod-div-varint
from: HTTP::HPACK 1.0.3 lib/HTTP/HPACK.rakumod:459
license: Artistic-2.0
feature: infix mod
--- code
sub encode-int(uint $value, int $prefix, $target = Buf.new, int $upper = 0) {
    my int $limit = 2 ** $prefix - 1;
    if $value < $limit {
        $target.push($value +| $upper);
    }
    else {
        $target.push($limit +| $upper);
        my uint $cur-value = $value - $limit;
        while $cur-value > 128 {
            $target.push($cur-value mod 128 + 128);
            $cur-value = $cur-value div 128;
        }
        $target.push($cur-value);
    }
    $target
}
say encode-int(10, 5).list;
say encode-int(1337, 5).list;
--- expect
(10)
(31 154 10)

=== num-mod-div-assign-tag
from: HarfBuzz 0.1.7 lib/HarfBuzz/Raw/Defs.rakumod:57
license: Artistic-2.0
feature: infix mod
--- code
sub hb-tag-dec(UInt $enc is copy) {
    my @c;
    for 1..4 {
        @c.unshift: ($enc mod 256).chr
            if $enc;
        $enc div= 256;
    }
    @c.join;
}
say hb-tag-dec(1801810542);
say hb-tag-dec(0x6C696761);
--- expect
kern
liga

=== num-mod-batch-count
from: DSL::Shared 0.2.11 lib/DSL/Shared/Utilities/CommandProcessing.rakumod:139
license: Artistic-2.0
feature: infix mod
--- code
for (10, 3), (9, 3), (2, 5) -> ($elems, $degree) {
    my $batch = $elems div $degree;
    if $elems mod $degree { $batch++ }
    say "$elems / $degree -> $batch";
}
--- expect
10 / 3 -> 4
9 / 3 -> 3
2 / 5 -> 1

