4294967296
D76AA478 E8C7B756 242070DB C1BDCEEE

=== num-subset-real-range
from: Color 1.004001 lib/Color.rakumod:6
license: Artistic-2.0
feature: decl subset
--- code
my subset ValidRGB of Real where 0 <= $_ <= 255;
sub channel(ValidRGB $c) { $c.round }
say channel(127.6);
say channel(0);
say 256 ~~ ValidRGB, ' ', -0.1 ~~ ValidRGB, ' ', '12' ~~ ValidRGB;
say channel(300);
--- expect
128
0
False False False
!! X::TypeCheck::Binding::Parameter

=== num-subset-status-code
from: Cro::HTTP 0.8.13 lib/Cro/HTTP/Response.rakumod:67
license: Artistic-2.0
feature: decl subset
--- code
my subset StatusCode of Int where { 100 <= $_ <= 599 }
my class Response {
    has StatusCode $.status is rw = 200;
}
my $r = Response.new(status => 404);
say $r.status;
$r.status = 600;
say $r.status;
--- expect
404
!! X::TypeCheck::Assignment

