# for/loop/while/until/repeat, labels with next/last/redo, loop phasers,
# state counters and `once` — the loop shapes modules write.

=== ctl-loop-c-style-native
from: Cro::HTTP 0.8.13 lib/Cro/HTTP/RawBodyParser.rakumod:70
license: Artistic-2.0
feature: node Loop
--- code
my $buffer = Buf.new(65, 13, 10, 66, 13, 10);
my @ends;
loop (my int $i = 0; $i < $buffer.elems - 1; $i++) {
    @ends.push: $i if $buffer[$i] == 13 && $buffer[$i + 1] == 10;
}
say @ends;
--- expect
[1 4]

