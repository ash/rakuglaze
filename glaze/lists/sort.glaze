# sort as modules write it: placeholders, two-key comparators, key extractors, list keys, .= forms.

=== list-sort-placeholder-cmp
from: Data::Dump 0.0.18 lib/Data/Dump.rakumod:175
license: Artistic-2.0
feature: method sort
--- code
my @meths = <new say gist Str>;
for @meths.sort({$^a cmp $^b}) -> $meth {
    say $meth;
}
--- expect
Str
gist
new
say

=== list-sort-two-keys-or
from: BDD::Behave 0.9.5 lib/BDD/Behave/Runner.rakumod:368
license: Artistic-2.0
feature: method sort
--- code
my @summaries = { description => 'b', key => 2 }, { description => 'a', key => 9 },
                { description => 'b', key => 1 };
say @summaries.sort({ $^a<description> cmp $^b<description> || $^a<key> cmp $^b<key> }).List.map(*<key>);
--- expect
(9 1 2)

=== list-sort-numeric-index-tie
from: PDF 0.6.15 lib/PDF/IO/Writer.rakumod:177
license: Artistic-2.0
feature: method sort
--- code
my @entries = [ 'c', 2, 0 ], [ 'a', 1, 5 ], [ 'b', 1, 3 ];
say @entries
    .sort({ $^a[1] <=> $^b[1] || $^a[2] <=> $^b[2] })
    .map(*[0]).join;
--- expect
bac

=== list-sort-descending-placeholder
from: BDD::Behave 0.9.5 lib/BDD/Behave/Parallel/Distribution.rakumod:148
license: Artistic-2.0
feature: method sort
--- code
my class Bucket { has $.cost }
my @buckets = (3, 10, 7).map({ Bucket.new(cost => $_) });
my @sorted = @buckets.sort({ $^b.cost <=> $^a.cost });
say @sorted.map(*.cost);
--- expect
(10 7 3)

=== list-sort-whatever-method
from: App::RaCoCo 2.0.1 lib/App/Racoco/Report/Data.rakumod:62
license: Artistic-2.0
feature: method sort
--- code
my class Part { has $.file-name }
my %parts = x => Part.new(:file-name<lib/B.rakumod>), y => Part.new(:file-name<lib/A.rakumod>);
say %parts.values.sort(*.file-name).List.map(*.file-name);
--- expect
(lib/A.rakumod lib/B.rakumod)

=== list-sort-negated-whatever
from: Cromponent 0.0.13 lib/Cromponent/MetaCromponentRole.rakumod:34
license: Artistic-2.0
feature: method sort
--- code
my @loads = sub ($a) {}, sub ($a, $b, $c) {}, sub ($a, $b) {};
for @loads.sort(-*.count) -> &load {
    say &load.count;
}
--- expect
3
2
1

=== list-sort-pairs-by-value-desc
from: Cro::HTTP 0.8.13 lib/Cro/HTTP/Message.rakumod:114
license: Artistic-2.0
feature: method sort
--- code
my @values = 'gzip' => 0.5, 'br' => 1.0, 'identity' => 0.1;
