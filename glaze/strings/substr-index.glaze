=== str-substr-whatever-minus-var
from: Collection 0.18.0 lib/Collection/Progress.rakumod:74
license: Artistic-2.0
feature: method substr
--- code
my $text-len = 12;
my $inf = 'processing chapter seventeen';
$inf = '... ' ~ $inf.substr( * - $text-len + 4 ) if $inf.chars > ( $text-len - 4 );
say $inf;
--- expect
... eventeen

=== str-substr-tail-three-ternary
from: Lingua::EN::Numbers 2.8.3 lib/Lingua/EN/Numbers.pm6:65
license: Artistic-2.0
feature: method substr
--- code
for 7, 12, 1234567 -> $denom {
    my $cen = $denom.chars > 3 ?? $denom.substr(*-3) !! $denom;
    say $cen;
}
--- expect
7
12
567

=== str-substr-whatever-range-end
from: Markdown::Grammar 0.6.4 lib/Markdown/Grammar.rakumod:18
license: Artistic-2.0
feature: method substr
--- code
for "ls -l\n", "pwd" -> $command {
    my $ending = $command.substr(*- 1, *) eq "\n" ?? '' !! "\n";
    say $ending.raku;
}
--- expect
""
"\n"

=== str-substr-ampersand-call
from: PDF 0.6.15 lib/X/PDF.rakumod:90
license: Artistic-2.0
feature: method substr
--- code
my $input = ('abcdefghij' x 8);
say $input.chars > 60
    ?? [~] $input.&substr(0, 32), ' ... ', $input.&substr(*-20)
    !! $input;
--- expect
abcdefghijabcdefghijabcdefghijab ... abcdefghijabcdefghij

=== str-substr-trailing-loop
from: Template::Jinja2 0.3.0 lib/Template/Jinja2/Filters.rakumod:60
license: Artistic-2.0
feature: method substr
--- code
my @chs = <x y>;
my $s = 'abcxyxy';
while $s.chars > 0 && $s.substr(*-1, 1) eq any(@chs) {
    $s = $s.substr(0, *-1);
}
say $s;
--- expect
abc

