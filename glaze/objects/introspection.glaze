=== obj-attribute-sort-by-str
from: Data::Dump 0.0.18 lib/Data/Dump.rakumod:156
license: Artistic-2.0
feature: method attributes
--- code
my class P { has $.z = 1; has @.a = 2, 3; has %!m = k => 4 }
my $obj = P.new;
my @attrs    = try { $obj.^attributes.sort({ $^x.Str cmp $^y.Str }) } // @();
for @attrs -> $attr {
    say $attr.Str, ' => ', $attr.get_value($obj).raku;
}
--- expect
$!z => 1
%!m => {:k(4)}
@!a => [2, 3]

