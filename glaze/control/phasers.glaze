=== ctl-return-from-for-in-sub
from: Algorithm::KDimensionalTree 0.1.2 lib/Algorithm/KDimensionalTree.rakumod:122
license: Artistic-2.0
feature: sub return
--- code
sub first-big(@points) {
    return %() if @points.elems == 0;
    for @points -> $p {
        if $p > 10 {
            return %(point => $p);
        }
    }
    %(point => Nil)
}
say first-big([]).elems;
say first-big([1, 20, 30])<point>;
say first-big([1, 2])<point>.raku;
--- expect
0
20
Any

=== ctl-return-from-map-block
from: CSS::Properties 0.10.9 lib/CSS/Properties.rakumod:479
license: Artistic-2.0
feature: sub return
--- code
sub coerce-str($v) { $v ~~ Str ?? $v !! Nil }
sub join-all(@values) {
    @values.map({ coerce-str($_) // return }).join: ' ';
}
say join-all(<a b c>);
say join-all(['a', 1, 'c']).raku;
--- expect
a b c
Nil

