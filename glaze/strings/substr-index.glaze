19

=== str-rindex-from-position
from: Map::Match 0.0.10 lib/Map/Match.rakumod:70
license: Artistic-2.0
feature: method rindex
--- code
my $keys = "alpha\0beta\0gamma";
my $left = $keys.rindex("\0", 12);
say $left;
say $keys.rindex("\0", 5);
say $keys.rindex("\0", 4) // 'Nil';
--- expect
10
5
Nil

=== str-flip-comb-thousands
from: FStrings 0.0.1 lib/FStrings.rakumod:40
license: Artistic-2.0
feature: method flip
--- code
my $sep = ',';
for '1234567', '999', '1000' -> $int-part is copy {
    $int-part = $int-part.flip.comb(3).join($sep).flip;
    say $int-part;
}
--- expect
1,234,567
999
1,000

=== str-flip-split-hyper-flip
from: HTTP::Tiny 0.2.6 lib/HTTP/Tiny.rakumod:393
license: Artistic-2.0
feature: method flip
--- code
my $authority = 'user:p@ss@example.com';
my ( $host, $auth ) = $authority.flip.split( '@', 2 )».flip;
say $host;
say $auth;
--- expect
example.com
user:p@ss

=== str-flip-comb-hyper-reverse
from: Rakuast::RakuDoc::Render 1.1.4 lib/RakuDoc/Numeration.rakumod:580
license: Artistic-2.0
feature: method flip
--- code
my $num = '123456789';
my @chunks = $num.flip.comb(4)».flip.reverse;
