=== hash-typed-value-classify
from: CSS::Writer 0.3.3 lib/CSS/Writer.rakumod:396
license: Artistic-2.0
feature: typed hash
--- code
my $ast = [{ comment => 'c1' }, 'x', 'y', { comment => 'c2' }];
my Array %sifted = classify { .isa(Hash) && (.<comment>:exists) ?? 'comment' !! 'elem' }, $ast.list;
my Str $out = (%sifted<elem> // []).list.join: ',';
