# Cutting strings: substr, substr-rw, index, rindex, flip.

=== str-substr-from-offset
from: Actionable 0.0.7 lib/Actionable.rakumod:177
license: Artistic-2.0
feature: method substr
--- code
my class Attr { has $.name }
for Attr.new(name => '$!colour'), Attr.new(name => '@!items') -> $attr {
    my $name = $attr.name.substr(2);
    say $name;
}
--- expect
colour
items

=== str-substr-prefix-loop
from: Abbreviations 2.2.3 lib/Abbreviations.rakumod:155
license: Artistic-2.0
feature: method substr
--- code
my $word = 'hello';
for 1..$word.chars {
    my $abbrev = $word.substr(0, $_);
    print $abbrev, ' ';
}
say '';
--- expect
h he hel hell hello 

=== str-substr-whatever-end
from: Air::Plugin::Hilite 0.0.10 lib/Air/Plugin/Hilite.rakumod:52
license: Artistic-2.0
feature: method substr
--- code
my @js-links = '"a.js"', '"lib/b.js"';
@js-links .= map: *.substr(1,*-1);
say @js-links.join('|');
--- expect
a.js|lib/b.js

=== str-substr-chars-of-prefix
from: BDD::Behave 0.9.5 lib/BDD/Behave/Bisect.rakumod:181
license: Artistic-2.0
feature: method substr
--- code
my @executed;
for 'behave-executed: t/a.t', 'behave-executed: t/b.t' -> $line {
    @executed.push: $line.substr('behave-executed: '.chars);
}
say @executed;
--- expect
[t/a.t t/b.t]

=== str-substr-offset-and-tail-whatever
from: Bailador 0.0.19 lib/Bailador/Gradual.pm:37
license: MIT
feature: method substr
--- code
my $views = 'views';
my @pages;
for 'views/index.html.tmpl', 'views/about.html.tmpl' -> $thing {
    @pages.append($thing.substr(1 + $views.chars, *-10));
}
say @pages;
--- expect
[index about]

