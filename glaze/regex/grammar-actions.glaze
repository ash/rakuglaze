=== rx-made-chain-key-value
from: Docker::File 1.1 lib/Docker/File.rakumod:531
license: Artistic-2.0
feature: call make
--- code
my grammar KV {
    token TOP { <pair>+ % \s+ }
    token pair { <key> '=' <value> }
    token key { \w+ }
    token value { \S+ }
}
my class KVA {
    method TOP($/) { make $<pair>».made.Map }
    method pair($/) { make $<key>.made => $<value>.made; }
    method key($/) { make $/.uc }
    method value($/) { make ~$/ }
}
my $map = KV.parse('a=1 b=two c=3', :actions(KVA)).made;
say $map.keys.sort.map({ "$_={$map{$_}}" }).join(' ');
