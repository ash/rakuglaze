None
True

=== obj-role-attr-rolename-colon-D-method
from: Font::FreeType 0.5.16 lib/Font/FreeType/Raw.rakumod:98
license: Artistic-2.0
feature: method clone
--- code
my role Copyable {
    has @.data;
    method clone(::?ROLE:D: --> ::?ROLE:D) {
        my $c = self.bless(data => @!data.clone);
        $c
    }
}
my class Rec does Copyable { }
my $a = Rec.new(data => [1, 2]);
my $b = $a.clone;
$b.data.push: 3;
say $a.data, ' ', $b.data, ' ', $b.^name;
Rec.clone;
--- expect
[1 2] [1 2 3] Rec
!! X::Parameter::InvalidConcreteness
