=== num-shift-assign-leb128
from: LEB128 1.0 lib/LEB128.pm6:8
license: Artistic-2.0
feature: infix +>
--- code
sub encode-leb128-signed(Int $value is copy, Buf $target, int $offset = 0 --> int) {
    my int $cur-offset = $offset;
    my Bool $more;
    repeat while $more {
        my uint $byte = $value +& 0b0111_1111;
        $value +>= 7;
        $more = not (($value == 0 && $byte +& 0x40 == 0) ||
                 ($value == -1 && $byte +& 0x40 != 0));
        $byte +|= 0b1000_0000 if $more;
        $target[$cur-offset++] = $byte;
    }
    $cur-offset - $offset
}
for 2, -2, 127, -123456 {
    my $b = Buf.new;
    my $n = encode-leb128-signed($_, $b);
    say "$_: $n {$b.list.fmt('%02x')}";
}
--- expect
2: 1 02
-2: 1 7e
127: 2 ff 00
-123456: 3 c0 bb 78

=== num-shift-mask-fields
from: IRC::Log 0.0.26 lib/IRC/Log.rakumod:36
license: Artistic-2.0
feature: infix +>
--- code
my sub hmon2hour(      uint32 $hmon) { $hmon +> 27 +&      0x001f }
my sub hmon2minute(    uint32 $hmon) { $hmon +> 21 +&      0x003f }
my sub hmon2ordinal(   uint32 $hmon) { $hmon +> 12 +&      0x01ff }
my sub hmon2nick-index(uint32 $hmon) { $hmon       +&      0x0fff }
my uint32 $hmon = 13 +< 27 +| 42 +< 21 +| 300 +< 12 +| 77;
say hmon2hour($hmon), ':', hmon2minute($hmon);
say hmon2ordinal($hmon), ' ', hmon2nick-index($hmon);
--- expect
13:42
300 77

=== num-shift-make-mask
from: Util::Bitfield 0.1.0 lib/Util/Bitfield.rakumod:141
license: Artistic-2.0
feature: infix +<
--- code
sub make-mask(Int $bits, Int $start = 0, Int $word-size = 32, Bool :$invert) {
    my $ret = (((1 +< $bits) - 1) +< ($word-size - ($bits + $start)));
    if $invert {
        $ret = ((2 ** $word-size) - 1) +^ $ret;
    }
    $ret;
}
sub extract-bits(Int $value, Int $bits, Int $start = 0, Int $word-size = 32) {
    ($value +& make-mask($bits, $start, $word-size)) +> ( $word-size - ( $bits + $start));
}
say make-mask(4, 0, 8).base(2);
say make-mask(4, 0, 8, :invert).base(2);
say extract-bits(0b1011_0110, 3, 1, 8);
--- expect
11110000
1111
3

