=== hk-12-self-call-redo
from: Terminal::LineEditor 0.0.23 lib/Terminal/LineEditor/EditableBuffer.rakumod:179
license: Artistic-2.0
feature: method call on self inside a method
--- code
my class Buffer {
    has @!records;
    method do-redo-record($record) { @!records.push($record); @!records.elems }
    method redo-last($record) { self.do-redo-record($record); @!records.join(',') }
}
say Buffer.new.redo-last('insert a')
--- expect
insert a

=== hk-12-slurpy-forward
from: ORM::ActiveRecord 0.9.4 lib/ORM/ActiveRecord/Model/Relations.rakumod:25
license: Artistic-2.0
feature: slurpy positional and named forwarded with |
--- code
my class Query {
    method includes(*@names, *%kw) { @names.join(' ') ~ ' ' ~ %kw.keys.sort.join(' ') }
}
my class Model {
    method all { Query.new }
    method includes(*@names, *%kw) { self.all.includes(|@names, |%kw) }
}
say Model.new.includes('posts', 'tags', :limit)
--- expect
posts tags limit

=== hk-12-grammar-alias-params
from: Text::CodeProcessing 0.6.0 lib/Text/CodeProcessing.rakumod:203
license: Artistic-2.0
feature: grammar capture alias with grouped rule
--- code
my grammar Org {
    token org-list-of-params { \w+ [',' \w+]* }
    token TOP { 'cmd' [ \h+ $<params>=(<org-list-of-params>) ]? \h* }
}
say ~Org.parse('cmd a,b')<params>
--- expect
a,b

=== hk-12-infix-in-and-condition
from: WWW::OpenAI 0.3.20 lib/WWW/OpenAI/Request.rakumod:211
license: Artistic-2.0
feature: infix ∈ in a condition with &&
--- code
my sub pick($url, $format, $res) {
    if $url.contains(/transcriptions | translations/) && $format.lc ∈ <text srt vtt> { return $res }
    'raw'
}
say pick('/v1/audio/transcriptions', 'SRT', 'text-out');
say pick('/v1/chat', 'srt', 'text-out')
--- expect
text-out
raw

=== hk-12-elsif-topic-key
from: Terminal::Widgets 0.3.2 lib/Terminal/Widgets/Terminal.rakumod:143
license: Artistic-2.0
feature: elsif with topic method call on key
--- code
my constant FocusOut = 2;
my class Term {
    has $!terminal-focused = True;
    method handle(@events) {
        for @events {
            if .key == 1 { say 'focus-in' }
            elsif .key == FocusOut { $!terminal-focused = False }
        }
        $!terminal-focused
    }
}
say Term.new.handle([1 => 'x', 2 => 'y'])
--- expect
focus-in
False

=== hk-12-named-concat-arg
from: Terminal::Widgets 0.3.2 lib/Terminal/Widgets/TopLevel.rakumod:104
license: Artistic-2.0
feature: named argument from concatenated string
--- code
my class Target { method gist-name { 'button' } }
my class Top {
    method debug-elapsed($t0, :$desc) { say "$desc from $t0" }
    method focus-on($target, $t0) {
        self.debug-elapsed($t0, desc => 'focus-on processed for ' ~ $target.gist-name);
    }
}
Top.new.focus-on(Target.new, 0)
--- expect
focus-on processed for button from 0

