=== str-indent-map-whatever
from: Getopt::Long 0.4.2 lib/Getopt/Long.rakumod:777
license: Artistic-2.0
feature: method indent
--- code
my @option-descs = '--verbose  say more', '--help  this text';
my @lines = flat "Usage:", ('', 'prog', '[options...]').join(' '), '', @option-descs.map(*.indent(4));
.say for @lines;
--- expect
Usage:
 prog [options...]

    --verbose  say more
    --help  this text

=== str-indent-negative-and-computed
from: Pakku celastrina.6 lib/Pakku/Command/Help.rakumod:400
license: Artistic-2.0
feature: method indent
--- code
my $indent = 10;
for (add => 'install', rm => 'remove') {
    say .key ~ ' → '.indent( $indent - .key.chars ) ~ .value;
}
say "    four\n  two".indent(-2);
--- expect
add        → install
rm         → remove
  four
two
