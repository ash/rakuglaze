=== num-method-bool-int
from: Gnome::N 0.1.54 lib/Gnome/N/GnomeRoutineCaller.rakumod:545
license: Artistic-2.0
feature: method Bool
--- code
for Bool, Int -> $type {
    my $v = [1];
    my $c = $type ~~ Bool ?? $v[0].Bool !! $v[0].Int;
    say "{$c.^name} $c";
}
say 0.Bool, ' ', 0.0.Bool, ' ', "0".Bool, ' ', "".Bool, ' ', 0e0.Bool, ' ', NaN.Bool;
--- expect
Bool True
Int 1
False False True False False True
