# Grouping into hashes as modules do: classify and categorize (method and
# sub forms, :as), then reshaping the groups with map, deepmap and »;
# filtering and mapping a hash's pairs.

=== hash-classify-key-map-pairs
from: App::RaCoCo 2.0.1 lib/App/Racoco/CoveredLinesCollector.rakumod:52
license: Artistic-2.0
feature: method classify
--- code
my @lines = (a => 3), (b => 1), (a => 7);
my %by = @lines
    .classify({ $_.key })
    .map({ $_.key => $_.value.map(*.value).sum });
say %by.sort.map({ "{.key}={.value}" }).join(' ');
--- expect
a=10 b=1

=== hash-classify-join-key
from: Data::Reshapers 0.3.8 lib/Data/Reshapers.rakumod:367
license: Artistic-2.0
feature: method classify
--- code
my $data = [{ g => 'x', h => 1, v => 10 }, { g => 'x', h => 1, v => 20 }, { g => 'y', h => 2, v => 5 }];
my @vars = <g h>;
my $sep = '.';
my %res = $data.classify(-> $row { @vars.map({ $row{$_} }).join($sep) });
say "{.key}: {.value.map(*<v>).join(',')}" for %res.sort;
--- expect
x.1: 10,20
y.2: 5

=== hash-classify-whatever-split
from: Terminal::Widgets 0.3.2 lib/Terminal/Widgets/I18N/Translation.rakumod:95
license: Artistic-2.0
feature: method classify
--- code
my @available = <en-US en-GB fr de-AT de>;
my $shortened = @available.classify(*.split('-')[0]);
say $shortened ~~ Hash;
say "{.key}: {.value}" for $shortened.sort;
--- expect
True
de: de-AT de
en: en-US en-GB
fr: fr

=== hash-classify-as-value
from: Red 0.2.5 lib/MetamodelX/Red/Model.rakumod:78
license: Artistic-2.0
feature: method classify
--- code
my @constraints = (unique => 'email'), (pk => 'id'), (unique => 'login'), (unique => 'email');
my %c = @constraints.unique.classify: *.key, :as{ .value };
say "{.key}: {.value}" for %c.sort;
