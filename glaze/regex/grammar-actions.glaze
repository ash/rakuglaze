=== rx-json-proto-sym-values
from: JSON::Tiny 1.0 lib/JSON/Tiny/Grammar.pm:18
license: Artistic-2.0
feature: decl token
--- code
my grammar J {
    token TOP       { \s* <value> \s* }
    rule array      { '[' ~ ']' <arraylist>    }
    rule arraylist  {  <value> * % [ \, ]        }
    proto token value {*};
    token value:sym<number> { '-'? [ 0 | <[1..9]> <[0..9]>* ] [ \. <[0..9]>+ ]? }
    token value:sym<true>    { <sym>    };
    token value:sym<false>   { <sym>    };
    token value:sym<null>    { <sym>    };
    token value:sym<array>   { <array>  };
}
my class JA {
    method TOP($/) { make $<value>.made };
    method array($/) { make $<arraylist>.made.item }
    method arraylist($/) { make [$<value>.map(*.made)] }
    method value:sym<number>($/) { make +$/.Str }
    method value:sym<true>($/)   { make Bool::True  }
    method value:sym<false>($/)  { make Bool::False }
    method value:sym<null>($/)   { make Any }
    method value:sym<array>($/)  { make $<array>.made }
}
say J.parse('[1, -2.5, [true, null], false]', :actions(JA)).made.raku;
say J.parse('[01]').so;
--- expect
$[1, -2.5, [Bool::True, Any], Bool::False]
False

=== rx-json-string-escapes
from: JSON::Tiny 1.0 lib/JSON/Tiny/Actions.pm:28
license: Artistic-2.0
feature: method made
--- code
my grammar S {
    token TOP { <string> }
    token string { ('"') ~ \" [ <str> | \\ <str=.str_escape> ]* }
    token str { <-["\\\t\x[0A]]>+ }
    token str_escape { <["\\/bfnrt]> | 'u' <utf16_codepoint>+ % '\u' }
    token utf16_codepoint { <.xdigit>**4 }
}
my class SA {
    my %h = '\\' => "\\", '/' => "/", 'n' => "\n", 't' => "\t", '"' => "\"";
    method TOP($/) { make $<string>.made }
    method string($/) {
        make +@$<str> == 1 ?? $<str>[0].made !! $<str>>>.made.join;
    }
    method str($/) { make ~$/ }
    method str_escape($/) {
        if $<utf16_codepoint> {
            make utf16.new( $<utf16_codepoint>.map({:16(~$_)}) ).decode();
        } else {
            make %h{~$/};
        }
    }
}
say S.parse(Q{"plain"}, :actions(SA)).made;
say S.parse(Q{"a\tb\"c\u00e9\ud83d\ude00"}, :actions(SA)).made.raku;
--- expect
plain
"a\tb\"cé😀"

=== rx-hash-of-pairs-made
from: JSON::Tiny 1.0 lib/JSON/Tiny/Actions.pm:7
license: Artistic-2.0
feature: method made
--- code
my grammar O {
    rule TOP      { '{' ~ '}' <pairlist> }
    rule pairlist { <pair> * % \, }
    rule pair     { (\w+) ':' (\d+) }
}
my class OA {
    method TOP($/) { make $<pairlist>.made.hash.item; }
    method pairlist($/) { make $<pair>>>.made.flat; }
    method pair($/) { make ~$0 => +$1 }
}
my $h = O.parse('{ b: 2, a: 1 }', :actions(OA)).made;
say $h.WHAT.^name, ' ', $h.sort.map({ "{.key}={.value}" }).join(',');
say O.parse('{}', :actions(OA)).made.elems;
--- expect
Hash a=1,b=2
0

=== rx-parametric-multi-rules
from: PDF::Tags 0.2.8 lib/PDF/Tags/XPath/Grammar.rakumod:22
license: Artistic-2.0
feature: decl rule
--- code
my grammar Q {
    rule TOP { <expr(3)> }
    multi rule expr(0)       { <term> }
    multi rule expr($pred)   { <term=.expr($pred-1)> +% <q-op($pred-1)> }
    multi token q-op(2) {or}
    multi token q-op(1) {and}
    multi token q-op(0) {'='|'!='}
    token term { \w+ }
}
my $m = Q.parse('a = b and c or d != e');
say $m<expr><term>.map(~*).join(' | ');
say $m<expr><q-op>.map(~*).join(',');
--- expect
a = b and c  | d != e
or

=== rx-sym-colonpair-multi-rules
from: Red 0.2.5 lib/Red/Driver/SQLite/SchemaReader.rakumod:19
license: Artistic-2.0
feature: decl rule
--- code
my grammar CreateTable {
    rule  TOP                      { :i <create-table>+ %% ";" }
    rule  create-table             { :i CREATE TABLE <table-name=.name> '(' ~ ')' <column>+ %% [ "," ] }
    token name                     { :i \w+ }
    rule  column                   { :i <column-name=.name> <type=.name> <modifier>? }
    proto rule modifier            {*}
    multi rule modifier:<null>     { :i NULL }
    multi rule modifier:<not-null> { :i NOT NULL }
}
my class Act {
    method TOP($/)                 { make $<create-table>».made }
    method create-table($/)        { make $<table-name>.Str ~ ': ' ~ $<column>».made.join(', ') }
    method column($/)              { make "$<column-name> " ~ ($<modifier>.made // True) }
    method modifier:<null>($/)     { make ( :nullable ) }
    method modifier:<not-null>($/) { make ( :!nullable ) }
}
.say for CreateTable.parse('create table t (id INTEGER NOT NULL, name TEXT null, x int);', :actions(Act)).made;
--- expect
t: id nullable	False, name nullable	True, x True

=== rx-sym-alternative-word
from: MUGS::Games 0.1.4 lib/MUGS/Server/Game/Adventure/CommandParser.rakumod:25
license: Artistic-2.0
feature: decl rule
ruled: Raku++ captures $<sym> where the token says <sym>; Rakudo 2026.09 leaves it unset
--- code
my grammar Cmd {
    rule TOP { ^ <command> $ }
    proto rule command          {*}
    rule command:sym<quit>      { [ 'q' | <sym> ] }
    rule command:sym<inventory> { [ 'i' | <sym> ] }
    rule command:sym<look>      { <sym> }
}
for <q quit i inventory look jump> -> $in {
    with Cmd.parse($in) { say "$in -> {.<command>.Str} {.<command><sym> // 'no sym capture'}" }
    else { say "$in -> ?" }
}
--- expect
q -> q no sym capture
quit -> quit quit
i -> i no sym capture
inventory -> inventory inventory
look -> look look
jump -> ?

=== rx-proto-yada-regex
from: Text::ShellWords 0.1.1 lib/Text/ShellWords.rakumod:66
license: Artistic-2.0
feature: decl regex
--- code
my grammar Words {
    token TOP { \s* <word>* % \s+ \s* }
    token word { <atom> + }
    proto regex atom { <...> }
    token atom:sym<backslashed> { \\ ( . ) }
    token atom:sym<single-str> { "'" ~ "'" (<-[']> *) }
    token atom:sym<simple> { <-[\s\\']> }
}
my class WA {
    has Bool $.keep;
    method TOP($/) { make $<word>.map(*.made) }
    method word($/) { make $<atom>».made.join }
    method atom:sym<backslashed>($/) { make ~ ($!keep ?? $/ !! $0) }
    method atom:sym<single-str>($/) { make ~ ($!keep ?? $/ !! $0) }
    method atom:sym<simple>($/) { make ~$/ }
}
say Words.parse(Q{ls 'my file' a\ b}, :actions(WA.new)).made.raku;
say Words.parse(Q{ls 'my file' a\ b}, :actions(WA.new(:keep))).made.raku;
--- expect
("ls", "my file", "a b").Seq
("ls", "'my file'", "a\\ b").Seq

