# gather/take, lazy, and the sequence operator (..., ...^, ^...).

=== list-gather-block-take
from: Graph 0.1.3 lib/Graph.rakumod:715
license: Artistic-2.0
feature: prefix gather
--- code
sub evens($n) {
    return gather {
        for ^$n { take $_ if $_ %% 2 }
    }
}
say evens(7);
say evens(7).^name;
--- expect
(0 2 4 6)
Seq

=== list-gather-for-take-pair
from: CPAN::Uploader::Tiny 0.1.0 lib/CPAN/Uploader/Tiny.rakumod:40
license: Artistic-2.0
feature: prefix gather
--- code
my @line = 'user ash', 'password x', 'bogus';
my %config = gather for @line -> $line {
    next unless $line.contains(q{ });
    take .[0] => .[1] with $line.split(q{ }, 2);
}
say %config.sort;
--- expect
(password => x user => ash)

=== list-gather-for-reverse-version
from: DBIish 0.6.9 lib/DBDish/Pg.rakumod:89
license: BSD-2-Clause
feature: prefix gather
--- code
my $ver = 150004;
$ver = Version.new((gather for ^3 { take $ver mod 100; $ver div= 100 }).reverse);
say $ver;
--- expect
v15.0.4

=== list-gather-take-for-modifier
from: ORM::ActiveRecord 0.9.4 lib/ORM/ActiveRecord/Relation/Query/Batching.rakumod:55
license: Artistic-2.0
feature: call take
--- code
my @batches = [1, 2], [3], [4, 5];
my @all = gather for @batches -> @batch {
    take $_ for @batch;
};
say @all;
--- expect
[1 2 3 4 5]

=== list-gather-take-slip-sorted
from: Collection 0.18.0 lib/Collection.rakumod:167
license: Artistic-2.0
feature: call slip
--- code
my %tree = root => <b a>, a => <z y>, b => ();
sub recurse($node) {
    gather for %tree{$node}.list {
        take $_;
        take slip sort recurse $_ if %tree{$_};
    }
}
say recurse('root');
--- expect
(b a y z)

=== list-gather-unique-deepmap
from: Collection 0.18.0 lib/Collection/RefreshPlugins.rakumod:81
license: Artistic-2.0
feature: prefix gather
--- code
my %config = plugins-required => { a => <x y>, b => <y z> };
my @required = (gather for %config<plugins-required>.values { take .list.Slip }).unique;
say @required.sort;
--- expect
(x y z)

=== list-gather-while-shift
from: DOM::Tiny 0.5.2 lib/DOM/Tiny/CSS.pm6:430
license: Artistic-2.0
feature: prefix gather
--- code
my %kids = a => <b c>, b => <d>;
my @search = 'a';
my @found = gather while @search.shift -> $current {
    take $current;
    @search.append: |(%kids{$current} // ());
};
say @found;
--- expect
[a b c d]

=== list-lazy-gather-assign
from: Intl::UserLanguage 0.4.0 lib/Intl/UserLanguage.pm6:87
license: Artistic-2.0
feature: prefix lazy
--- code
my $calls = 0;
my @languages = lazy gather {
    for <en de fr> { $calls++; take $_ }
};
say @languages.is-lazy;
say @languages[0];
say $calls;
say @languages.elems;
say $calls;
--- expect
True
en
1
!! X::Cannot::Lazy

=== list-lazy-gather-bind-array
from: Intl::UserLanguage 0.4.0 lib/Intl/UserLanguage.pm6:87
license: Artistic-2.0
feature: prefix lazy
--- code
my $calls = 0;
my @languages := lazy gather {
    for <en de fr> { $calls++; take $_ }
};
say @languages.is-lazy;
say @languages[0];
say $calls;
say @languages.elems;
--- expect
!! X::TypeCheck::Binding

=== list-is-lazy-check
from: Data::Dump::Tree 2.9.4 lib/Data/Dump/Tree/DescribeBaseObjects.rakumod:21
license: Artistic-2.0
feature: method is-lazy
--- code
for (1..*), (1..5), (1, 2 ... *).Seq, (1..3).map(* * 2) -> $s {
    if $s.is-lazy { say 'lazy' }
    else { say $s.elems }
}
--- expect
lazy
5
lazy
3

=== list-sequence-whatever-arith
from: Air 0.1.32 lib/Air/Form.rakumod:282
license: Artistic-2.0
feature: infix ...
--- code
my ($start, $step) = 2, 3;
my @seq   = $start, $start + $step ... *;
say @seq[^4];
say @seq.is-lazy;
--- expect
(2 5 8 11)
True

=== list-sequence-geometric
from: PDF 0.6.15 lib/PDF/COS/Type/XRef.rakumod:98
license: Artistic-2.0
feature: infix ...
--- code
my @index = 0, 5, 10, 2, 20, 3;
my \n = [+] @index[1, 3 ... *];
say n;
--- expect
10

=== list-sequence-strings-repeat-last
from: Getopt::Long 0.4.2 lib/Getopt/Long.rakumod:366
license: Artistic-2.0
feature: infix ...
--- code
my Str @ordinals = <first second third some> ... *;
say @ordinals[^6];
--- expect
(first second third some somd somc)

=== list-sequence-closure-newton
from: Digest 1.1.0 lib/Digest/SHA2.rakumod:17
license: Artistic-2.0
feature: infix ...
--- code
my $N = 1000;
my $p = 2;
my @approx = (40, { ( ($p-1) * $^x + $N div $x**($p-1) ) div $p } ... *);
say @approx[^6];
--- expect
(40 32 31 31 31 31)

=== list-sequence-descending-endpoint
from: MVC::Keayl 0.9.2 lib/MVC/Keayl/Helpers/Options.rakumod:133
license: Artistic-2.0
feature: infix ...
--- code
for (2020, 2023), (2023, 2020) -> ($from, $to) {
    my @years = $from <= $to ?? ($from .. $to).list !! ($from ... $to).list;
    say @years;
}
--- expect
[2020 2021 2022 2023]
[2023 2022 2021 2020]

=== list-sequence-exclusive-end
from: Getopt::Advance 1.2.0 lib/Getopt/Advance/Parser.rakumod:395
license: MIT
feature: infix ...^
--- code
my @order = <c a b>;
my %order;
%order{ @order } = 0 ...^ +@order;
say %order.sort(*.value).map(*.key);
--- expect
(c a b)

=== list-sequence-every-other-whatever
