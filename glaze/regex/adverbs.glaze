=== rx-m-g-env-placeholders
from: Sparrow6 0.0.96 lib/Sparrow6/DSL/Common.rakumod:136
license: Artistic-2.0
feature: regex adverb :g
--- code
my %env = HOME => '/home/u', USER => 'u';
my $val = 'path=.env[HOME]/x by .env[USER] .env[NOPE]';
for $val ~~ m:g/".env[" (\w+) "]"/ -> $e {
    my $name = $e[0].Str;
    $val = $val.subst(".env[$name]", %env{$name} // '');
}
say $val;
--- expect
path=/home/u/x by u 

=== rx-m-s-word-boundary-named
from: Font::AFM 1.24.10 lib/Font/AFM.rakumod:424
license: Artistic-2.0
feature: regex adverb :s
--- code
my %kern;
for 'KPX A V -80', 'KPX .notdef B 5', 'XKPX a b 1', 'KPX T o -18' {
    next unless m:s/ <|w> KPX  $<glyph1>=['.'?\w+] $<glyph2>=['.'?\w+] $<kern>=[< + - >?\d+] /;
    %kern{ $<glyph1> }{ $<glyph2> } = $<kern>.Int;
}
for %kern.keys.sort -> $a { say $a, ' ', %kern{$a}.sort.map({ "{.key}={.value}" }).join(',') }
--- expect
.notdef B=5
A V=-80
T o=-18

=== rx-m-s-capture-markers-coerced
from: Font::AFM 1.24.10 lib/Font/AFM.rakumod:432
license: Artistic-2.0
feature: regex <( )>
--- code
given 'C 65 ; WX 722 ; N A ; B 15 0 706 674 ; L f fi ;' {
    my Str $name  = ~ m:s/ <|w> N <(<[ \x21..\x7F ]>+)> ';' /;
    my Numeric $wx    = + m:s/ <|w> WX <(\d+)>     ';' /;
    say "$name $wx";
    warn "no bbox: $_"
        unless m:s/ <|w> B [ (< + - >?\d+) ]+ ';' /;
    my Array $bbox = [ @0».Int ];
    say $bbox.raku;
}
--- expect
A 722
$[15, 0, 706, 674]

=== rx-comb-rx-s-sigspace
from: Font::AFM 1.24.10 lib/Font/AFM.rakumod:440
license: Artistic-2.0
feature: method comb
--- code
my %lig;
given 'C 102 ; WX 333 ; N f ; L i fi ; L l fl ;' {
    for .comb(rx:s/ L <ident> <ident> ';' /) {
        if m:s/ L <succ=.ident> <lig=.ident> / {
            %lig{$<succ>.Str} = $<lig>.Str;
        }
    }
}
say %lig.sort.map({ "{.key}->{.value}" }).join(' ');
--- expect
i->fi l->fl

