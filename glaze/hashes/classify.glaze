=== hash-grep-colon-block-pairs
from: Color::Names 2.0.0 lib/Color/Names.rakumod:24
license: BSD-2-Clause
feature: method grep
--- code
my %c = red => { rgb => [255, 0, 0] }, maroon => { rgb => [128, 0, 0] }, lime => { rgb => [0, 255, 0] };
my $r = 250;
my $threshold = 150;
my @c = %c.grep: {
    3 * abs($r - .value<rgb>[0]) < $threshold
}
say @c».key.sort;
--- expect
(red)

