license: Artistic-2.0
feature: method assign-pair make
--- code
my grammar AssignPair { token TOP { <assign-pair> }
    token assign-pair { <assign-pair-lhs> '=' <assign-pair-rhs> }
    token assign-pair-lhs { \w+ }
    token assign-pair-rhs { \d+ }
}
my class AssignPairActions {
    method assign-pair-lhs($/) { make $/.Str.uc }
    method assign-pair-rhs($/) { make $/.Int * 2 }
    method assign-pair($/) { make $<assign-pair-lhs>.made ~ ' = ' ~ $<assign-pair-rhs>.made }
    method TOP($/) { make $<assign-pair>.made }
}
say AssignPair.parse('abc=21', actions => AssignPairActions.new).made;
--- expect
ABC = 42

