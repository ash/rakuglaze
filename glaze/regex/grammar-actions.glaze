=== rx-make-method-form-str
from: Apache::LogFormat * lib/Apache/LogFormat/Compiler.pm6:84
license: Artistic-2.0
feature: method make
--- code
my grammar F {
    token TOP { <expr>+ }
    token expr { <literal> | <directive> }
    token literal { <-[\%]>+ }
    token directive { '%' <[a..z]> }
}
my class FA {
    method TOP($/) { make 'q!' ~ $<expr>».made.join("") ~ '!' }
    method expr($/) { make $<literal> ?? $<literal>.made !! "<{$<directive>.made}>" }
    method literal($/) { $/.make: $/.Str }
    method directive($/) { $/.make: $/.Str.substr(1) }
}
say F.parse('%h - %u [%t]', :actions(FA)).made;
--- expect
q!<h> - <u> [<t>]!

=== rx-array-capture-sigil
from: CSS::Module 0.7.7 lib/CSS/Module/CSS3/Colors.rakumod:113
license: Artistic-2.0
feature: method made
--- code
my grammar Rgb {
    rule TOP { :i [ 'rgba' | 'rgb' ] '(' <c>+ % ',' ')' }
    token c { \d+ }
}
my class RA {
    method TOP($/) {
        my $type = @<c> == 4 ?? 'rgba' !! 'rgb';
        make $type => @<c>».Int;
    }
}
say Rgb.parse('rgb(1, 2, 3)', :actions(RA)).made.raku;
say Rgb.parse('rgba(1,2,3,4)', :actions(RA)).made.raku;
--- expect
