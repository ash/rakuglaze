=== hash-elems-compare
from: CSS::Grammar 0.4.3 lib/CSS/Grammar/Test.rakumod:11
license: Artistic-2.0
feature: method elems
--- code
sub same(%a, %b) {
    if %a.elems != %b.elems { return False }
    for %a.kv -> $k, $v {
        return False unless %b{$k}:exists && %b{$k} eqv $v;
    }
    True
}
say same({ a => 1 }, { a => 1 });
say same({ a => 1 }, { a => 1, b => 2 });
say same({ a => 1 }, { b => 1 });
--- expect
True
False
False

