=== obj-tweak-is-copy-named
from: CSS::Module 0.7.7 lib/CSS/Module.rakumod:85
license: Artistic-2.0
feature: decl submethod
--- code
my class Module {
    has %.index;
    submethod TWEAK(:%alias, :$prop-names! is copy) {
        $prop-names = $prop-names.split(' ').List if $prop-names ~~ Str;
        %!index = $prop-names.map({ $_ => $++ });
        %!index{.key} = %!index{.value} for %alias;
    }
}
my $m = Module.new(prop-names => 'color margin', alias => { colour => 'color' });
say $m.index.sort.map(*.kv.join('=')).join(' ');
Module.new;
--- expect
color=0 colour=0 margin=1
!! X::AdHoc

=== obj-tweak-ignores-extra-named
from: CSS::Stylesheet 0.1.5 lib/CSS/Ruleset.rakumod:15
license: Artistic-2.0
feature: decl submethod
--- code
my class Ruleset {
    has $.selectors;
    has %.ast;
    submethod TWEAK(:%ast is copy, :selectors($), :properties($), |c) {
        %ast<seen> = True;
        %!ast = %ast;
    }
}
my $r = Ruleset.new(selectors => 'h1', properties => 'color: red', ast => { rule => 1 });
say $r.selectors, ' ', $r.ast.keys.sort;
--- expect
h1 (rule seen)

=== obj-clone-negated-named
from: Graph 0.1.3 lib/Graph.rakumod:499
license: Artistic-2.0
feature: method clone
--- code
my class Graph {
    has Bool $.directed = True;
    has @.edges;
    method undirected { return self.clone(:!directed); }
}
my $g = Graph.new(edges => [1 => 2]);
my $u = $g.undirected;
say $g.directed, ' ', $u.directed, ' ', $u.edges;
say $u === $g;
--- expect
True False [1 => 2]
False

=== obj-clone-colon-var-named
from: Terminal::Capabilities 0.0.21 lib/Terminal/Capabilities/Autodetect.rakumod:63
license: Artistic-2.0
feature: method clone
--- code
my class Caps {
    has Bool $.emoji-text = False;
    has Bool $.emoji-reg  = False;
    has Str  $.symbols    = 'ASCII';
}
my $under-caps = Caps.new(symbols => 'Uni1');
my ($emoji-text, $emoji-reg) = True, True;
my $caps   = $under-caps.clone(:$emoji-text, :$emoji-reg);
say $caps.symbols, ' ', $caps.emoji-text, ' ', $caps.emoji-reg;
say $under-caps.emoji-text;
--- expect
Uni1 True True
False

=== obj-clone-shares-array
from: Terminal::Table 0.1.1 lib/Terminal/Table/Frame.rakumod:286
license: MIT
feature: method clone
--- code
my class Frame {
    has @.lines;
    has @.padding = 0, 0;
    method pad(*@new-padding) { self.clone(:lines(@!lines.map(' ' ~ *)), padding => @new-padding) }
}
my $f = Frame.new(lines => <a b>);
my $p = $f.pad(1, 1);
say $p.lines, ' ', $p.padding;
say $f.lines, ' ', $f.padding;
my $c = $f.clone;
$c.lines.push: 'c';
say $f.lines.elems;
--- expect
[ a  b] [1 1]
[a b] [0 0]
3

=== obj-clone-nested-push
from: Cro::HTTP 0.8.13 lib/Cro/HTTP/Client/CookieJar.rakumod:115
license: Artistic-2.0
feature: method clone
--- code
my class Cookie { has $.name; has $.domain; has $.path = '/' }
my class CookieState { has $.cookie; has $.creation-time = 1 }
my @cookies;
my $state = CookieState.new(cookie => Cookie.new(name => 'sid'));
my ($domain, $path) = 'example.com', '/app';
given $state.cookie {
    @cookies.push: $state.clone(cookie => $_.clone(:$domain, :$path));
}
say @cookies[0].cookie.domain, @cookies[0].cookie.path, ' ', @cookies[0].cookie.name;
say $state.cookie.domain.raku;
--- expect
example.com/app sid
Any

=== obj-coerce-from-hash
from: CSS::Module 0.7.7 lib/CSS/Module/Property.rakumod:43
license: Artistic-2.0
feature: method COERCE
--- code
my class Property {
    has Str $.name;
    has Bool $.inherit = False;
    multi method COERCE(%meta) { self.new: |%meta }
}
my class Module {
    has Property() %.props;
}
my $m = Module.new(props => { color => { name => 'color', inherit => True } });
say $m.props<color>.^name, ' ', $m.props<color>.inherit;
sub prop(Property() $p) { $p.name }
say prop({ name => 'margin' });
--- expect
Property True
margin

=== obj-coerce-parse-str
from: CSS::Stylesheet 0.1.5 lib/CSS/MediaQuery.rakumod:19
license: Artistic-2.0
feature: method COERCE
--- code
my class MediaQuery {
    has @.ast;
    method parse(Str $s) { self.new(ast => $s.split(/\s* and \s*/)) }
    multi method COERCE(Str $media-query) { self.parse: $media-query }
}
my class Ruleset {
    has MediaQuery() $.media-query;
}
say Ruleset.new(media-query => 'screen and (color)').media-query.ast;
--- expect
[screen (color)]

=== obj-class-my-counter
from: DSL::Shared 0.2.11 lib/DSL/Shared/Entity/ResourceAccessSingleton.rakumod:48
license: Artistic-2.0
feature: node Class
--- code
my class ResourceAccess {
    my ResourceAccess $instance = Nil;
    my Int $numberOfInstances = 0;
    method getNumberOfInstances() { $numberOfInstances }
    method new {!!!}
    submethod instance {
        $instance = ResourceAccess.bless unless $instance;
        $numberOfInstances += 1;
        $instance;
    }
}
say ResourceAccess.instance === ResourceAccess.instance;
say ResourceAccess.getNumberOfInstances;
ResourceAccess.new;
--- expect
True
2
!! X::StubCode

