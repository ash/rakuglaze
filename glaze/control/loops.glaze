=== ctl-until-flag-block
from: BDD::Behave 0.9.5 lib/BDD/Behave/Watch/Session.rakumod:41
license: Artistic-2.0
feature: node Until
--- code
my class Session {
    has $!stop = False;
    has @.ticks;
    method run {
        until $!stop {
            @!ticks.push: @!ticks.elems;
            $!stop = True if @!ticks == 3;
        }
        self
    }
}
say Session.new.run.ticks;
--- expect
[0 1 2]

=== ctl-repeat-until-grep
from: Color::Names 2.0.0 lib/Color/Names.rakumod:30
license: BSD-2-Clause
feature: node Repeat
--- code
my %c = red => { rgb => [255, 0, 0] }, maroon => { rgb => [128, 0, 0] };
my ($r, $g, $b) = 140, 10, 10;
my $threshold = 0;
my @c;
repeat { # Find at least one close color
  @c = %c.grep: {
    3 * abs($r - .value<rgb>[0]) < $threshold and
    4 * abs($g - .value<rgb>[1]) < $threshold and
    2 * abs($b - .value<rgb>[2]) < $threshold
  }
  ++$threshold;
} until @c.elems;
say @c.map(*.key);
say $threshold;
--- expect
(maroon)
42

=== ctl-repeat-until-anon-state
from: MUGS::Core 0.1.4 lib/MUGS/Identity.rakumod:92
license: Artistic-2.0
feature: node Repeat
--- code
sub fold-name-once($n) { $n.subst(/\s\s/, ' ') }
sub fold-name(Str:D $name is copy) {
    my $folded = $name;
    repeat {
        $name   = $folded;
        $folded = fold-name-once($name);
    } until $name eq $folded || ++$ >= 4;
    $folded
}
say fold-name('a        b').raku;
say fold-name('a  b').raku;
--- expect
"a    b"
"a b"

=== ctl-repeat-while-leb128
from: LEB128 1.0 lib/LEB128.pm6:6
license: Artistic-2.0
feature: node Repeat
--- code
sub encode(Int $value is copy) {
    my $target = Buf.new;
    my int $cur-offset = 0;
    my Bool $more;
    repeat while $more {
        my uint $byte = $value +& 0b0111_1111;
        $value +>= 7;
        $more = not (($value == 0 && $byte +& 0x40 == 0) ||
                 ($value == -1 && $byte +& 0x40 != 0));
        $byte +|= 0b1000_0000 if $more;
        $target[$cur-offset++] = $byte;
    }
    $target.list.fmt('%02x', ' ')
}
say encode(2);
say encode(-123456);
say encode(624485);
--- expect
02
c0 bb 78
e5 8e 26

