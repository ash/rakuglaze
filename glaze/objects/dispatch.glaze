# Method resolution as modules use it: callsame / nextsame / callwith /
# nextwith / samewith in classes and roles, multi methods on ::?CLASS:U/:D,
# private methods, trusts, qualified calls, submethods.

=== obj-callsame-parent-fallback
from: Cro::CBOR 0.0.7 lib/Cro/CBOR.rakumod:100
license: Artistic-2.0
feature: call callsame
--- code
my class RequestDefault {
    method select($message) { 'default-parser' }
}
my class Request is RequestDefault {
    method select($message) {
        return 'cbor-parser' if $message eq 'application/cbor';
        callsame;
    }
}
say Request.select('application/cbor');
say Request.select('text/plain');
--- expect
cbor-parser
default-parser

=== obj-callsame-guard-return
from: BDD::Behave 0.9.5 lib/BDD/Behave/Formatter/Documentation.rakumod:76
license: Artistic-2.0
feature: call callsame
--- code
my class Base {
    method summary($result, Int :$seed) { "summary of $result seed={$seed // 'none'}" }
}
my class Documentation is Base {
    has Bool $!multi-file is built = False;
    method summary($result, Int :$seed) {
        return if $!multi-file;
        callsame;
    }
}
say Documentation.new.summary('ok', :seed(7));
say Documentation.new(:multi-file).summary('ok').raku;
--- expect
summary of ok seed=7
Nil

=== obj-callsame-grammar-parse-override
from: DSL::Shared 0.2.11 lib/DSL/Shared/Roles/ErrorHandling.rakumod:36
license: Artistic-2.0
feature: call callsame
--- code
my role ErrorHandling {
    method ws() {
        $*HIGHWATER = self.pos if self.pos > $*HIGHWATER;
        callsame;
    }
    method parse($target, |c) {
        my $*HIGHWATER = 0;
        my $match = callsame;
        $match ?? "parsed {$match.Str.raku}" !! "failed near $*HIGHWATER";
    }
}
my grammar Words does ErrorHandling {
    rule TOP { <w>+ % ',' }
    token w { <[a..z]>+ }
}
say Words.parse('ab, cd');
say Words.parse('ab, cd, 9');
--- expect
parsed "ab, cd"
failed near 7

=== obj-callsame-filters-mixin
from: Collection 0.18.0 lib/Collection.rakumod:41
license: Artistic-2.0
feature: call callsame
--- code
my class Cache {
    method sources { <a.rakudoc b.rakudoc c.rakudoc> }
}
my role Post-cache {
    has %!extra = %( 'b.rakudoc' => 'pod', 'new.rakudoc' => 'pod', 'gone' => Nil );
    method sources {
        (%!extra.keys.sort.grep({ %!extra{$_}.so }),
         callsame.grep({ $_ !~~ any(%!extra.keys) })).flat
    }
}
my $c = Cache.new but Post-cache;
say $c.sources;
--- expect
(b.rakudoc new.rakudoc a.rakudoc c.rakudoc)

=== obj-callsame-multi-accepts
from: DOM::Tiny 0.5.2 lib/DOM/Tiny/CSS.pm6:109
license: Artistic-2.0
feature: method ACCEPTS
--- code
my class Tag { has %.attr }
my class HasAttr {
    has $.name;
    multi method ACCEPTS(::?CLASS:D: Tag:D $current) { $current.attr{$!name}:exists }
    multi method ACCEPTS(::?CLASS:D: $) { False }
}
my class AttrIs is HasAttr {
    has $.value;
    multi method ACCEPTS(::?CLASS:D: Tag:D $current) {
        return False unless callsame;
        $current.attr{ $.name } eq $.value;
    }
}
my $sel = AttrIs.new(name => 'id', value => 'top');
say Tag.new(attr => { id => 'top' }) ~~ $sel;
say Tag.new(attr => { id => 'x' }) ~~ $sel;
say Tag.new(attr => { class => 'top' }) ~~ $sel;
say 42 ~~ $sel;
--- expect
True
False
False
False

=== obj-nextsame-else-branch
from: CSS::Writer 0.3.3 lib/CSS/Writer.rakumod:77
license: Artistic-2.0
feature: call nextsame
--- code
my class Node { method Str { 'plain node' } }
my class Writer is Node {
    has $.ast;
    method Str {
        with $.ast {
            "written: $_";
        }
        else {
            nextsame;
        }
    }
}
say Writer.new(ast => 'a{}').Str;
say Writer.new.Str;
--- expect
written: a{}
plain node

