# Regex and match adverbs: :i :g :s :c :r :x :global, on m//, rx//, .match and s///.

=== rx-m-i-in-when
from: Color 1.004001 lib/Color.rakumod:175
license: Artistic-2.0
feature: regex adverb :i
--- code
sub to-string(Str $type = 'hex') {
    do given $type {
        when m:i/^ hex \d? $/ { "hex form ($type)" }
        when m:i/^ [ rgba?d? | cmyk | hs<[vl]>a? ] $/ {
            ( my $out_type = $type ) ~~ s/d$//;
            "$out_type\(...)"
        }
        default { 'unknown' }
    }
}
say to-string($_) for <HEX hex8 rgbad CMYK hsla xyz>;
--- expect
hex form (HEX)
hex form (hex8)
rgba(...)
CMYK(...)
hsla(...)
unknown

=== rx-m-i-quoted-literal
from: Cro::WebSocket 0.8.10 lib/Cro/WebSocket/Client.rakumod:108
license: Artistic-2.0
feature: regex adverb :i
--- code
for 'WebSocket', 'websocket', 'h2c', Str -> $upgrade {
    if $upgrade && $upgrade ~~ m:i/'websocket'/ {
        say 'upgrade ok';
    }
    else {
        say 'no upgrade: ', $upgrade // '(none)';
    }
}
--- expect
upgrade ok
upgrade ok
no upgrade: h2c
no upgrade: (none)

