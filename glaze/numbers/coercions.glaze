=== num-smartmatch-int-and-range
from: DSL::Shared 0.2.11 lib/DSL/Shared/FiniteStateMachines/CoreFSM.rakumod:190
license: Artistic-2.0
feature: infix ~~
--- code
my @transitions = <idle running done>;
sub pick($n) {
    return @transitions[$n - 1] if $n ~~ Int && $n ~~ 1..@transitions;
    'none'
}
say pick(2), ' ', pick(3), ' ', pick(4), ' ', pick('2'), ' ', pick(0);
--- expect
running done none none none

=== num-smartmatch-real-both
from: BDD::Behave 0.9.5 lib/BDD/Behave/Matcher/Change.rakumod:65
license: Artistic-2.0
feature: infix ~~
--- code
for (1, 2.5), (1e0, 3), (1, 2+0i), ('1', 2) -> ($before-value, $after-value) {
    unless $before-value ~~ Real && $after-value ~~ Real {
        say "not numeric: {$before-value.^name} {$after-value.^name}";
        next;
    }
    say "delta {$after-value - $before-value}";
}
--- expect
delta 1.5
delta 2
not numeric: Int Complex
not numeric: Str Int

=== num-type-numeric-prefix
from: Actionable 0.0.7 lib/Actionable.rakumod:194
license: Artistic-2.0
feature: prefix +
--- code
my class Rec { has Int $.count; has Str $.label }
for Rec.^attributes -> $attr {
    my $elem = '0012';
    my $v = $attr.type ~~ Numeric ?? +$elem !! ~$elem;
    say "{$attr.name} {$v.raku}";
}
--- expect
$!count 12
$!label "0012"

=== num-complex-re-im-flat
from: Data::Importers 0.1.8 lib/Data/Exporters/HarwellBoeing.rakumod:175
license: Artistic-2.0
feature: method re
--- code
my @vals = 1+2i, -3.5+0i, 4i;
my @flat = @vals.map({ .re, .im }).flat;
say @flat;
say (3+4i).abs, ' ', (1+2i).conj, ' ', (2i * 2i);
say '1+2i'.Complex.^name;
--- expect
[1 2 -3.5 0 0 4]
5 1-2i -4+0i
Complex
