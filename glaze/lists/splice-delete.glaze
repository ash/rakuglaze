feature: method splice
--- code
constant PadChar = 'u';
my @a85 = <a b c>;
@a85.splice(*-1, 1, PadChar xx 5);
say @a85.join;
--- expect
abuuuuu

=== list-splice-whatever-minus-rotate
from: PDF::Class 0.5.30 lib/PDF/Function/PostScript.rakumod:101
license: Artistic-2.0
feature: method splice
--- code
my @stack = 1, 2, 3, 4, 5;
my ($n, $j) = 3, 1;
my @rolled = @stack.splice(* - $n).rotate($j);
say @rolled;
say @stack;
--- expect
[4 5 3]
[1 2]

