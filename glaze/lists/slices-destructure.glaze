lib/A.rakumod
lib/B.rakumod:extra

=== list-destructure-kv
from: Actionable 0.0.7 lib/Actionable.rakumod:257
license: Artistic-2.0
feature: decl my (list)
--- code
my $p = 'color' => 'red';
my ($k, $v) = $p.kv;
say "$k=$v";
--- expect
color=red

=== list-destructure-sorted-pair
from: Graph 0.1.3 lib/Graph.rakumod:370
license: Artistic-2.0
feature: decl my (list)
--- code
sub edge-key($from, $to) {
    my ($f, $t) = ($from, $to).sort;
    "$f-$t"
}
say edge-key('b', 'a');
say edge-key(3, 10);
--- expect
a-b
3-10

=== list-destructure-match-slice
from: IO::Socket::SSL 0.0.4 lib/IO/Socket/SSL.rakumod:10
license: MIT
feature: decl my (list)
--- code
my $uri = '[::1]:8443';
my ($host, $port) = ($uri ~~ /^'[' (.+) ']' \: (\d+)$/)[0, 1];
say ~$host;
say +$port;
--- expect
::1
8443

=== list-swap-rows
from: Math::Matrix 0.4.2 lib/Math/Matrix.rakumod:412
license: Artistic-2.0
feature: list assignment
--- code
my @clone = [1, 2], [3, 4], [5, 6];
my ($rank, $swap_row_nr) = 0, 2;
(@clone[$rank], @clone[$swap_row_nr]) = (@clone[$swap_row_nr], @clone[$rank]);
say @clone.map(*.join(',')).join(' ');
--- expect
5,6 3,4 1,2

=== list-declare-several-arrays
from: Getopt::Advance 1.2.0 lib/Getopt/Advance/Helper.rakumod:128
license: MIT
feature: decl my (list)
--- code
my (@front, @pos);
for <-a x -b y> {
    .starts-with('-') ?? @front.push($_) !! @pos.push($_);
}
say @front;
say @pos;
--- expect
[-a -b]
[x y]

=== list-plus-elems-compare
from: Getopt::Advance 1.2.0 lib/Getopt/Advance.rakumod:101
license: MIT
feature: prefix +
--- code
my @optsets;
say 'none' if +@optsets == 0;
@optsets.push: 'main';
say +@optsets;
say ?@optsets;
say @optsets == 1;
--- expect
none
1
True
True
