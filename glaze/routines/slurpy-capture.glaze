=== sig-slurpy-after-positionals
from: AttrX::Mooish 1.0.10 lib/AttrX/Mooish/Attribute.rakumod:129
license: Artistic-2.0
feature: param *@ slurpy
--- code
sub validate-option-type($name, $value, *@expected) {
    return "ok $name" if $value ~~ any(@expected);
    "$name expects " ~ @expected.map(*.^name).join(' or ')
}
say validate-option-type('lazy', True, Bool, Str);
say validate-option-type('lazy', 42, Bool, Str);
say validate-option-type('lazy', 42);
--- expect
ok lazy
lazy expects Bool or Str
lazy expects 

=== sig-slurpy-flattens-arrays
from: Astro::Utils 0.0.3 lib/Astro/Utils.rakumod:524
license: Artistic-2.0
feature: param *@ slurpy
--- code
sub ddd(*@args) {
    @args.elems ~ ': ' ~ @args.join(',')
}
say ddd(1, 2, 3);
say ddd([1, 2], [3, [4, 5]]);
say ddd((1, 2), 3);
my @a = 7, 8;
say ddd(@a, 9);
--- expect
3: 1,2,3
4: 1,2,3,4 5
3: 1,2,3
3: 7,8,9

=== sig-plus-slurpy-single-arg-rule
from: Cache::Async 0.3.4 lib/Cache/Async.rakumod:258
license: Artistic-2.0
feature: param +@ slurpy
--- code
my class Cache {
    method get($key, +@args) { "$key: {@args.elems} [{@args.join('|')}]" }
}
my $c = Cache.new;
say $c.get('k');
say $c.get('k', 1, 2);
say $c.get('k', [1, 2, 3]);
say $c.get('k', [1, 2], [3]);
--- expect
k: 0 []
k: 2 [1|2]
k: 3 [1|2|3]
