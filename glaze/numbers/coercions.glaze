=== num-numeric-str-to-num-or-int
from: BDD::Behave 0.9.5 lib/BDD/Behave/Coverage.rakumod:1237
license: Artistic-2.0
feature: method Num
--- code
for '42', '3.14', '1e3', '-7' -> $s {
    my $n = $s.contains('.') || $s.contains('e') || $s.contains('E')
    ?? $s.Num !! $s.Int;
    say "$n {$n.^name}";
}
--- expect
42 Int
3.14 Num
1000 Num
-7 Int

=== num-coerce-or-unparseable
from: Cro::WebApp 0.10.1 lib/Cro/WebApp/Form.rakumod:367
license: Artistic-2.0
feature: method Rat
--- code
sub unparseable($name, $value, %unparseable, $type) {
    %unparseable{$name} = $value;
    $type
}
my %unparseable;
for <price 9.95>, <qty abc>, <ratio 1/3> -> ($name, $value) {
    my $r = $value.defined
            ?? ($value.Rat // unparseable($name, $value, %unparseable, Rat))
            !! Rat;
    say "$name: {$r.defined ?? $r.nude.join('/') !! $r.^name}";
}
say %unparseable.keys;
--- expect
price: 199/20
qty: Rat
ratio: 1/3
(qty)

=== num-converter-pairs-by-type
from: Getopt::Long 0.4.2 lib/Getopt/Long.rakumod:121
license: Artistic-2.0
feature: method Rat
--- code
my %converter-for-type{Any:U} = (
    Pair.new(Int,      *.Int),
    Pair.new(Rat,      *.Rat),
    Pair.new(Num,      *.Num),
    Pair.new(Numeric,  *.Numeric),
    Pair.new(Complex,  *.Complex),
);
for Int, Rat, Num, Numeric, Complex -> $type {
    my $v = %converter-for-type{$type}('2.5');
    say "{$type.^name}: $v {$v.^name}";
}
--- expect
Int: 2 Int
Rat: 2.5 Rat
Num: 2.5 Num
Numeric: 2.5 Rat
Complex: 2.5+0i Complex

=== num-intstr-new
from: Crust 0.0.1 lib/Crust/Runner.pm6:72
license: Artistic-2.0
feature: type IntStr
--- code
my %options = port => '5000', host => 'localhost', workers => '04';
for %options.kv -> $k, $v {
    if $v ~~ /^<[0 .. 9]>+$/ {
        %options{$k} = IntStr.new($v.Int, $v.Str);
    }
}
for %options.sort(*.key) {
    say "{.key} {.value.^name} {.value}", .value ~~ IntStr ?? " {.value + 1}" !! "";
}
--- expect
host Str localhost
port IntStr 5000 5001
workers IntStr 04 5

=== num-intstr-multi-dispatch
from: DB::SQLite 0.7 lib/DB/SQLite/Native.rakumod:102
license: BSD-2-Clause
feature: type IntStr
--- code
multi bind(Int $n, IntStr:D $v --> Str) { "$n int {+$v}" }
multi bind(Int $n, Int:D $v --> Str)    { "$n plain-int $v" }
multi bind(Int $n, Str:D $v --> Str)    { "$n text $v" }
say bind(1, <42>);
say bind(2, 42);
say bind(3, '42');
say <42>.^name, ' ', <4.5>.^name, ' ', <1e3>.^name;
--- expect
1 int 42
2 plain-int 42
3 text 42
IntStr RatStr NumStr

=== num-val-option-value
from: MUGS::Games 0.1.4 lib/MUGS/Server/Game/Adventure/Locations.rakumod:50
license: Artistic-2.0
feature: sub val
--- code
my @options = { key => 'size', value => ' 12 ' }, { key => 'name', value => 'cave' },
              { key => 'ratio', value => '0.5' }, { flag => 'dark', negated => '' };
my %options = @options.map: {
    .<flag> ?? (~.<flag> => !.<negated>)
            !! (~.<key>  => val(~.<value> .trim))
}
for %options.sort(*.key) {
    say "{.key} => {.value} ({.value.^name})";
}
--- expect
dark => True (Bool)
name => cave (Str)
ratio => 0.5 (RatStr)
size => 12 (IntStr)

=== num-numeric-truthy-check
from: Abbreviations 2.2.3 lib/Abbreviations.rakumod:235
license: Artistic-2.0
feature: method Numeric
--- code
for <10 2 33>, <10 b 33> -> @list {
    my $is-numeric = True;
    for @list {
        $is-numeric = False unless $_.Numeric;
    }
    say $is-numeric ?? @list.sort({ $^a <=> $^b }) !! @list.sort;
}
--- expect
(2 10 33)
(10 33 b)

=== num-numeric-try-is-number
from: Data::ExampleDatasets 0.2.4 lib/Data/ExampleDatasets.rakumod:194
license: Artistic-2.0
feature: method Numeric
--- code
sub is-number-w-ws(Str $term --> Bool) {
    try { $term.Numeric };
    $! ?? False !! True
}
say is-number-w-ws($_) for ' 42 ', '1_000', '0x1F', 'abc', '3.5e2', '';
--- expect
True
True
True
False
True
True

=== num-prefix-plus-match
from: DateTime::Grammar 0.1.3 lib/DateTime/Actions/Raku.rakumod:125
license: MIT
feature: prefix +
--- code
if '09:05:30' ~~ / $<hour>=(\d+) ':' $<minute>=(\d+) ':' $<second>=(\d+) / {
    my %t = hour => +$<hour>, minute => +$<minute>, second => +$<second>;
    say %t.sort.map({ "{.key}={.value}" }).join(' ');
    say (+$<hour>).^name;
}
--- expect
hour=9 minute=5 second=30
Int

=== num-prefix-plus-range-whatever
from: Getopt::Long 0.4.2 lib/Getopt/Long.rakumod:327
license: Artistic-2.0
feature: prefix +
--- code
for '2,5', '3,' -> $spec {
    $spec ~~ / $<min>=\d* ',' $<max>=\d* /;
    my $r = ( +$<min> ) .. ($<max> ?? +$<max> !! *);
    say $r.raku;
    say 4 ~~ $r;
}
