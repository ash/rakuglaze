# Walking a hash as modules do: .kv, .pairs, .keys, .values, sorting by key
# and by value, destructuring a Pair in a signature, .invert and .antipairs.

=== hash-for-kv-pointy
from: Abbreviations 2.2.3 lib/Abbreviations.rakumod:85
license: Artistic-2.0
feature: method kv
--- code
my %m = b => <bee bear>, a => <ant>;
my @out;
for %m.kv -> $k, $abbrev-list {
    @out.push: "$k={$abbrev-list.elems}";
}
say @out.sort;
--- expect
(a=1 b=2)

=== hash-for-kv-array-param
from: App::GPTrixie 0.29 lib/GPT/FileGenerator.pm6:57
license: Artistic-2.0
feature: method kv
--- code
my %sortedh = x => [3, 1], y => [2];
for %sortedh.sort(*.key).map(|*.kv) -> $k, @v {
    say "$k: {@v.sort}";
}
--- expect
x: 1 3
y: 2

=== hash-kv-map-join
from: App::RaCoCo 2.0.1 lib/App/Racoco/RunProc.rakumod:26
license: Artistic-2.0
feature: method kv
--- code
my %vars = A => 1;
my $vars-str = %vars.kv.map(-> $k, $v { "$k=$v&&" }).join(' set ');
say $vars-str;
%vars<B> = 2;
say %vars.kv.elems;
--- expect
A=1&&
4

=== hash-kv-map-object-keyed
from: Graph 0.1.3 lib/Graph.rakumod:817
license: Artistic-2.0
feature: method kv
--- code
my %ds = a => { b => 1, c => 2 }, b => { c => 5 };
my Numeric %res{Positional} = %ds.kv.map(-> $k, %v { %v.map({ ($k, $_.key) => $_.value }) }).flat;
say %res.elems;
say %res.keys.map(*.join('-')).sort;
say %res.values.sum;
--- expect
3
(a-b a-c b-c)
8

=== hash-kv-map-subsignature
from: CSS::Writer 0.3.3 lib/CSS/Writer.rakumod:21
license: Artistic-2.0
feature: method kv
--- code
my %colors = red => { name => 'Red', rgb => [255, 0, 0] }, lime => { name => 'Lime', rgb => [0, 255, 0] };
my @v = %colors.kv.map: -> Str $name, % ( :name($), :@rgb! ) {
    $name => @rgb.join(',')
};
say @v.sort(*.key).map(*.gist).join(' | ');
--- expect
lime => 0,255,0 | red => 255,0,0

=== hash-for-pairs-sort-key
from: BDD::Behave 0.9.5 lib/BDD/Behave/Runner.rakumod:347
license: Artistic-2.0
feature: method pairs
--- code
my %by-key = beta => [1, 2], alpha => [3];
for %by-key.pairs.sort(*.key) -> $pair {
