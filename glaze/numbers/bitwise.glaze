=== num-bitor-assign-set-clear
from: BitEnum 0.5 lib/BitEnum.rakumod:37
license: Artistic-2.0
feature: infix +|
--- code
my enum Perm (Read => 4, Write => 2, Exec => 1);
my class Bits {
    has Int $.value = 0;
    method set(*@bits --> Nil)   { for @bits { $!value +|= .value } }
    method clear(*@bits --> Nil) { for @bits { $!value +&= +^ .value } }
    method toggle(*@bits --> Nil) { for @bits { $!value +^= .value } }
}
my $b = Bits.new;
$b.set(Read, Write, Exec);  say $b.value;
$b.clear(Write);            say $b.value;
$b.toggle(Read, Write);     say $b.value;
--- expect
7
5
3

