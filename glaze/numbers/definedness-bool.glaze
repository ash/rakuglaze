=== num-defined-and-what-identity
from: BDD::Behave 0.9.5 lib/BDD/Behave/Matcher/Type.rakumod:34
license: Artistic-2.0
feature: method WHAT
--- code
my class TypeMatcher {
    has Mu $.type is required;
    method matches($actual --> Bool) {
        ?($actual.defined && $actual.WHAT === $!type);
    }
}
my $m = TypeMatcher.new(type => Int);
say $m.matches(42), ' ', $m.matches(Int), ' ', $m.matches(<42>), ' ', $m.matches(42.0);
--- expect
True False False False

=== num-definite-either
from: Cro::Core 0.8.10 lib/Cro/MessageWithBody.rakumod:21
license: Artistic-2.0
feature: method DEFINITE
--- code
my class Msg {
    has $.body;
    has $.body-byte-stream;
    method has-body() {
        $!body.DEFINITE || $!body-byte-stream.DEFINITE
    }
}
say Msg.new.has-body;
say Msg.new(body => '').has-body;
say Msg.new(body-byte-stream => 0).has-body;
say Int.DEFINITE, ' ', 0.DEFINITE;
--- expect
False
True
True
False True

=== num-smartmatch-nil-skip
from: BDD::Behave 0.9.5 lib/BDD/Behave/Coverage.rakumod:1054
license: Artistic-2.0
feature: term Nil
--- code
my %h = a => 1, b => Nil, c => 0, d => Any;
my @parts;
for %h.keys.sort -> $k {
    my $v = %h{$k};
    next if $v ~~ Nil;
    @parts.push: "$k: {$v // 'null'}";
}
say @parts.join(', ');
say Nil ~~ Nil, ' ', Any ~~ Nil, ' ', (my $x = Nil).^name;
--- expect
a: 1, b: null, c: 0, d: null
True False Any

=== num-nil-identity-check
from: CSS::Properties 0.10.9 lib/CSS/Font.rakumod:135
license: Artistic-2.0
feature: term Nil
--- code
sub lookup($name) { $name eq 'fc' ?? 'FontConfig' !! Nil }
for 'fc', 'none' {
    my $FontConfig := lookup($_);
    if $FontConfig === Nil {
        say "$_: not loaded";
    }
    else {
        say "$_: $FontConfig";
    }
}
my $s = lookup('none');
say $s === Nil, ' ', $s.^name;
--- expect
fc: FontConfig
none: not loaded
False Any

=== num-return-nil-without
from: App::RaCoCo 2.0.1 lib/App/Racoco/Configuration.rakumod:23
license: Artistic-2.0
feature: prefix so
--- code
sub convert($value --> Bool) {
    return Nil without $value;
    if $value ~~ Str {
        if $value.lc eq 'false' || $value eq '0' || $value.chars == 0 {
            return False;
        }
    }
    return so $value;
}
say convert($_).raku for 'yes', 'FALSE', '0', '', 1, 0, Any;
--- expect
Bool::True
Bool::False
Bool::False
Bool::False
Bool::True
Bool::False
Nil

=== num-prefix-question-compare
from: BDD::Behave 0.9.5 lib/BDD/Behave/Configuration.rakumod:52
license: Artistic-2.0
feature: prefix ?
--- code
my %meta = slow => True, tag => 'db';
my %actual = slow => 1, tag => 'db';
my $ok = True;
for %meta.sort(*.key) -> (:key($k), :value($v)) {
    my $actual = %actual{$k};
    $ok = False unless $actual.defined;
    if $v ~~ Bool {
        $ok = False unless ?$actual == $v;
    }
    else {
        $ok = False unless $actual eq $v;
    }
}
say $ok;
--- expect
True

=== num-prefix-question-ternary-named
from: Base64 0.1.0 lib/Base64.rakumod:9
license: Artistic-2.0
feature: prefix ?
--- code
proto sub encode(|) {*}
multi sub encode(Bool:D :$pad!, |c) { samewith(:pad(?$pad ?? '=' !! ''), |c) }
multi sub encode(Bool:D :$uri! where *.so, |c) { samewith(:alpha<uri>, |c) }
multi sub encode(Str:D :$pad = "=", Str:D :$alpha = "std") { "$alpha pad<$pad>" }
say encode(:pad);
say encode(:!pad);
say encode(:uri);
say encode();
say encode(:!uri);
--- expect
std pad<=>
std pad<>
uri pad<=>
std pad<=>
!! X::Multi::NoMatch

