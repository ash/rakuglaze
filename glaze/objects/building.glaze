=== obj-new-typeobject-invocant-slurpy
from: Array::Agnostic 0.0.18 lib/Array/Agnostic.rakumod:88
license: Artistic-2.0
feature: method new
--- code
my class Vec {
    has @.values;
    method STORE(@v, :$INITIALIZE) { @!values = @v; self }
    method new(::?CLASS:U: **@values is raw) {
        self.bless(|%_).STORE(@values, :INITIALIZE)
    }
}
say Vec.new(1, 2, 3).values;
say Vec.new.values.elems;
Vec.new(1).new(2);
--- expect
[1 2 3]
0
!! X::Parameter::InvalidConcreteness

=== obj-exception-message-attrs
from: AttrX::Mooish 1.0.10 lib/AttrX/Mooish/X.rakumod:16
license: Artistic-2.0
feature: method message
--- code
my class Fatal is Exception { }
my class NotAllowed is Fatal {
    has Str:D $.op is required;
    has Str $.cause;
    method message {
        "Operation '$!op' is not allowed at this time" ~ ($!cause ?? ": $!cause" !! "")
    }
}
say NotAllowed.new(op => 'clear').message;
try NotAllowed.new(op => 'set', cause => 'frozen').throw;
say $!.message, ' ', $! ~~ Fatal;
NotAllowed.new(op => 'x').throw;
--- expect
Operation 'clear' is not allowed at this time
Operation 'set' is not allowed at this time: frozen True
!! NotAllowed

=== obj-exception-stub-method-subclass
