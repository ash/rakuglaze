=== ctl-while-pointy-topic
from: DOM::Tiny 0.5.2 lib/DOM/Tiny/HTML.pm6:246
license: Artistic-2.0
feature: node While
--- code
my @children = 'a', 'b', 1, 'c', 'd', 'e';
my $i = 0;
MERGE: while @children[$i + 1] -> $next {
    if @children[$i] ~~ Str && $next ~~ Str {
        splice @children, $i, 2, @children[$i] ~ $next;
        next MERGE;
    }
    $i++;
}
say @children.raku;
--- expect
["ab", 1, "cde"]

=== ctl-postfix-while-step
from: Color 1.004001 lib/Color/Conversion.rakumod:60
license: Artistic-2.0
feature: node While
--- code
sub norm($h is copy) {
    $h -= 360 while $h >= 360;
    $h += 360 while $h < 0;
    $h
}
