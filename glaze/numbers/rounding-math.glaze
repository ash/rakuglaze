null
null
3.25
10
False True

=== num-inf-multiplier
from: Config::TOML 0.1.3 lib/Config/TOML/Parser/Actions.rakumod:241
license: Unlicense
feature: term Inf
--- code
for '+', '-' -> $pm {
    my Int:D $multiplier = $pm eq '+' ?? 1 !! -1;
    my $v = Inf * $multiplier;
    say "$v {$v.^name} {$v ~~ Inf}";
}
say (-Inf) < -1e308, ' ', Inf > 2**2000;
--- expect
Inf Num True
-Inf Num False
True False

=== num-inf-whatever-size
from: Data::Generators 0.1.11 lib/Data/Generators/RandomFunctions.rakumod:70
license: Artistic-2.0
feature: term Inf
--- code
for 3, Inf -> $s {
    my $size = $s;
    if $size ~~ Inf { $size = Whatever; }
    say $size.^name;
}
say (1..Inf).is-lazy, ' ', ~Inf;
--- expect
Int
Whatever
True Inf

=== num-approx-equal-zero
from: PDF::Content 0.9.11 lib/PDF/Content/Matrix.rakumod:66
license: Artistic-2.0
feature: infix =~=
--- code
for 0e0, 1e-16, 0.1e0 + 0.2e0 - 0.3e0, 0.001 -> $det {
    if $det =~= 0 {
        say "singular";
    }
    else {
        say "ok";
    }
}
say 0.1e0 + 0.2e0 =~= 0.3e0;
--- expect
singular
singular
singular
ok
True

