=== num-infix-max-floor
from: CRoaring 0.2.3 lib/CRoaring.rakumod:162
license: Artistic-2.0
feature: infix max
--- code
my ($card, $offset) = 10, 2;
for 3, 20 -> $count {
    my Int:D $actual = ($card - $offset) min $count;
    my Int:D $start = ($card - $offset - $count) max 0;
    say "$actual $start";
}
--- expect
3 5
8 0

