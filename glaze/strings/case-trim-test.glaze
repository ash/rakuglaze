$!a
&!d

=== str-starts-with-colon-arg
from: Anolis 1.0.0 lib/Anolis.rakumod:181
license: Artistic-2.0
feature: method starts-with
--- code
for '0;title', '2;icon' -> $string {
    if $string.starts-with: '0;' {
        say "title: $string.substr(2)";
    }
    else {
        say "other: $string";
    }
}
--- expect
title: title
other: 2;icon

