c:3

=== list-map-pair-then-hash
from: zef 1.1.4 lib/Zef/Repository.rakumod:135
license: Artistic-2.0
feature: method map
--- code
my @identities = 'Foo:ver<1>', './local', 'Bar', '/abs/path';
my %searchable = @identities.grep({ not $_.starts-with("." | "/") }).map({ $_ => 1 });
say %searchable.keys.sort;
say %searchable<Bar>;
--- expect
(Bar Foo:ver<1>)
1

