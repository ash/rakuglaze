0

=== hash-delete-attribute-hash
from: Cache::Async 0.3.4 lib/Cache/Async.rakumod:206
license: Artistic-2.0
feature: adverb :delete
--- code
my class Cache {
    has %!entries;
    method put($k, $v) { %!entries{$k} = $v }
    method evict(Pair $evicted) { %!entries{$evicted.key}:delete }
    method keys { %!entries.keys.sort }
}
my $c = Cache.new;
$c.put($_, $_.uc) for <a b c>;
say $c.evict((b => 1));
say $c.keys;
--- expect
B
(a c)
