# Reductions: [+], [*], [~], [&&], [||], [+|], [==], [\+], [Z], [X], .reduce, .produce.

=== list-reduce-plus-array-attr
from: BDD::Behave 0.9.5 lib/BDD/Behave/Benchmark.rakumod:19
license: Artistic-2.0
feature: prefix [+]
--- code
my class Bench {
    has @.timings;
    has $.total;
    method sum-up { $!total = [+] @!timings; self }
}
say Bench.new(timings => (0.5, 1.25, 2)).sum-up.total;
say ([+] ()).raku;
--- expect
3.75
0

=== list-reduce-plus-map-colon
