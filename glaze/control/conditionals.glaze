=== ctl-postfix-for-in-array-literal
from: Air 0.1.32 lib/Air/Base.rakumod:629
license: Artistic-2.0
feature: node For
--- code
my class Node {
    has $.name;
    has @.children;
    method tree($depth = 0) {
        ('  ' x $depth) ~ $!name ~ "\n" ~ [.tree($depth + 1) for @!children].join
    }
}
my $t = Node.new(name => 'root', children => [Node.new(name => 'a', children => [Node.new(name => 'a1')]), Node.new(name => 'b')]);
print $t.tree;
--- expect
root
  a
    a1
  b

=== ctl-if-block-take-for
from: BDD::Behave 0.9.5 lib/BDD/Behave/Files.rakumod:31
license: Artistic-2.0
feature: node If
--- code
my %tree = root => <x.raku y.raku>, 'z.raku' => ();
sub find($path) { %tree{$path}.List }
my @found = gather for <root z.raku> -> $path {
    if %tree{$path}.elems { .take for find($path) }
    else                  { take $path }
};
say @found;
--- expect
[x.raku y.raku z.raku]
