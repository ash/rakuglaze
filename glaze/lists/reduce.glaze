=== list-triangular-plus-array-then-map
from: Intl::CLDR 0.7.6 lib/Intl/CLDR/Types/CurrencyFormats.rakumod:363
license: Artistic-2.0
feature: prefix [\+]
--- code
my @length-existence-table = 1, 0, 1, 1, 0;
my @length-transform   = ([\+]   @length-existence-table).map({ $^x - 1 < 0 ?? 0 !! $^x - 1});
say @length-transform;
my @count-transform = ([\+] @length-existence-table) Z* @length-existence-table;
say @count-transform;
--- expect
[0 0 1 2 2]
[1 0 2 3 0]

