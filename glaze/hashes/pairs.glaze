=== hash-pair-pairs-zero-key
from: CSS::Properties 0.10.9 lib/CSS/Properties.rakumod:248
license: Artistic-2.0
feature: method pairs
--- code
for { 'expr:width' => 3 }, { color => 'red' }, 'plain' {
    if $_ ~~ Associative && (my $p0 := .pairs[0]).key.starts-with('expr:') {
        say 'expression ', $p0.value;
    }
    else {
        say 'other';
    }
}
--- expect
expression 3
other
other

=== hash-pair-single-named-head
from: LibXML 0.11.3 lib/LibXML/Item.rakumod:43
license: Artistic-2.0
feature: method pairs
--- code
my class X2 {
    multi method ast-to-xml(Pair $p) { "<{$p.key}>{$p.value}</{$p.key}>" }
}
multi sub ast-to-xml(*%p where .elems == 1) { X2.ast-to-xml(%p.pairs.head) }
say ast-to-xml(:b<bold>);
say (try ast-to-xml(:a(1), :b(2))) // 'no match';
--- expect
<b>bold</b>
no match

