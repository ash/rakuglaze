=== rx-interp-array-negated-lookahead
from: Path::Finder 0.4.7 lib/Path/Finder.rakumod:196
license: Artistic-2.0
feature: regex !before
--- code
sub class-rx($not, @class) {
    $not ?? /<!before @class> ./ !! /@class/;
}
my $in  = class-rx('', <a b c>);
my $out = class-rx('!', <a b c>);
say 'xbyaz'.comb($in).join;
say 'xbyaz'.comb($out).join;
--- expect
ba
xyz

=== rx-interp-array-alias-dynamic
from: MUGS::Games 0.1.4 lib/MUGS/Server/Game/Adventure/CommandParser.rakumod:20
license: Artistic-2.0
feature: regex ident
--- code
my class Context { has @.items; has @.exits }
my grammar Cmd {
    rule TOP { ^ <command> $ }
    proto rule command          {*}
    rule command:sym<lock>      { <sym> <thing=@($*ctx.items)> }
    rule command:sym<go>        { <sym>? <exit=@($*ctx.exits)> }
}
my $*ctx = Context.new(items => <door chest>, exits => <north south>);
for 'lock chest', 'go north', 'south', 'lock window' -> $in {
    with Cmd.parse($in) { say "$in -> {.<command><thing> // .<command><exit>}" }
    else { say "$in -> ?" }
}
--- expect
lock chest -> chest
go north -> north
south -> south
lock window -> ?

=== rx-interp-array-make-regex
from: IO::Glob 0.9.0 lib/IO/Glob.pm6:184
license: Artistic-2.0
feature: regex !before
--- code
my grammar G {
    token TOP { <match> }
    proto token match {*}
    token match:character-class {
        <!after "\\"> '['
            $<not>   = [ "!"? ]
            $<class> = [ <-[ \] ]>+ ]
        ']'
        {
            my @class = $<class>.Str.comb;
            make $<not> ?? rx{@class} !! rx{<!before @class> .}
        }
    }
}
for '[abc]', '[!abc]' -> $glob {
    my $rx = G.parse($glob)<match>.made;
    say $glob, ': ', <a d c z>.map({ so $_ ~~ /^ $rx $/ }).join(' ');
}
--- expect
[abc]: True False True False
[!abc]: True False True False

