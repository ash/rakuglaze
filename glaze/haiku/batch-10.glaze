license: Artistic-2.0
feature: return $entry.Str if $bn.starts-with(...) && $bn.ends-with(...)
--- code
sub find-entry($entry, $name, $ext) {
    my $bn = $entry;
    return $entry.Str if $bn.starts-with("$name-") && $bn.ends-with(".$ext");
    'none'
}
say find-entry('libfoo-1.so', 'libfoo', 'so');
say find-entry('other.so', 'libfoo', 'so');
--- expect
libfoo-1.so
none

=== hk-10-onboarding-age-rule
from: DSL::Shared 0.2.11 lib/DSL/Shared/Roles/English/RudimentaryUserOnboarding.rakumod:47
license: Artistic-2.0
feature: rule user-age-spec { <human-age-spec> <.human-age-pos-phrase>? }
--- code
my grammar Onb {
    token TOP { <user-age-spec> }
    rule user-age-spec { <human-age-spec> <.human-age-pos-phrase>? }
    token human-age-spec { \d+ }
    token human-age-pos-phrase { 'years' }
}
say ~Onb.parse('42 years');
say ~Onb.parse('7');
--- expect
42 years
7

=== hk-10-worded-regex-sym
from: Lingua::NumericWordForms 0.6.2 lib/Lingua/NumericWordForms/Roles/English/WordedNumberSpec.rakumod:8
license: Artistic-2.0
feature: regex worded_number_100s:sym<English> { <name_1_to_19> \h+ <name_of_100> | <name_of_100> }
--- code
my grammar Worded {
    token TOP { <worded_number_100s> }
    proto regex worded_number_100s {*}
    regex worded_number_100s:sym<English> { <name_1_to_19> \h+ <name_of_100> | <name_of_100> }
    token name_1_to_19 { 'one' | 'two' }
    token name_of_100 { 'hundred' }
}
say ~Worded.parse('two hundred');
say ~Worded.parse('hundred');
--- expect
two hundred
hundred

=== hk-10-tiny-date-capture
from: HTTP::Tiny 0.2.6 lib/HTTP/Tiny.rakumod:146
license: Artistic-2.0
feature: $<day> = \d ** 2 '-' capture
--- code
my grammar DateRx {
    token TOP { $<day>   =   \d ** 2 '-' $<month> = \d ** 2 }
}
my $m = DateRx.parse('09-10');
say ~$m<day>;
say ~$m<month>;
--- expect
09
10

=== hk-10-portuguese-name-made
from: Lingua::NumericWordForms 0.6.2 lib/Lingua/NumericWordForms/Actions/Portuguese/WordedNumberSpec.rakumod:16
license: Artistic-2.0
feature: make $<name_up_to_29>.made
--- code
my grammar Pt {
    token TOP { <name_up_to_29> }
    token name_up_to_29 { \d+ }
}
my class PtActions {
    method name_up_to_29($/) { make +$/ * 2 }
    method TOP($/) { make $<name_up_to_29>.made }
}
say Pt.parse('21', :actions(PtActions.new)).made;
--- expect
42

=== hk-10-step-range-spec
from: DSL::Shared 0.2.11 lib/DSL/Shared/Actions/Raku/CommonStructures.rakumod:59
license: Artistic-2.0
feature: method range-spec-step($/) { make $<number-value>.made; }
--- code
my grammar Step {
    token TOP { <range-spec-step> }
    token range-spec-step { <number-value> }
    token number-value { \d+ }
}
my class StepActions {
    method number-value($/) { make +$/ }
    method range-spec-step($/) { make $<number-value>.made; }
    method TOP($/) { make $<range-spec-step>.made }
}
say Step.parse('5', :actions(StepActions.new)).made;
--- expect
5

