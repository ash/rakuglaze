from: cro 0.8.10 lib/Cro/Tools/Runner.rakumod:249
license: Artistic-2.0
feature: await with Promise anyof
--- code
my $try-conn = Promise.in(0.1);
my $timeout = Promise.in(1);
my $result = await Promise.anyof($try-conn, $timeout);
say "awaited";
--- expect
awaited

