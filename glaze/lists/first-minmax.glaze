=== list-min-pair-by-value
from: DSL::Shared 0.2.11 lib/DSL/Shared/Utilities/FuzzyMatching.rakumod:66
license: Artistic-2.0
feature: method min
--- code
my %dists = apple => 3, apply => 1, ample => 2;
my $distPair = %dists.min({ $_.value });
say $distPair.key;
say $distPair.^name;
--- expect
apply
Pair

=== list-max-chars-of-lines
from: Text::Table::Simple 0.1.0 lib/Text/Table/Simple.rakumod:140
license: Artistic-2.0
feature: method max
--- code
my @r = ['ab', "x\nlonger"], ['abcd', Str];
my $col = 1;
say @r[*;$col].map({ .defined && .chars ?? .lines.max(*.chars).chars !! 0 }).max;
say @r[*;0].map(*.chars).max;
--- expect
6
4

=== list-minmax-destructure
from: List::MoreUtils 0.0.10 lib/List/MoreUtils.rakumod:392
license: Artistic-2.0
feature: method minmax
--- code
my @values = 5, 3, 9, 1;
say @values ?? ((.min,.max) with @values.minmax) !! ();
say @values.minmax.^name;
say @values.minmax;
--- expect
(1 9)
Range
1..9

=== list-sum-of-map
from: BDD::Behave 0.9.5 lib/BDD/Behave/Formatter/JUnit.rakumod:330
license: Artistic-2.0
feature: method sum
--- code
my class Suite { has @.cases }
my @suites = Suite.new(cases => <a b>), Suite.new(cases => <c>), Suite.new;
my $total-tests = @suites.map({ .cases.elems }).sum;
say $total-tests;
say ().sum;
--- expect
3
0
