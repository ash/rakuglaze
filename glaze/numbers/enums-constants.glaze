96
55
CBOR_BStr
Int

=== num-enum-same-key-value
from: Cro::HTTP 0.8.13 lib/Cro/HTTP/Cookie.rakumod:30
license: Artistic-2.0
feature: decl enum
--- code
my enum SameSite ( |do {
    <
        Strict
        Lax
        None
    >.map: { $_ => $_ }
});
my @same-site-opts = SameSite.enums.values.sort;
say @same-site-opts;
say SameSite('Lax');
say Strict.value.^name;
--- expect
[Lax None Strict]
Lax
Str

=== num-enum-enums-invert
from: CSS::Grammar 0.4.3 lib/CSS/Grammar/AST.rakumod:13
license: Artistic-2.0
feature: method enums
--- code
my enum CSSObject (Rule => 'rule', Ruleset => 'ruleset');
my enum CSSValue (ColorV => "color", NumV => "num");
my %known-type =
    %( CSSObject.enums.invert ),
    %( CSSValue.enums.invert );
say %known-type.sort(*.key).map({ "{.key}={.value}" }).join(' ');
--- expect
color=ColorV num=NumV rule=Rule ruleset=Ruleset

=== num-enum-enums-exists
from: CSS::Properties 0.10.9 lib/CSS/PageBox.rakumod:55
license: Artistic-2.0
feature: method enums
--- code
my enum PageSizes (A4 => [595, 842], LETTER => [612, 792]);
for 'a4', 'letter', 'b5' {
    my @length;
    when PageSizes.enums{.uc}:exists {
        @length = PageSizes.enums{.uc};
        say "$_: @length[]";
    }
    default { say "$_: unknown" }
}
--- expect
a4: 595 842
letter: 612 792
b5: unknown

=== num-enum-enums-hash-lookup
from: Date::Event 0.0.12 lib/Date/Event.rakumod:56
license: Artistic-2.0
feature: method enums
--- code
my enum EType (Birthday => 1, Anniversary => 2, Holiday => 3);
sub etype(Str $v? --> UInt) {
    my %m = EType.enums;
    if $v.defined {
        return %m{$v}
    }
    0
}
say etype('Holiday'), ' ', etype(), ' ', etype('Anniversary').^name;
--- expect
3 0 Int

=== num-enum-bare-int-subset
from: Getopt::Advance 1.2.0 lib/Getopt/Advance/Utils.rakumod:125
license: MIT
feature: decl subset
--- code
my enum < DEBUG INFO WARN ERROR DIE NOLOG >;
my subset LEVEL of Int where { $_ >= DEBUG.Int && $_ <= ERROR.Int };
say (^7).grep(LEVEL);
say WARN ~~ LEVEL, ' ', DIE ~~ LEVEL;
say NOLOG.Int, ' ', WARN.pred, ' ', WARN.succ, ' ', DEBUG.pred.raku;
--- expect
(0 1 2 3)
True False
5 INFO ERROR ::DEBUG

=== num-enum-isset-grep
from: BitEnum 0.5 lib/BitEnum.rakumod:60
license: Artistic-2.0
feature: method enums
--- code
my enum EnumBits (A => 1, B => 2, C => 4, D => 8);
my class BitSet {
    has $.value;
    method isset($e) { so $!value +& $e.value }
    method list() { EnumBits.enums.grep({ $.isset($_) }).sort(*.value).map(*.key) }
}
say BitSet.new(value => 13).list;
say BitSet.new(value => 0).list.elems;
--- expect
(A C D)
0

=== num-enum-kv-pairs
from: Constants::Sys::Socket 0.0.2 lib/Constants/Sys/Socket.pm6:56
license: Artistic-2.0
feature: decl enum
--- code
my enum SO (
    SO_DEBUG     => 0x0001,
    SO_REUSEADDR => 0x0004,
    SO_KEEPALIVE => 0x0008,
);
say SO_REUSEADDR.kv;
say SO_KEEPALIVE.pair;
say SO::.keys.sort;
say SO_DEBUG < SO_KEEPALIVE, ' ', SO_REUSEADDR.Numeric;
--- expect
(SO_REUSEADDR 4)
SO_KEEPALIVE => 8
(SO_DEBUG SO_KEEPALIVE SO_REUSEADDR)
True 4

=== num-succ-or-plus-one
from: ORM::Factory 0.9.1 lib/ORM/Factory.rakumod:70
license: Artistic-2.0
feature: method succ
--- code
for 9, 'a9', 'Zz', 1.5 -> $start {
    my $current = $start;
    my @seq;
    for ^3 {
        @seq.push: $current;
        $current = $current ~~ Numeric ?? $current + 1 !! $current.succ;
    }
    say @seq.join(' ');
}
--- expect
9 10 11
a9 b0 b1
Zz AAa AAb
1.5 2.5 3.5

=== num-succ-subseconds-width
from: DateTime::Format 0.1.5 lib/DateTime/Format.rakumod:51
license: Artistic-2.0
feature: method succ
--- code
for 0, 3, 6 -> $subseconds {
    my $ff = "\%0{ 2 + $subseconds.succ }." ~ $subseconds ~ 'f';
    say "$ff -> {sprintf($ff, 7.123456789)}";
}
say 5.pred, ' ', 0.5.succ, ' ', (-1).pred;
--- expect
%03.0f -> 007
%06.3f -> 07.123
%09.6f -> 07.123457
4 1.5 -2

=== num-constant-int-flags
