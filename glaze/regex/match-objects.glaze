=== rx-match-in-sub-param-where
from: PDF::Content 0.9.11 lib/PDF/Content/Image.rakumod:46
license: Artistic-2.0
feature: node RegexLit
--- code
my subset DataURI of Str where /^ 'data:' /;
multi sub load(DataURI $u) { "data uri, {$u.chars} chars" }
multi sub load(Str $u)     { "path $u" }
say load('data:,x');
say load('img/a.png');
--- expect
data uri, 7 chars
path img/a.png

=== rx-made-default-on-parse
from: Text::CodeProcessing 0.6.0 lib/Text/CodeProcessing.rakumod:450
license: Artistic-2.0
feature: method made
--- code
my grammar H {
    token TOP { '#' \s* <pair>+ % [\s* ',' \s*] }
    token pair { (\w+) '=' (\w+) }
}
my class HA {
    method TOP($/) { make $<pair>.map(*.made).hash }
    method pair($/) { make ~$0 => ~$1 }
}
for '# lang=raku, eval=true', 'no header' -> $input {
    my %header = H.parse($input, actions => HA.new).made // %();
    say %header.sort.map({ "{.key}:{.value}" }).join(' ') || '(none)';
}
--- expect
eval:true lang:raku
(none)

=== rx-made-or-make-method-form
from: Time::Crontab 1.0.0 lib/Time/Crontab/Actions.pm6:31
license: Artistic-2.0
feature: method make
--- code
my grammar Dow {
    token TOP { <dow-value> }
    token dow-value { <dow-number> | <dow-name> }
    token dow-number { <[0..7]> }
    token dow-name { mon | tue | wed }
}
my class DA {
    method TOP($/) { $/.make: $<dow-value>.made }
    method dow-value($/) { $/.make: $/<dow-number>.made // $/<dow-name>.made }
    method dow-number($/) { make +$/ }
    method dow-name($/) { make <mon tue wed>.first(~$/, :k) + 1 }
}
say Dow.parse('5', :actions(DA)).made;
say Dow.parse('tue', :actions(DA)).made;
--- expect
5
2

=== rx-values-hyper-made-join
from: DSL::English::DataQueryWorkflows 0.6.5 lib/DSL/English/DataQueryWorkflows/Actions/Bulgarian/Predicate.rakumod:10
license: Artistic-2.0
feature: method made
--- code
my grammar P {
    rule TOP { <predicate> }
    rule predicate { <gt-cmp> | <lt-cmp> }
    rule gt-cmp { (\w+) '>' (\d+) }
    rule lt-cmp { (\w+) '<' (\d+) }
}
my class PA {
    method TOP($/) { make $<predicate>.made }
    method predicate($/) { make $/.values>>.made.join(' '); }
    method gt-cmp($/) { make "$0 > $1" }
    method lt-cmp($/) { make "$0 < $1" }
}
say P.parse('age > 30', :actions(PA)).made;
say P.parse('size < 4', :actions(PA)).made;
--- expect
age > 30
size < 4

=== rx-match-numeric-coercion
from: CSS::Specification 0.5.3 lib/CSS/Specification/Base/Grammar.rakumod:17
license: Artistic-2.0
feature: regex <?{ }>
--- code
my grammar L {
    token number { \d+ ['.' \d+]? }
    token length:sym<zero> { <number> <?{ +$<number> == 0 }> }
    token TOP { <length:sym<zero>> }
}
say so L.parse('0');
say so L.parse('0.0');
say so L.parse('3');
--- expect
True
True
False
