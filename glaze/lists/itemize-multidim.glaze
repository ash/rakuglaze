=== list-array-of-arrays-xx
from: FEN::Grammar 0.0.7 lib/FEN/Utils.rakumod:5
license: Artistic-2.0
feature: infix xx
--- code
my $dimension = 3;
my @matrix = [["." xx $dimension] xx $dimension];
@matrix[1][2] = 'K';
say @matrix.elems;
say @matrix.map(*.join).join('/');
--- expect
3
.../..K/...

=== list-array-of-arrays-dp
from: BDD::Behave 0.9.5 lib/BDD/Behave/Diff.rakumod:248
license: Artistic-2.0
feature: index [][]
--- code
my @a = <a b c>;
my @b = <a c>;
my @t;
for 0..@a.elems -> $i { @t[$i][0] = 0 }
for 0..@b.elems -> $j { @t[0][$j] = 0 }
for 1..@a.elems -> $i {
    for 1..@b.elems -> $j {
        @t[$i][$j] = @a[$i-1] eq @b[$j-1] ?? @t[$i-1][$j-1] + 1 !! max(@t[$i-1][$j], @t[$i][$j-1]);
    }
}
say @t[*-1][*-1];
--- expect
2

=== list-array-of-arrays-with
from: Data::Translators 0.1.18 lib/Data/Translators.rakumod:95
license: Artistic-2.0
feature: index [][]
--- code
my @tbl = [1, Any], [3];
my @cells;
for ^2 -> $i {
    for ^2 -> $j {
        with @tbl[$i][$j] { @cells.push: $_ } else { @cells.push: q{-} }
    }
}
say @cells.join(q{ });
--- expect
1 - 3 -

=== list-shaped-array-assign
from: PDF::Class 0.5.30 lib/PDF/NameTree.rakumod:44
license: Artistic-2.0
feature: decl shaped array
--- code
my @limits[2] = 'aaa', 'zzz';
say @limits;
say @limits.shape;
@limits[1] = 'mmm';
say @limits.join('..');
--- expect
