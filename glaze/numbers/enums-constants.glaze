# Enums with explicit values, enum introspection (.enums, .kv, .value,
# .pred/.succ), constants (scalar, computed, list, hash, `but`), and
# subsets over numbers.

=== num-enum-colonpair-values
from: Cro::WebSocket 0.8.10 lib/Cro/WebSocket/Frame.rakumod:4
license: Artistic-2.0
feature: decl enum
--- code
my enum Opcode (:Continuation(0),
                :Text(1), :Binary(2),
                :Close(8), :Ping(9), :Pong(10));
say Opcode(9);
say Close.value, ' ', Close.key, ' ', +Pong;
say Opcode.enums.sort(*.value).map(*.key).join(' ');
say Text ~~ Opcode, ' ', 1 ~~ Opcode, ' ', Opcode(3).defined;
--- expect
Ping
8 Close 10
Continuation Text Binary Close Ping Pong
True False False

=== num-enum-hex-pairs
from: Audio::Sndfile 0.0.16 lib/Audio/Sndfile.rakumod:482
license: Artistic-2.0
feature: decl enum
--- code
my enum OpenMode (:Read(0x10), :Write(0x20), :ReadWrite(0x30));
for OpenMode::.values.sort -> $m {
    say "$m {$m.value} {$m.value.base(16)}";
}
say ReadWrite.value +& Write.value == Write.value;
--- expect
Read 16 10
Write 32 20
ReadWrite 48 30
True

=== num-enum-pair-list-bits
from: CBOR::Simple 0.1.4 lib/CBOR/Simple.rakumod:7
license: Artistic-2.0
feature: decl enum
--- code
my enum CBORMajorType (
    CBOR_UInt  => 0,
    CBOR_NInt  => 1 +< 5,
    CBOR_BStr  => 2 +< 5,
    CBOR_TStr  => 3 +< 5,
);
say CBOR_TStr.value;
say CBOR_NInt + 23;
say CBORMajorType(64);
say (CBOR_BStr +| 4).^name;
