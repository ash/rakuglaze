=== rx-hyper-ast-slip
from: CSS::Grammar 0.4.3 lib/CSS/Grammar/Actions.rakumod:119
license: Artistic-2.0
feature: method made
--- code
my grammar Ident {
    token TOP { $<pfx>='-'? <nmstrt> <nmchar>* }
    token nmstrt { <[_ a..z A..Z]> }
    token nmchar { <[_ a..z A..Z 0..9 -]> }
}
my class IA {
    method TOP($/) {
        my $pfx = $<pfx> ?? '-' !! '';
        make [~] $pfx, $<nmstrt>.ast, @<nmchar>».ast.Slip;
    }
    method nmstrt($/) { make $/.uc }
    method nmchar($/) { make ~$/ }
}
say Ident.parse('-moz-box', :actions(IA)).ast;
