# Case, trimming and string tests: lc/uc/tc/tclc/fc/wordcase, trim*, starts-with/ends-with/contains, indent.

=== str-lc-trim-chain
from: CSS::Grammar 0.4.3 lib/CSS/Grammar/AST.rakumod:129
license: Artistic-2.0
feature: method lc
--- code
my $prop-name;
for '  Font-Size ', "\tCOLOR\n" {
    $prop-name = .trim.lc;
    say "[$prop-name]";
}
--- expect
[font-size]
[color]

=== str-lc-eq-key-compare
from: Apache::LogFormat * lib/Apache/LogFormat/Compiler.pm6:175
license: Artistic-2.0
feature: method lc
--- code
my $lkey = 'content-type';
for (Content-Type => 'text/html', Accept => '*/*') -> $pair {
    if $pair.key.lc eq $lkey {
        say $pair.value;
    }
}
--- expect
text/html

=== str-lc-contains-both-sides
from: Color::Names 2.0.0 lib/Color/Names.rakumod:11
license: BSD-2-Clause
feature: method contains
--- code
my $colors = { r => { name => 'Dark Red' }, g => { name => 'Green' }, b => { name => 'Reddish Brown' } };
my $needle = 'RED';
my @found = $colors.keys.grep: { $colors{$_}<name>.lc.contains: $needle.lc };
say @found.sort;
--- expect
(b r)

=== str-lc-trim-eq-close
from: Cro::HTTP 0.8.13 lib/Cro/HTTP/ResponseSerializer.rakumod:85
license: Artistic-2.0
feature: method lc
--- code
for ' Keep-Alive', 'CLOSE ' {
    say "$_: ", .lc.trim eq 'close';
}
--- expect
 Keep-Alive: False
CLOSE : True

=== str-lc-falsy-string-config
from: App::RaCoCo 2.0.1 lib/App/Racoco/Configuration.rakumod:19
license: Artistic-2.0
feature: method lc
--- code
sub as-bool($value) {
    if $value.lc eq 'false' || $value eq '0' || $value.chars == 0 {
        return False;
    }
    True
}
say <FALSE 0 yes False>.map(&as-bool), as-bool('');
--- expect
(False False True False)False

=== str-uc-in-block-interpolation
from: BDD::Behave 0.9.5 lib/BDD/Behave/DryRun.rakumod:225
license: Artistic-2.0
feature: method uc
--- code
for 'pending', '' -> $status {
    my $suffix = $status.chars ?? " ({$status.uc})" !! '';
    say "example$suffix";
}
--- expect
example (PENDING)
example

=== str-uc-hash-key-from-match
from: Bailador 0.0.19 lib/Bailador/Request.pm:101
license: MIT
feature: method uc
--- code
my %headers;
for 'content_type: text/plain', 'x_token: abc' {
    if / (\w+) ':' \s* (.+) / {
        %headers{ $/[0].Str.uc } = $/[1].Str;
    }
}
say %headers.sort.map(*.kv.join('=')).join(', ');
--- expect
CONTENT_TYPE=text/plain, X_TOKEN=abc

=== str-uc-unicode-codepoint
from: CSS::Grammar 0.4.3 lib/CSS/Grammar/Actions.rakumod:97
license: Artistic-2.0
feature: method uc
--- code
my $hex-str = '1f600';
say 'U+' ~ $hex-str.uc;
say 'straße'.uc;
--- expect
U+1F600
STRASSE

=== str-tc-hash-lookup
from: DateTime::Grammar 0.1.3 lib/DateTime/Actions/Raku.rakumod:157
license: MIT
feature: method tc
--- code
my %wkday = Mon => 1, Tue => 2, Wed => 3;
for <mon TUE wed> {
    say %wkday{$_.lc.tc} // 'none', ' ', %wkday{$_.tc} // 'none';
}
--- expect
1 1
2 none
3 3

