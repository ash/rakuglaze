=== hash-classify-destructure-named
from: Test::Scheduler 1.2 lib/Test/Scheduler.rakumod:182
license: Artistic-2.0
feature: method classify
--- code
my $now = 10;
my @pending = 3, 15, 8, 20;
my (:@now, :@future) := @pending.classify: {
    $_ <= $now ?? 'now' !! 'future'
}
say @now;
say @future;
--- expect
[3 8]
[15 20]

=== hash-classify-pairs-by-value-state
from: cro 0.8.10 lib/Cro/Tools/Runner.rakumod:120
license: Artistic-2.0
feature: method classify
--- code
my class Svc { has $.state }
my %services = web => Svc.new(state => 'running'), db => Svc.new(state => 'stopped'), queue => Svc.new(state => 'running');
my %splitted = %services.List.classify({ .value.state });
say "{.key}: {.value».key.sort}" for %splitted.sort;
--- expect
running: queue web
stopped: db

=== hash-classify-sub-pair-check
from: Inline::Perl5 0.62 lib/Inline/Perl5.pm6:912
license: Artistic-2.0
feature: call classify
--- code
my @args = 1, (a => 2), 'x', (b => 3);
my %named = classify {$_.WHAT =:= Pair}, @args;
%named<False> //= [];
%named<True> //= [];
say %named<True>.map(*.key);
say %named<False>;
--- expect
(a b)
[1 x]

=== hash-classify-colon-block-hash-bind
from: CSS::Nested 0.0.1 lib/CSS/Nested.rakumod:59
license: Artistic-2.0
feature: method classify
--- code
my %ruleset = declarations => [{ property => 'color' }, { ruleset => 'nested' }, { property => 'margin' }];
my %ds := %ruleset<declarations>.map({ %$_ }).classify: {
    .<ruleset>:exists ?? 'rule' !! 'decl'
}
say %ds<decl>.elems, ' ', %ds<rule>.elems;
say %ds<decl>.map(*<property>);
--- expect
2 1
(color margin)

=== hash-classify-nested-map-bag
from: Data::Generators 0.1.11 lib/Data/Generators/ResourceAccess.rakumod:86
license: Artistic-2.0
feature: method classify
--- code
my @petNames = <Cat Tom 2>, <Dog Rex 1>, <Cat Max 3>;
my %specieToPetNames = @petNames.classify({ $_[0] }).map({ $_.key.lc => Bag($_.value.map({ $_[1] => $_[2] })) });
say %specieToPetNames<cat>.total;
say %specieToPetNames<dog>.keys;
--- expect
5
(Rex)

=== hash-classify-value-sort-lists
from: Lingua::NumericWordForms 0.6.2 lib/Lingua/NumericWordForms/NumericWordForms.rakumod:165
license: Artistic-2.0
feature: method classify
--- code
my %roles = one => 'digit', ten => 'tens', two => 'digit', twenty => 'tens', hundred => 'scale';
my @groups = %roles.pairs.classify({ $_.value }).map({ $_.value>>.key.List.sort });
say @groups.map(*.join(q{,})).sort.join(' | ');
--- expect
hundred | one,two | ten,twenty

=== hash-categorize-slice-join
from: Data::Reshapers 0.3.8 lib/Data/Reshapers/ToWideFormat.rakumod:109
license: Artistic-2.0
feature: method categorize
--- code
my @arr-of-hashes = { id => 1, var => 'x', v => 5 }, { id => 1, var => 'y', v => 6 }, { id => 2, var => 'x', v => 7 };
my @idColsLocal = <id>;
my $variableColName = 'var';
my $sep = '-';
my %res = @arr-of-hashes.categorize({ $_{ |@idColsLocal, $variableColName}.join($sep) });
say %res.keys.sort;
--- expect
(1-x 1-y 2-x)

=== hash-categorize-values-grouped
from: zef 1.1.4 lib/Zef/Repository.rakumod:153
license: Artistic-2.0
feature: method categorize
--- code
my class Cand { has $.as; has $.ver }
my @unsorted-candis = Cand.new(as => 'Foo', ver => 1), Cand, Cand.new(as => 'Bar', ver => 2), Cand.new(as => 'Foo', ver => 3);
my @unsorted-grouped-candis = @unsorted-candis.grep(*.defined).categorize({.as}).values;
say @unsorted-grouped-candis.map(*.map(*.ver).join(',')).sort;
--- expect
(1,3 2)

