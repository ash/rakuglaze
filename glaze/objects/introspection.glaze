=== obj-parents-local-loop
from: Test::Mock 1.8 lib/Test/Mock.rakumod:60
license: Artistic-2.0
feature: method parents
--- code
my class A { }
my class B is A { }
my class C is B { }
my $p = C;
my @seen;
loop {
    @seen.push: $p.^name;
    last unless $p.^parents(:local);
    $p = $p.^parents(:local)[0];
}
say @seen;
--- expect
[C B A Any Mu]

=== obj-roles-names-first
from: Cromponent 0.0.13 lib/Cromponent/MetaCromponentRole.rakumod:69
license: Artistic-2.0
feature: node Role
--- code
my role Cromponent { }
my role Styled { }
my class Card does Cromponent does Styled { }
my class Plain { }
for Card, Plain -> $new {
    if $new.^roles.map(*.^name).first: "Cromponent" {
        say $new.^name, ' is a component';
    }
    else {
        say $new.^name, ' is not';
    }
}
say Card.^roles.map(*.^name).sort;
--- expect
Card is a component
Plain is not
(Cromponent Styled)

