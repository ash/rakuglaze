license: MIT
feature: method can
--- code
my class Configuration {
    has $.port = 3000;
    has $.host = '0.0.0.0';
    method describe($key) {
        if self.^can($key) {
            my $type = self."$key"().^name;
            "$key is a $type";
        }
        else { "unknown $key" }
    }
}
