my class Canvas {
    method draw-line-spans($x, $y, $w, @spans) { "$x,$y,$w,{@spans.elems}" }
    method draw-rows($x, $y, $w, @spans) {
        (1, 3).map: { self.draw-line-spans($x, $y + $_, $w, @spans) }
