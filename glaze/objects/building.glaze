# Building and shaping objects: BUILD with attribute-binding named
# parameters, TWEAK with extra named, clone with changes, COERCE, class-level
# `my` state, `our $.x`, custom exceptions, gist/Str overrides, `also is`.

=== obj-build-binds-attr-named
from: Algorithm::SetUnion 0.0.1 lib/Algorithm/SetUnion.pm6:9
license: Artistic-2.0
feature: decl submethod
--- code
my class SetUnion {
    has Int $.size;
    has @.parent;
    submethod BUILD(Int :$!size) {
        @!parent = ^$!size;
    }
}
my $s = SetUnion.new(size => 4);
say $s.size, ' ', $s.parent;
say SetUnion.new.parent.elems;
--- expect
4 [0 1 2 3]
0

=== obj-build-defaults-in-signature
from: Data::TypeSystem 0.1.8 lib/Data/TypeSystem/Examiner.rakumod:7
license: Artistic-2.0
feature: decl submethod
--- code
my class Examiner {
    has $.type;
    has $.count;
    submethod BUILD(:$!type = Any, :$!count = 1) {}
}
my $e = Examiner.new;
say $e.type.^name, ' ', $e.count;
say Examiner.new(type => Int, count => 3).count;
--- expect
Any 1
3

=== obj-build-required-and-slurpy-attr
from: Cro::TLS 0.8.10 lib/Cro/TLS.rakumod:61
license: Artistic-2.0
feature: decl submethod
--- code
my subset Port of Int where 1..65535;
my class Connector {
    has $.host;
    has $.port;
    has %.tls-config;
    submethod BUILD(Str :$!host = 'localhost', Port :$!port!, *%!tls-config) {}
}
my $c = Connector.new(port => 443, ca-file => 'ca.pem', verify => True);
say $c.host, ':', $c.port;
say $c.tls-config.keys.sort;
Connector.new(port => 0);
--- expect
localhost:443
(ca-file verify)
!! X::TypeCheck::Binding::Parameter

=== obj-build-non-attr-named-and-flag
from: Cro::HTTP 0.8.13 lib/Cro/HTTP/Log/File.rakumod:8
license: Artistic-2.0
feature: decl submethod
--- code
my class LogFile {
    has $!out;
    has $.flush;
    submethod BUILD(:$logs, :$errors, :$!flush = True) {
        $!out = ($logs // 'stdout') ~ '+' ~ ($errors // $logs // 'stderr');
    }
    method target { $!out }
}
say LogFile.new.target, ' ', LogFile.new.flush;
say LogFile.new(logs => 'a.log', :!flush).target, ' ', LogFile.new(:!flush).flush;
--- expect
stdout+stderr True
a.log+a.log False

=== obj-build-method-not-submethod
