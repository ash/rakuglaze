=== rx-flipflop-regex-sections
from: Font::AFM 1.24.10 lib/Font/AFM.rakumod:423
license: Artistic-2.0
feature: node RegexLit
--- code
my @lines = 'Header x', 'StartKernData', 'KPX A V -80', 'KPX T o -18', 'EndKernData', 'Trailer';
for @lines {
    if /^StartKernData/ ff /^EndKernData/ {
        say "kern: $_";
        next;
    }
    say "other: $_";
}
--- expect
other: Header x
kern: StartKernData
kern: KPX A V -80
kern: KPX T o -18
kern: EndKernData
other: Trailer
