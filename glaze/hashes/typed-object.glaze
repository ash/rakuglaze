=== hash-object-attr-int-keys
from: Cro::HTTP 0.8.13 lib/Cro/HTTP/Client.rakumod:200
license: Artistic-2.0
feature: object hash
--- code
my class Conn {
    has %!outstanding-stream-responses{Int};
    method add(Int $sid, $r) { %!outstanding-stream-responses{$sid} = $r }
    method done(Int $sid) { %!outstanding-stream-responses{$sid}:delete }
    method ids { %!outstanding-stream-responses.keys.sort }
}
my $c = Conn.new;
$c.add($_, "r$_") for 1, 3, 5;
say $c.done(3);
say $c.ids;
say $c.ids[0].WHAT.^name;
--- expect
r3
(1 5)
Int

